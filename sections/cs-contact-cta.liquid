<style>
  .cs-cta-section {
    background: #fff;
    padding: 0 32px 96px;
    scroll-margin-top: 80px;
  }

  .cs-cta-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .cs-cta-card {
    background: #F5F2ED;
    border-radius: 24px;
    padding: 64px 48px;
  }

  .cs-cta-heading {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4vw, 56px);
    text-transform: uppercase;
    color: #030213;
    margin: 0 0 12px;
    line-height: 1.0;
    text-align: center;
  }

  .cs-cta-sub {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    color: #52525B;
    margin: 0 0 40px;
    line-height: 1.6;
    text-align: center;
  }

  /* Contact form */
  .cs-contact-form-wrap {
    max-width: 680px;
    margin: 0 auto 48px;
    background: #fff;
    border-radius: 20px;
    padding: 40px;
  }

  .cs-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .cs-form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .cs-form-field:last-child { margin-bottom: 0; }

  .cs-form-label {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #030213;
  }

  .cs-form-input,
  .cs-form-select,
  .cs-form-textarea {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #030213;
    background: #fff;
    border: 1px solid #E4E4E7;
    border-radius: 10px;
    padding: 13px 16px;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
  }

  .cs-form-input::placeholder,
  .cs-form-textarea::placeholder { color: #A1A1AA; }

  .cs-form-input:focus,
  .cs-form-select:focus,
  .cs-form-textarea:focus { border-color: #030213; }

  .cs-form-select-wrap { position: relative; }

  .cs-form-select-wrap svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 16px !important;
    height: 16px !important;
    fill: none !important;
    stroke: #71717A !important;
    stroke-width: 2px;
  }

  .cs-form-textarea { min-height: 130px; resize: vertical; }

  .cs-form-submit {
    font-family: 'Manrope', sans-serif;
    width: 100%;
    padding: 16px;
    background: #2D6A2F;
    color: #fff;
    border: none;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    transition: opacity 0.2s;
  }

  .cs-form-submit:hover { opacity: 0.88; }

  .cs-form-success {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    color: #1f8a3a;
    background: #f0faf4;
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  /* 3 contact method boxes */
  .cs-contact-methods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }

  .cs-contact-method {
    background: #fff;
    border: 1px solid #E4E4E7;
    border-radius: 16px;
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: box-shadow 0.2s;
  }

  .cs-contact-method:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .cs-contact-method svg {
    width: 24px !important;
    height: 24px !important;
    fill: none !important;
    stroke: #030213 !important;
    stroke-width: 1.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs-contact-method-label {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #030213;
    margin: 0;
  }

  .cs-contact-method-detail {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    color: #71717A;
    margin: 0;
    text-align: center;
  }

  @media (max-width: 900px) {
    .cs-cta-card { padding: 48px 24px; }
    .cs-contact-form-wrap { padding: 28px 20px; }
  }

  @media (max-width: 640px) {
    .cs-cta-section { padding: 0 16px 64px; }
    .cs-form-row { grid-template-columns: 1fr; }
    .cs-contact-methods { grid-template-columns: 1fr; }
  }
</style>

<section id="still-need-a-hand" class="cs-cta-section">
  <div class="cs-cta-inner">
    <div class="cs-cta-card">
      <h2 class="cs-cta-heading">{{ section.settings.heading | default: 'Still Need a Hand?' }}</h2>
      <p class="cs-cta-sub">{{ section.settings.subheading | default: 'Our team replies within one business day — usually a lot faster.' }}</p>

      <!-- Contact form -->
      <div class="cs-contact-form-wrap">
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="cs-form-success">Message sent! We'll get back to you within one business day.</p>
          {%- endif -%}

          <div class="cs-form-row">
            <div class="cs-form-field">
              <label class="cs-form-label" for="CSContactName">Name</label>
              <input class="cs-form-input" type="text" id="CSContactName" name="contact[name]" placeholder="Your name" autocomplete="name" required>
            </div>
            <div class="cs-form-field">
              <label class="cs-form-label" for="CSContactEmail">Email</label>
              <input class="cs-form-input" type="email" id="CSContactEmail" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
            </div>
          </div>

          <div class="cs-form-field">
            <label class="cs-form-label" for="CSContactTopic">Topic</label>
            <div class="cs-form-select-wrap">
              <select class="cs-form-select" id="CSContactTopic" name="contact[topic]">
                <option value="">Choose a topic...</option>
                <option>Order issue</option>
                <option>Returns &amp; refunds</option>
                <option>Wholesale inquiry</option>
                <option>Snack Box subscription</option>
                <option>Product question</option>
                <option>Other</option>
              </select>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>

          <div class="cs-form-field">
            <label class="cs-form-label" for="CSContactMessage">Message</label>
            <textarea class="cs-form-textarea" id="CSContactMessage" name="contact[body]" placeholder="How can we help?"></textarea>
          </div>

          <button type="submit" class="cs-form-submit">
            Send message
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        {%- endform -%}
      </div>

      <!-- 3 contact method boxes -->
      <div class="cs-contact-methods">

        <a href="{{ section.settings.chat_url | default: '#' }}" class="cs-contact-method">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <p class="cs-contact-method-label">Live chat</p>
          <p class="cs-contact-method-detail">{{ section.settings.chat_detail | default: 'Mon–Fri, 9am–6pm ET' }}</p>
        </a>

        <a href="mailto:{{ section.settings.email | default: 'rocketboyzllc@gmail.com' }}" class="cs-contact-method">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <p class="cs-contact-method-label">Email us</p>
          <p class="cs-contact-method-detail">{{ section.settings.email | default: 'rocketboyzllc@gmail.com' }}</p>
        </a>

        <a href="tel:{{ section.settings.phone | default: '18007622596' }}" class="cs-contact-method">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.65 3.42 2 2 0 0 1 3.62 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.83a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg>
          <p class="cs-contact-method-label">Call us</p>
          <p class="cs-contact-method-detail">{{ section.settings.phone_display | default: '1-800-SNACK-96' }}</p>
        </a>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CS Contact CTA",
  "settings": [
    { "type": "text",     "id": "heading",       "label": "Heading",        "default": "Still Need a Hand?" },
    { "type": "textarea", "id": "subheading",    "label": "Subheading",     "default": "Our team replies within one business day — usually a lot faster." },
    { "type": "text",     "id": "email",         "label": "Email address",  "default": "rocketboyzllc@gmail.com" },
    { "type": "text",     "id": "phone",         "label": "Phone (tel: link, digits only)", "default": "18007622596" },
    { "type": "text",     "id": "phone_display", "label": "Phone (display text)", "default": "1-800-SNACK-96" },
    { "type": "text",     "id": "chat_detail",   "label": "Live chat hours", "default": "Mon–Fri, 9am–6pm ET" },
    { "type": "url",      "id": "chat_url",      "label": "Live chat URL" }
  ],
  "presets": [{ "name": "CS Contact CTA" }]
}
{% endschema %}
