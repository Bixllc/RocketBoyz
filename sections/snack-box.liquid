<style>
  .snack-box-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 72px 32px;
  }

  .snack-box-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    align-items: stretch;
  }

  .snack-box-image-panel {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    min-height: 480px;
    background: linear-gradient(180deg, #f4f0e7 0%, #efe9dc 64%, #e6e0cf 100%);
    border: 1px solid rgba(27, 26, 22, 0.1);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .snack-box-image-shadow {
    position: absolute;
    left: 50%;
    bottom: 40px;
    width: 72%;
    height: 60px;
    transform: translateX(-50%);
    background: radial-gradient(50% 50% at 50% 50%, rgba(31, 30, 24, 0.32), transparent 72%);
    filter: blur(10px);
    z-index: 1;
  }

  .snack-box-image-panel img {
    position: relative;
    z-index: 2;
    width: 86%;
    object-fit: contain;
    margin-bottom: 34px;
    filter: drop-shadow(0 20px 18px rgba(31, 30, 24, 0.24));
  }

  .snack-box-image-placeholder {
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(27, 26, 22, 0.3);
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
  }

  .snack-box-copy-panel {
    background: #fbfaf7;
    border: 1px solid rgba(27, 26, 22, 0.1);
    border-radius: 26px;
    padding: 46px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .snack-box-heading {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.94;
    color: #1b1a16;
    margin: 0;
  }

  .snack-box-body {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-size: 16.5px;
    line-height: 1.55;
    color: #54514a;
    margin: 20px 0 0;
  }

  .snack-box-tiers {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 26px 0;
  }

  .snack-box-tier {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid rgba(27, 26, 22, 0.12);
    border-radius: 14px;
    cursor: pointer;
    transition: border-color 0.15s, border-width 0.15s, background 0.15s;
  }

  .snack-box-tier.is-selected {
    border-color: #1b1a16;
    border-width: 1.5px;
    background: rgba(27, 26, 22, 0.03);
  }

  .snack-box-tier-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .snack-box-tier-badge {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    font-size: 15px;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 7px;
    background: #efece6;
    color: #1b1a16;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .snack-box-tier-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .snack-box-tier-name {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-size: 15px;
    font-weight: 700;
    color: #1b1a16;
  }

  .snack-box-tier-items {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-size: 13px;
    color: #8a857a;
  }

  .snack-box-tier-price {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    font-size: 18px;
    color: #1b1a16;
    flex-shrink: 0;
  }

  .snack-box-cta {
    font-family: 'Hanken Grotesk', sans-serif !important;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    background: transparent;
    color: #1b1a16;
    border: 1.5px solid rgba(27, 26, 22, 0.2);
    border-radius: 999px;
    padding: 15px 26px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .snack-box-cta:hover {
    background: #1b1a16;
    color: #f3f0e9;
    border-color: #1b1a16;
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .snack-box-container {
      padding: 48px 20px;
    }

    .snack-box-grid {
      grid-template-columns: 1fr;
    }

    .snack-box-image-panel {
      min-height: 360px;
    }

    .snack-box-copy-panel {
      padding: 32px 28px;
    }
  }
</style>

<section class="snack-box-section">
  <div class="snack-box-container">
    <div class="snack-box-grid">

      <!-- Left: Product Image Panel -->
      <div class="snack-box-image-panel">
        <div class="snack-box-image-shadow"></div>
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.heading_line1 | escape }} {{ section.settings.heading_line2 | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="snack-box-image-placeholder">Add a product image</div>
        {%- endif -%}
      </div>

      <!-- Right: Copy Panel -->
      <div class="snack-box-copy-panel">
        <h2 class="snack-box-heading">
          {{ section.settings.heading_line1 }}<br>
          {{ section.settings.heading_line2 }}
        </h2>

        {%- if section.settings.description != blank -%}
          <p class="snack-box-body">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}
        {%- if tier_blocks.size > 0 -%}
          <div class="snack-box-tiers" data-snackbox-tiers>
            {%- for block in tier_blocks -%}
              <label class="snack-box-tier{% if forloop.first %} is-selected{% endif %}" {{ block.shopify_attributes }}>
                <input
                  class="snack-box-tier-radio"
                  type="radio"
                  name="snack-box-tier-{{ section.id }}"
                  {% if forloop.first %}checked{% endif %}
                >
                <span class="snack-box-tier-badge">{{ block.settings.letter }}</span>
                <span class="snack-box-tier-info">
                  <span class="snack-box-tier-name">{{ block.settings.name }}</span>
                  <span class="snack-box-tier-items">{{ block.settings.items }}</span>
                </span>
                <span class="snack-box-tier-price">{{ block.settings.price }}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <a href="{{ section.settings.cta_url | default: '/collections/snack-boxes' }}" class="snack-box-cta">
          {{ section.settings.cta_text | default: "Build your box" }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-snackbox-tiers]').forEach(function (group) {
      var labels = group.querySelectorAll('.snack-box-tier');
      labels.forEach(function (label) {
        var radio = label.querySelector('.snack-box-tier-radio');
        radio.addEventListener('change', function () {
          labels.forEach(function (l) { l.classList.remove('is-selected'); });
          label.classList.add('is-selected');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Snack Box",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "A taste of home,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "boxed monthly"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-packed boxes of island snacks delivered to your door — or your shop. Pick a size, pick a vibe, and we curate the rest from the freshest arrivals."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Build your box"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Box size tier",
      "settings": [
        {
          "type": "text",
          "id": "letter",
          "label": "Size letter",
          "default": "S"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Tier name",
          "default": "The Mini"
        },
        {
          "type": "text",
          "id": "items",
          "label": "Items description",
          "default": "6 snacks · solo"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$24"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snack Box",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "letter": "S",
            "name": "The Mini",
            "items": "6 snacks · solo",
            "price": "$24"
          }
        },
        {
          "type": "tier",
          "settings": {
            "letter": "M",
            "name": "The Classic",
            "items": "12 snacks · share",
            "price": "$42"
          }
        },
        {
          "type": "tier",
          "settings": {
            "letter": "L",
            "name": "The Party",
            "items": "24 snacks + drinks",
            "price": "$78"
          }
        }
      ]
    }
  ]
}
{% endschema %}
