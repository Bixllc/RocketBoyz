<style>
  .snack-box-section {
    padding: 72px 32px;
  }

  .snack-box-card {
    max-width: 1280px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 26px;
    border: 1px solid #E4E4E7;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4px 8px rgba(0, 0, 0, 0.06),
      0 12px 24px rgba(0, 0, 0, 0.09),
      0 28px 48px rgba(0, 0, 0, 0.11),
      0 56px 88px -16px rgba(0, 0, 0, 0.13),
      0 96px 128px -32px rgba(0, 0, 0, 0.10);
  }

  /* ── Left: Copy ── */
  .snack-box-copy {
    padding: 56px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .snack-box-heading {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 3.2vw, 54px);
    line-height: 1.05;
    color: #030213;
    margin: 0 0 16px;
  }

  .snack-box-body {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: #52525B;
    margin: 0 0 28px;
  }

  /* ── Tier selector ── */
  .snack-box-tiers {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }

  .snack-box-tier {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1.5px solid #E4E4E7;
    border-radius: 14px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .snack-box-tier.is-selected {
    border-color: #030213;
    background: rgba(3, 2, 19, 0.03);
  }

  .snack-box-tier-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .snack-box-tier-badge {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 13px;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 7px;
    background: #F4F4F5;
    color: #030213;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .snack-box-tier-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .snack-box-tier-name {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #030213;
  }

  .snack-box-tier-items {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    color: #71717A;
  }

  .snack-box-tier-price {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #030213;
    flex-shrink: 0;
  }

  /* ── CTA ── */
  .snack-box-cta {
    font-family: 'Manrope', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    background: #2D6A2F;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 15px 28px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .snack-box-cta svg {
    stroke: #fff;
  }

  .snack-box-cta:hover {
    background: #245526;
    transform: translateY(-2px);
  }

  /* ── Right: Image ── */
  .snack-box-image-side {
    position: relative;
    overflow: hidden;
    align-self: stretch;
    min-height: 480px;
  }

  .snack-box-image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .snack-box-section {
      padding: 40px 16px;
    }

    .snack-box-card {
      grid-template-columns: 1fr;
    }

    .snack-box-copy {
      padding: 36px 28px;
      order: 2;
    }

    .snack-box-image-side {
      min-height: 300px;
      order: 1;
    }
  }
</style>

<section class="snack-box-section">
  <div class="snack-box-card">

    <!-- Left: Copy -->
    <div class="snack-box-copy">
      <h2 class="snack-box-heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}
      </h2>

      {%- if section.settings.description != blank -%}
        <p class="snack-box-body">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}
      {%- if tier_blocks.size > 0 -%}
        <div class="snack-box-tiers" data-snackbox-tiers>
          {%- for block in tier_blocks -%}
            <label class="snack-box-tier{% if forloop.first %} is-selected{% endif %}" {{ block.shopify_attributes }}>
              <input
                class="snack-box-tier-radio"
                type="radio"
                name="snack-box-tier-{{ section.id }}"
                {% if forloop.first %}checked{% endif %}
              >
              <span class="snack-box-tier-badge">{{ block.settings.letter }}</span>
              <span class="snack-box-tier-info">
                <span class="snack-box-tier-name">{{ block.settings.name }}</span>
                <span class="snack-box-tier-items">{{ block.settings.items }}</span>
              </span>
              <span class="snack-box-tier-price">{{ block.settings.price }}</span>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <a href="{{ section.settings.cta_url | default: '/products/snack-box-pay-what-you-want' }}" class="snack-box-cta">
        {{ section.settings.cta_text | default: "Build your box" }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Right: Image -->
    <div class="snack-box-image-side">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.heading_line1 | escape }} {{ section.settings.heading_line2 | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div style="color: #71717A; font-family: 'Manrope', sans-serif; font-size: 14px;">Add a product image</div>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    document.querySelectorAll('[data-snackbox-tiers]').forEach(function (group) {
      var labels = group.querySelectorAll('.snack-box-tier');
      labels.forEach(function (label) {
        var radio = label.querySelector('.snack-box-tier-radio');
        radio.addEventListener('change', function () {
          labels.forEach(function (l) { l.classList.remove('is-selected'); });
          label.classList.add('is-selected');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Snack Box",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "A taste of home,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "boxed monthly"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-packed boxes of island snacks delivered to your door — or your shop. Pick a size, pick a vibe, and we curate the rest from the freshest arrivals."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Build your box"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Box size tier",
      "settings": [
        {
          "type": "text",
          "id": "letter",
          "label": "Size letter",
          "default": "S"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Tier name",
          "default": "The Mini"
        },
        {
          "type": "text",
          "id": "items",
          "label": "Items description",
          "default": "6 snacks · solo"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$24"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snack Box",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "letter": "S",
            "name": "The Mini",
            "items": "6 snacks · solo",
            "price": "$24"
          }
        },
        {
          "type": "tier",
          "settings": {
            "letter": "M",
            "name": "The Classic",
            "items": "12 snacks · share",
            "price": "$42"
          }
        },
        {
          "type": "tier",
          "settings": {
            "letter": "L",
            "name": "The Party",
            "items": "24 snacks + drinks",
            "price": "$78"
          }
        }
      ]
    }
  ]
}
{% endschema %}
