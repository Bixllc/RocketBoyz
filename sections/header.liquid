  <div class="rb-search-modal__backdrop" data-search-close></div>
  <div class="rb-search-modal__panel" role="search">
    <form action="/search" method="get" class="rb-search-modal__form">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      {%- comment -%}
        No visible submit button — the form submits on Enter, and on mobile the
        keyboard's own Search/Go key. enterkeyhint makes that key read "Search".
      {%- endcomment -%}
      <input type="search" name="q" class="rb-search-modal__input" placeholder="Search snacks, beverages, and more..." autocomplete="off" enterkeyhint="search" data-search-input required>
      <input type="hidden" name="type" value="product">
    </form>
    <button type="button" class="rb-search-modal__close" data-search-close aria-label="Close search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
</div>

<script>
(function () {
  var toggle = document.getElementById('rb-mobile-toggle');
  var nav = document.getElementById('rb-mobile-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', function () {
      var isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    // Close on outside tap
    document.addEventListener('click', function (e) {
      if (!nav.contains(e.target) && !toggle.contains(e.target)) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        document.body.style.overflow = '';
      }
    });
  }

  // Mobile nav: collapsible "Shop" group, closed by default
  document.querySelectorAll('[data-mobile-group-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var panel = btn.closest('.rb-mobile-nav__group').querySelector('[data-mobile-group-panel]');
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (panel) panel.hidden = isOpen;
    });
  });

  // Search modal
  var searchBtn    = document.querySelector('[data-search-toggle]');
  var searchModal  = document.querySelector('[data-search-modal]');
  var searchInput  = document.querySelector('[data-search-input]');
  var searchCloseEls = document.querySelectorAll('[data-search-close]');

  /* #shopify-section-header has `will-change: transform`, which makes it a
     containing block for position:fixed descendants. The modal's `inset: 0`
     was therefore resolving against the ~75px header box instead of the
     viewport, so the hero painted on top and swallowed every tap — the modal
     looked open but nothing in it was clickable.

     Moving it to <body> takes it out of that containing block. The vendor
     theme solves the same problem for its own header with
     `.sticky-search-open #shopify-section-header-05 { will-change: unset }`
     (component-header-05.css), which doesn't apply to this custom header. */
  if (searchModal && searchModal.parentElement !== document.body) {
    document.body.appendChild(searchModal);
  }

  function openSearch() {
    if (!searchModal) return;
    searchModal.classList.add('active');
    searchModal.setAttribute('aria-hidden', 'false');
    if (searchBtn) searchBtn.classList.add('is-active');
    if (searchInput) setTimeout(function () { searchInput.focus(); }, 50);
  }
  function closeSearch() {
    if (!searchModal) return;
    searchModal.classList.remove('active');
    searchModal.setAttribute('aria-hidden', 'true');
    if (searchBtn) searchBtn.classList.remove('is-active');
  }

  if (searchBtn) {
    searchBtn.addEventListener('click', function () {
      if (searchModal && searchModal.classList.contains('active')) closeSearch();
      else openSearch();
    });
  }
  searchCloseEls.forEach(function (el) { el.addEventListener('click', closeSearch); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && searchModal && searchModal.classList.contains('active')) closeSearch();
  });

  // Shop dropdown chevron state (hover + keyboard focus)
  var shopItem = document.querySelector('[data-shop-trigger]');
  var shopWrapper = shopItem ? shopItem.closest('.rb-header__nav-item') : null;

  if (shopItem && shopWrapper) {
    var hasDropdown = !!shopWrapper.querySelector('.rb-header__dropdown');

    var setExpanded = function (isOpen) {
      shopItem.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      shopWrapper.classList.toggle('is-open', isOpen);
    };
    shopWrapper.addEventListener('mouseenter', function () { setExpanded(true); });
    shopWrapper.addEventListener('mouseleave', function () { setExpanded(false); });
    shopWrapper.addEventListener('focusin', function () { setExpanded(true); });
    shopWrapper.addEventListener('focusout', function () { setExpanded(false); });

    if (hasDropdown) {
      shopItem.addEventListener('click', function (e) {
        e.preventDefault();
        setExpanded(!shopWrapper.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (!shopWrapper.contains(e.target)) {
          setExpanded(false);
        }
      });
    }
  }

  // Keep mobile drawer aligned to the header's actual rendered height
  var header = document.querySelector('.rb-header');
  if (header) {
    var setHeaderHeight = function () {
      document.documentElement.style.setProperty('--rb-header-h', header.offsetHeight + 'px');
    };
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight);
  }
})();
</script>

