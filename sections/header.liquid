{% comment %} RocketBoyz Header — rb-design.css design match {% endcomment %}

<style>
  /* ── Header shell ── */
  .rb-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(27, 26, 22, 0.1);
    width: 100%;
  }

  .rb-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  /* ── Logo ── */
  .rb-header__logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .rb-header__logo img {
    width: auto;
    object-fit: contain;
    display: block;
  }

  .rb-header__logo-text {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #1b1a16;
    letter-spacing: -0.03em;
  }

  /* ── Nav ── */
  .rb-header__nav {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    justify-content: center;
  }

  .rb-header__nav-item {
    position: relative;
  }

  /* rb-nav-link from rb-design.css — supplemental overrides */
  .rb-header__nav .rb-nav-link {
    font-family: 'Manrope', sans-serif !important;
    font-size: 14px;
    font-weight: 600;
    color: #1b1a16;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
    line-height: 1;
  }

  .rb-header__nav .rb-nav-link:hover {
    background: #f1ede4;
  }

  .rb-header__nav .rb-nav-link--active {
    background: #f1ede4;
  }

  .rb-header__nav .rb-nav-link svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .rb-header__nav .rb-nav-link[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  /* ── Shop dropdown panel ── */
  .rb-header__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 280px;
    background: #ffffff;
    border: 1px solid rgba(27, 26, 22, 0.12);
    border-radius: 18px;
    box-shadow: 0 26px 50px -24px rgba(20, 22, 18, 0.45);
    padding: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 201;
  }

  .rb-header__nav-item:hover .rb-header__dropdown,
  .rb-header__nav-item:focus-within .rb-header__dropdown,
  .rb-header__nav-item.is-open .rb-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .rb-header__dropdown-item {
    display: block;
    padding: 10px 12px;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .rb-header__dropdown-item:hover {
    background: #f4f1ea;
  }

  .rb-header__dropdown-item-title {
    display: block;
    font-family: 'Manrope', sans-serif !important;
    font-size: 14px;
    font-weight: 700;
    color: #1b1a16;
    line-height: 1.3;
  }

  .rb-header__dropdown-item-subtitle {
    display: block;
    font-family: 'Manrope', sans-serif !important;
    font-size: 12.5px;
    font-weight: 400;
    color: #7a7567;
    line-height: 1.3;
    margin-top: 2px;
  }

  /* ── Actions ── */
  .rb-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* rb-icon-btn from rb-design.css — supplemental overrides */
  .rb-header__actions .rb-icon-btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #1b1a16;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
    text-decoration: none;
    position: relative;
    flex-shrink: 0;
  }

  .rb-header__actions .rb-icon-btn:hover {
    color: #E63946;
    background: rgba(230, 57, 70, 0.06);
  }

  /* Reset any global SVG styles that might bleed in */
  .rb-header svg {
    fill: none;
    stroke: currentColor;
    width: auto;
    height: auto;
    overflow: visible;
  }

  /* Contact Us pill — outline style */
  .rb-header__contact-btn {
    font-family: 'Manrope', sans-serif !important;
    font-size: 1rem;
    font-weight: 600;
    color: #1b1a16;
    background: transparent;
    border: 2px solid #1b1a16;
    border-radius: 9999px;
    padding: 0.625rem 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    line-height: 1;
    flex-shrink: 0;
  }

  .rb-header__contact-btn:hover {
    background: #1b1a16;
    color: #f3f1ec;
  }

  /* Cart button — dark pill */
  .rb-header__cart-btn {
    font-family: 'Manrope', sans-serif !important;
    font-size: 1rem;
    font-weight: 600;
    color: #f3f1ec;
    background: #1b1a16;
    border: none;
    border-radius: 9999px;
    padding: 0.625rem 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
    position: relative;
    flex-shrink: 0;
    line-height: 1;
  }

  .rb-header__cart-btn:hover {
    background: #000000;
  }

  .rb-header__cart-btn svg {
    stroke: currentColor;
  }

  /* ── Mobile toggle ── */
  .rb-header__actions .rb-header__mobile-toggle {
    display: none;
  }

  /* ── Mobile menu ── */
  .rb-mobile-nav {
    display: none;
    position: fixed;
    top: var(--rb-header-h, 70px);
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(27, 26, 22, 0.1);
    z-index: 199;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
  }

  .rb-mobile-nav.is-open {
    display: block;
  }

  .rb-mobile-nav__inner {
    padding: 1.5rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .rb-mobile-nav__link {
    font-family: 'Manrope', sans-serif !important;
    font-weight: 500;
    font-size: 1rem;
    color: #1b1a16;
    text-decoration: none;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(27, 26, 22, 0.08);
    display: block;
    transition: color 0.2s ease;
  }

  .rb-mobile-nav__link:hover {
    color: #E63946;
  }

  .rb-mobile-nav__group {
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(27, 26, 22, 0.08);
  }

  .rb-mobile-nav__group-label {
    font-family: 'Manrope', sans-serif !important;
    font-weight: 600;
    font-size: 1rem;
    color: #1b1a16;
    display: block;
    margin-bottom: 0.625rem;
  }

  .rb-mobile-nav__sublink {
    font-family: 'Manrope', sans-serif !important;
    font-weight: 400;
    font-size: 0.9375rem;
    color: #5a5852;
    text-decoration: none;
    display: block;
    padding: 0.375rem 0.875rem;
    transition: color 0.2s ease;
  }

  .rb-mobile-nav__sublink:hover {
    color: #E63946;
  }

  .rb-mobile-nav__footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .rb-header__inner {
      padding: 12px 16px;
      gap: 10px;
    }

    .rb-header__nav {
      display: none;
    }

    .rb-header__contact-btn {
      display: none;
    }

    /* Hide search and account icons on mobile */
    .rb-header__search {
      display: none;
    }

    .rb-icon-btn[aria-label="Account"] {
      display: none;
    }

    .rb-header__actions .rb-header__mobile-toggle {
      display: inline-flex;
    }

    /* Cart: icon-only pill on mobile */
    .rb-header__cart-btn {
      background: #1b1a16;
      padding: 0;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      gap: 0;
      justify-content: center;
    }

    .rb-header__cart-btn [data-cart-count-label] {
      display: none;
    }

    .rb-header__actions {
      gap: 6px;
    }
  }

  @media (max-width: 480px) {
    .rb-header__actions .rb-icon-btn {
      width: 36px;
      height: 36px;
    }
    .rb-header__cart-btn {
      width: 36px;
      height: 36px;
    }
  }

  .rb-btn-wish-nav svg path {
    transition: fill 0.15s, stroke 0.15s;
  }
  .rb-btn-wish-nav:hover svg path,
  .rb-btn-wish-nav.is-wished svg path {
    fill: url(#rb-heart-gradient);
    stroke: url(#rb-heart-gradient);
  }
</style>

<svg width="0" height="0" style="position:absolute;" aria-hidden="true">
  <defs>
    <linearGradient id="rb-heart-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E63946"/>
      <stop offset="100%" stop-color="#FF9F1C"/>
    </linearGradient>
  </defs>
</svg>

<header class="rb-header" role="banner">
  <div class="rb-header__inner">

    <!-- Logo -->
    <a href="/" class="rb-header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo -%}
        <img
          src="{{ section.settings.logo | img_url: '300x' }}"
          alt="{{ shop.name | escape }}"
          height="{{ section.settings.logo_height }}"
          loading="eager"
          fetchpriority="high"
          style="height: {{ section.settings.logo_height }}px;"
        >
      {%- else -%}
        <span class="rb-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Desktop Nav -->
    <nav class="rb-header__nav" role="navigation" aria-label="Main navigation">
      {%- for link in linklists['header-nav'].links -%}
        {%- if forloop.first -%}
          {%- comment -%} First link = Shop — render with chevron + dropdown panel {%- endcomment -%}
          <div class="rb-header__nav-item">
            <a
              href="{{ link.url }}"
              class="rb-nav-link{% if link.active %} rb-nav-link--active{% endif %}"
              aria-label="{{ link.title | escape }}"
              aria-haspopup="true"
              aria-expanded="false"
              data-shop-trigger
            >
              {{- link.title | escape -}}
              <!-- Chevron down -->
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            {%- if section.blocks.size > 0 -%}
              <div class="rb-header__dropdown" role="menu">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'dropdown_item' -%}
                    <a
                      href="{{ block.settings.url }}"
                      class="rb-header__dropdown-item"
                      role="menuitem"
                      {{ block.shopify_attributes }}
                    >
                      <span class="rb-header__dropdown-item-title">{{ block.settings.title | escape }}</span>
                      {%- if block.settings.subtitle != blank -%}
                        <span class="rb-header__dropdown-item-subtitle">{{ block.settings.subtitle | escape }}</span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="rb-header__nav-item">
            <a
              href="{{ link.url }}"
              class="rb-nav-link{% if link.active %} rb-nav-link--active{% endif %}"
            >
              {{- link.title | escape -}}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Right-side actions -->
    <div class="rb-header__actions">

      <!-- Search -->
      <button
        class="rb-icon-btn rb-header__search"
        aria-label="Search"
        type="button"
        onclick="document.querySelector('[data-search-modal]')?.classList.toggle('active')"
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Account -->
      <a href="/account" class="rb-icon-btn" aria-label="Account">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <!-- Wishlist -->
      <a href="/pages/wish-list" class="rb-icon-btn rb-btn-wish-nav" aria-label="Wishlist">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </a>

      <!-- Contact Us pill (outline) -->
      <a href="/pages/contact" class="rb-header__contact-btn">
        Contact Us
      </a>

      <!-- Cart (dark pill) -->
      <button
        class="rb-header__cart-btn"
        aria-label="Cart{% if cart.item_count > 0 %} ({{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}){% endif %}"
        type="button"
        data-cart-open
      >
        <!-- Shopping bag icon -->
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#f3f0e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span data-cart-count-label>Cart{% if cart.item_count > 0 %} · {{ cart.item_count }}{% endif %}</span>
      </button>

      <!-- Mobile menu toggle -->
      <button
        class="rb-icon-btn rb-header__mobile-toggle"
        id="rb-mobile-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="rb-mobile-nav"
        type="button"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- Mobile navigation -->
<div class="rb-mobile-nav" id="rb-mobile-nav" role="navigation" aria-label="Mobile navigation">
  <div class="rb-mobile-nav__inner">
    {%- for link in linklists['header-nav'].links -%}
      {%- if link.links != blank -%}
        <div class="rb-mobile-nav__group">
          <span class="rb-mobile-nav__group-label">{{ link.title | escape }}</span>
          {%- for child in link.links -%}
            <a href="{{ child.url }}" class="rb-mobile-nav__sublink">{{ child.title | escape }}</a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <a href="{{ link.url }}" class="rb-mobile-nav__link{% if link.active %} rb-nav-link--active{% endif %}">
          {{- link.title | escape -}}
        </a>
      {%- endif -%}
    {%- endfor -%}

    <div class="rb-mobile-nav__footer">
      <a href="/pages/contact" class="rb-header__contact-btn" style="justify-content: center;">
        Contact Us
      </a>
      <button
        class="rb-header__cart-btn"
        type="button"
        data-cart-open
        style="justify-content: center;"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#f3f0e9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span data-cart-count-label>Cart{% if cart.item_count > 0 %} · {{ cart.item_count }}{% endif %}</span>
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  var toggle = document.getElementById('rb-mobile-toggle');
  var nav = document.getElementById('rb-mobile-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', function () {
      var isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    // Close on outside tap
    document.addEventListener('click', function (e) {
      if (!nav.contains(e.target) && !toggle.contains(e.target)) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      }
    });
  }

  // Shop dropdown chevron state (hover + keyboard focus)
  var shopItem = document.querySelector('[data-shop-trigger]');
  var shopWrapper = shopItem ? shopItem.closest('.rb-header__nav-item') : null;

  if (shopItem && shopWrapper) {
    var hasDropdown = !!shopWrapper.querySelector('.rb-header__dropdown');

    var setExpanded = function (isOpen) {
      shopItem.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      shopWrapper.classList.toggle('is-open', isOpen);
    };
    shopWrapper.addEventListener('mouseenter', function () { setExpanded(true); });
    shopWrapper.addEventListener('mouseleave', function () { setExpanded(false); });
    shopWrapper.addEventListener('focusin', function () { setExpanded(true); });
    shopWrapper.addEventListener('focusout', function () { setExpanded(false); });

    if (hasDropdown) {
      shopItem.addEventListener('click', function (e) {
        e.preventDefault();
        setExpanded(!shopWrapper.classList.contains('is-open'));
      });

      document.addEventListener('click', function (e) {
        if (!shopWrapper.contains(e.target)) {
          setExpanded(false);
        }
      });
    }
  }

  // Keep mobile drawer aligned to the header's actual rendered height
  var header = document.querySelector('.rb-header');
  if (header) {
    var setHeaderHeight = function () {
      document.documentElement.style.setProperty('--rb-header-h', header.offsetHeight + 'px');
    };
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight);
  }
})();
</script>

