{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (px)",
      "min": 30,
      "max": 80,
      "step": 1,
      "default": 46
    }
  ],
  "blocks": [
    {
      "type": "dropdown_item",
      "name": "Shop dropdown item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Item title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "dropdown_item",
          "settings": {
            "title": "Dollar Menu",
            "subtitle": "Single snacks under $2"
          }
        },
        {
          "type": "dropdown_item",
          "settings": {
            "title": "Snack Box",
            "subtitle": "Curated monthly island box"
          }
        },
        {
          "type": "dropdown_item",
          "settings": {
            "title": "Wholesale",
            "subtitle": "Stock your shop by the case"
          }
        }
      ]
    }
  ]
}
{% endschema %}
