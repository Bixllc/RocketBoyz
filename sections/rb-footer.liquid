<style>
  .rb-footer-wrap {
    background: #fff;
    border-top: 1px solid rgba(27, 26, 22, 0.14);
  }

  .rb-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 28px;
  }

  .rb-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 36px;
    align-items: start;
  }

  /* Column 1 — Brand */
  .rb-footer-brand-logo {
    max-width: 140px;
    height: auto;
    display: block;
    margin-bottom: 16px;
  }

  .rb-footer-tagline {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #6e6a60;
    max-width: 280px;
    margin: 0 0 22px;
  }

  .rb-footer-socials {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .rb-footer-contact-icons {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 12px;
  }

  .rb-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .rb-social-icon:hover {
    transform: translateY(-2px);
    opacity: 0.8;
  }

  .rb-social-icon svg {
    width: 24px;
    height: 24px;
  }

  .rb-social-icon--contact svg {
    width: 21px;
    height: 21px;
    color: #1b1a16;
  }

  /* Columns 2 & 3 — Nav */
  .rb-footer-nav-label {
    font-family: 'DM Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7567;
    display: block;
    margin-bottom: 18px;
  }

  .rb-footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .rb-footer-nav-list a {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14.5px;
    color: #33302b;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .rb-footer-nav-list a:hover {
    color: #E63946;
  }

  /* Column 4 — Newsletter */
  .rb-footer-newsletter-label {
    font-family: 'DM Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7567;
    display: block;
    margin-bottom: 10px;
  }

  .rb-footer-newsletter-sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13.5px;
    color: #6e6a60;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .rb-newsletter-pill {
    display: flex;
    align-items: center;
    background: #f3f1ec;
    border-radius: 999px;
    padding: 5px 5px 5px 16px;
    border: 1px solid rgba(27, 26, 22, 0.1);
    gap: 6px;
  }

  .rb-newsletter-pill input[type="email"] {
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
    color: #1b1a16;
    flex: 1;
    min-width: 0;
  }

  .rb-newsletter-pill input[type="email"]::placeholder {
    color: #9a958d;
  }

  .rb-newsletter-pill button[type="submit"] {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1b1a16;
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .rb-newsletter-pill button[type="submit"]:hover {
    background: #E63946;
  }

  .rb-newsletter-pill button[type="submit"] svg {
    width: 16px;
    height: 16px;
  }

  /* Bottom bar */
  .rb-footer-bottom {
    border-top: 1px solid rgba(27, 26, 22, 0.12);
    padding-top: 22px;
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rb-footer-copyright {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12.5px;
    color: #7a7567;
    margin: 0;
  }

  .rb-footer-legal-links {
    display: flex;
    align-items: center;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rb-footer-legal-links a {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12.5px;
    color: #7a7567;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .rb-footer-legal-links a:hover {
    color: #1b1a16;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .rb-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 580px) {
    .rb-footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .rb-footer-inner {
      padding: 48px 20px 24px;
    }

    .rb-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Hanken+Grotesk:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<footer class="rb-footer-wrap">
  <div class="rb-footer-inner">
    <div class="rb-footer-grid">

      {%- comment -%} Column 1 — Brand {%- endcomment -%}
      <div class="rb-footer-col rb-footer-col--brand">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 280 }}"
            alt="{{ shop.name }}"
            class="rb-footer-brand-logo"
            width="140"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <span style="font-family:'Anton',sans-serif;font-size:22px;color:#1b1a16;display:block;margin-bottom:16px;">{{ shop.name }}</span>
        {% endif %}

        <p class="rb-footer-tagline">{{ section.settings.tagline }}</p>

        <div class="rb-footer-socials">
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="rb-social-icon" target="_blank" rel="noopener" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#1877F2" d="M24 12a12 12 0 1 0-13.875 11.854V15.36H7.078v-3.36h3.047V9.59c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.514c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.36h-2.796v8.494A12 12 0 0 0 24 12z"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="rb-social-icon" target="_blank" rel="noopener" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <defs>
                  <linearGradient id="rb-ig-grad-{{ section.id }}" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#FED576"/>
                    <stop offset="26%" stop-color="#F47133"/>
                    <stop offset="61%" stop-color="#BC3081"/>
                    <stop offset="100%" stop-color="#4C63D2"/>
                  </linearGradient>
                </defs>
                <rect width="24" height="24" rx="6" fill="url(#rb-ig-grad-{{ section.id }})"/>
                <circle cx="12" cy="12" r="3.6" fill="none" stroke="#fff" stroke-width="1.6"/>
                <rect x="4.5" y="4.5" width="15" height="15" rx="4.2" fill="none" stroke="#fff" stroke-width="1.6"/>
                <circle cx="16.3" cy="7.7" r="0.9" fill="#fff"/>
              </svg>
            </a>
          {% endif %}

          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" class="rb-social-icon" target="_blank" rel="noopener" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#000" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.53V6.77a4.85 4.85 0 0 1-1.02-.08z"/>
              </svg>
            </a>
          {% endif %}
        </div>

        {%- if section.settings.contact_email != blank or section.settings.contact_phone != blank -%}
          <div class="rb-footer-contact-icons">
            {%- if section.settings.contact_email != blank -%}
              <a href="mailto:{{ section.settings.contact_email }}" class="rb-social-icon rb-social-icon--contact" aria-label="Email us">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if section.settings.contact_phone != blank -%}
              <a href="tel:{{ section.settings.contact_phone | strip }}" class="rb-social-icon rb-social-icon--contact" aria-label="Call us">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Column 2 — Shop {%- endcomment -%}
      <div class="rb-footer-col">
        <span class="rb-footer-nav-label">Shop</span>
        <ul class="rb-footer-nav-list">
          <li>
            <a href="{{ section.settings.shop_url_1 | default: '/collections/all' }}">All categories</a>
          </li>
          <li>
            <a href="{{ section.settings.shop_url_2 | default: '/collections/new-arrivals' }}">New arrivals</a>
          </li>
          <li>
            <a href="{{ section.settings.shop_url_3 | default: '/products/rocket-box' }}">The Rocket Box</a>
          </li>
          <li>
            <a href="{{ section.settings.shop_url_4 | default: '/collections/best-sellers' }}">Best sellers</a>
          </li>
        </ul>
      </div>

      {%- comment -%} Column 3 — Company {%- endcomment -%}
      <div class="rb-footer-col">
        <span class="rb-footer-nav-label">Company</span>
        <ul class="rb-footer-nav-list">
          <li>
            <a href="{{ section.settings.company_url_1 | default: '/pages/our-story' }}">Our story</a>
          </li>
          <li>
            <a href="{{ section.settings.company_url_2 | default: '/pages/wholesale' }}">Wholesale</a>
          </li>
          <li>
            <a href="{{ section.settings.company_url_3 | default: '/pages/stockists' }}">Stockists</a>
          </li>
          <li>
            <a href="{{ section.settings.company_url_4 | default: '/pages/contact' }}">Contact</a>
          </li>
        </ul>
      </div>

      {%- comment -%} Column 4 — Newsletter {%- endcomment -%}
      <div class="rb-footer-col">
        <span class="rb-footer-newsletter-label">Stay in the loop</span>
        <p class="rb-footer-newsletter-sub">New drops, restocks, and snack culture.</p>

        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="rb-newsletter-pill">
            <input
              type="email"
              name="contact[email]"
              placeholder="Email"
              autocomplete="email"
              aria-label="Email address for newsletter"
              required
            >
            <button type="submit" aria-label="Subscribe">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p style="margin-top:10px;font-family:'Hanken Grotesk',sans-serif;font-size:13.5px;color:#1f8a3a;">
              Thanks for subscribing!
            </p>
          {% endif %}
          {% if form.errors %}
            <p style="margin-top:10px;font-family:'Hanken Grotesk',sans-serif;font-size:13.5px;color:#E63946;">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}
        {% endform %}
      </div>

    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="rb-footer-bottom">
      <p class="rb-footer-copyright">{{ section.settings.copyright }}</p>

      <ul class="rb-footer-legal-links">
        {% if section.settings.privacy_url != blank %}
          <li><a href="{{ section.settings.privacy_url }}">Privacy</a></li>
        {% else %}
          <li><a href="{{ routes.root_url }}policies/privacy-policy">Privacy</a></li>
        {% endif %}

        {% if section.settings.terms_url != blank %}
          <li><a href="{{ section.settings.terms_url }}">Terms</a></li>
        {% else %}
          <li><a href="{{ routes.root_url }}policies/terms-of-service">Terms</a></li>
        {% endif %}

        {% if section.settings.shipping_url != blank %}
          <li><a href="{{ section.settings.shipping_url }}">Shipping</a></li>
        {% else %}
          <li><a href="{{ routes.root_url }}policies/shipping-policy">Shipping</a></li>
        {% endif %}
      </ul>
    </div>

  </div>
</footer>

