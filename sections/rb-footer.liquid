<style>
  .rb-footer-wrap {
    background: #fff;
    border-top: 1px solid rgba(27, 26, 22, 0.14);
  }

  .rb-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 28px;
  }

  .rb-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 36px;
    align-items: start;
  }

  /* Column 1 — Brand */
  .rb-footer-brand-logo {
    max-width: 140px;
    height: auto;
    display: block;
    margin-bottom: 16px;
  }

  .rb-footer-tagline {
    font-family: 'Manrope', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #6e6a60;
    max-width: 280px;
    margin: 0 0 14px;
  }

  .rb-footer-address {
    font-family: 'Manrope', sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: #7a7567;
    margin: 0 0 18px;
  }

  /* App Store badge */
  .rb-footer-app {
    margin: 0 0 22px;
  }

  /* Holds the App Store + Google Play badges. Wraps to one per line on
     narrow screens rather than shrinking the badges. */
  .rb-footer-app__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .rb-footer-app__label {
    font-family: 'Manrope', sans-serif;
    font-size: 12.5px;
    color: #7a7567;
    margin: 0 0 8px;
  }

  .rb-app-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #030213;
    color: #fff;
    text-decoration: none;
    border-radius: 12px;
    padding: 9px 16px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .rb-app-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(3, 2, 19, 0.22);
  }

  /* stroke: none kills the theme's global `svg { stroke: currentColor }` (base.css),
     which otherwise paints a 1px orange link-hover outline around the apple glyph */
  .rb-app-badge svg,
  .rb-app-badge svg * {
    stroke: none !important;
  }

  .rb-app-badge svg {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    fill: #fff;
    transition: fill 0.15s;
  }

  .rb-app-badge:hover svg,
  .rb-app-badge:active svg {
    fill: #4CC46A;
  }

  .rb-app-badge__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .rb-app-badge__eyebrow {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #cfcfd6 !important;
  }

  .rb-app-badge__store {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff !important;
    transition: color 0.15s;
  }
  .rb-app-badge:hover .rb-app-badge__store,
  .rb-app-badge:active .rb-app-badge__store {
    color: #4CC46A !important;
  }

  .rb-footer-socials {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .rb-footer-contact-icons {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 12px;
  }

  .rb-social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #F0EFED;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .rb-social-icon:hover {
    background: #E4E4E7;
    transform: translateY(-2px);
  }

  .rb-social-icon svg {
    width: 20px !important;
    height: 20px !important;
    color: #52525B;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 1.8px;
  }

  .rb-social-icon--filled svg {
    fill: currentColor !important;
    stroke: none !important;
  }

  .rb-social-icon--contact svg {
    width: 18px !important;
    height: 18px !important;
    color: #52525B;
    fill: none !important;
    stroke: currentColor !important;
  }

  /* Follow block (newsletter column) */
  .rb-footer-follow {
    margin-top: 24px;
  }

  .rb-footer-follow .rb-footer-socials {
    gap: 12px;
  }

  /* Columns 2 & 3 — Nav */
  .rb-footer-nav-label {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7567;
    display: block;
    margin-bottom: 18px;
  }

  .rb-footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .rb-footer-nav-list a {
    font-family: 'Manrope', sans-serif;
    font-size: 14.5px;
    color: #33302b;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .rb-footer-nav-list a:hover {
    color: #2D6A2F;
  }

  /* Column 4 — Newsletter */
  .rb-footer-newsletter-label {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7a7567;
    display: block;
    margin-bottom: 10px;
  }

  .rb-footer-newsletter-sub {
    font-family: 'Manrope', sans-serif;
    font-size: 13.5px;
    color: #6e6a60;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .rb-newsletter-pill {
    display: flex;
    align-items: center;
    background: #f3f1ec;
    border-radius: 999px;
    padding: 5px 5px 5px 16px;
    border: 1px solid rgba(27, 26, 22, 0.1);
    gap: 6px;
  }

  .rb-newsletter-pill input[type="email"] {
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #1b1a16;
    flex: 1;
    min-width: 0;
  }

  .rb-newsletter-pill input[type="email"]::placeholder {
    color: #9a958d;
  }

  .rb-newsletter-pill button[type="submit"] {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1b1a16;
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .rb-newsletter-pill button[type="submit"]:hover {
    background: #2D6A2F;
  }

  .rb-newsletter-pill button[type="submit"] svg {
    width: 16px;
    height: 16px;
  }

  /* Bottom bar */
  .rb-footer-bottom {
    border-top: 1px solid rgba(27, 26, 22, 0.12);
    padding-top: 22px;
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rb-footer-copyright {
    font-family: 'Manrope', sans-serif;
    font-size: 12.5px;
    color: #7a7567;
    margin: 0;
  }

  .rb-footer-legal-links {
    display: flex;
    align-items: center;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rb-footer-legal-links a {
    font-family: 'Manrope', sans-serif;
    font-size: 12.5px;
    color: #7a7567;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .rb-footer-legal-links a:hover {
    color: #1b1a16;
  }

  .rb-payment-icons {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .rb-payment-icon {
    height: 28px !important;
    width: auto !important;
    border-radius: 4px;
    display: inline-block;
    vertical-align: middle;
    stroke: none !important;
  }

  .rb-payment-icon * {
    stroke: none !important;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .rb-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  /* Accordion — desktop: behaves like a normal div */
  .rb-footer-accordion { display: block; }
  .rb-footer-accordion-trigger { list-style: none; display: none; }
  .rb-footer-accordion-trigger::-webkit-details-marker { display: none; }
  .rb-footer-chevron { flex-shrink: 0; transition: transform 0.22s ease; }
  /* Force content visible on desktop (overrides UA details hiding) */
  .rb-footer-accordion-body { display: block; }

  @media (max-width: 580px) {
    .rb-footer-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .rb-footer-inner {
      padding: 40px 20px 24px;
    }

    /* Mobile accordions */
    .rb-footer-accordion {
      display: block;
      border-bottom: 1px solid rgba(27,26,22,0.1);
    }

    .rb-footer-accordion-trigger {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      cursor: pointer;
      padding: 18px 0;
      font-family: 'Manrope', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #33302b;
      background: none;
      border: none;
      text-align: left;
    }

    /* On mobile: trigger is the heading — hide the static label span */
    .rb-footer-accordion > .rb-footer-nav-label,
    .rb-footer-accordion > .rb-footer-newsletter-label {
      display: none;
    }

    /* Chevron rotation when open */
    .rb-footer-accordion[open] .rb-footer-chevron { transform: rotate(180deg); }

    .rb-footer-accordion:not([open]) .rb-footer-accordion-body {
      display: none;
    }

    .rb-footer-accordion-body {
      padding-bottom: 18px;
    }

    /* Brand column stays full width, no accordion */
    .rb-footer-col--brand {
      padding-bottom: 28px;
      border-bottom: 1px solid rgba(27,26,22,0.1);
      margin-bottom: 4px;
    }

    .rb-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>

<footer class="rb-footer-wrap">
  <div class="rb-footer-inner">
    <div class="rb-footer-grid">

      {%- comment -%} Column 1 — Brand {%- endcomment -%}
      <div class="rb-footer-col rb-footer-col--brand">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 280 }}"
            alt="{{ shop.name }}"
            class="rb-footer-brand-logo"
            width="140"
            height="auto"
            loading="lazy"
          >
        {% else %}
          <span style="font-family:'Big Shoulders Display', sans-serif;font-size:22px;font-weight:800;letter-spacing:-0.03em;color:#1b1a16;display:block;margin-bottom:16px;">{{ shop.name }}</span>
        {% endif %}

        <p class="rb-footer-tagline">{{ section.settings.tagline }}</p>

        <p class="rb-footer-address">1160 NE 24th Ct, Wilton Manors, FL 33305</p>

        {%- liquid
          assign app_store_link = section.settings.app_store_url | default: 'https://apps.apple.com/us/app/rocket-boyz/id1563098579'
          assign play_store_link = section.settings.play_store_url | default: 'https://play.google.com/store/apps/details?id=co.tapcart.app.id_QachCPDHjt'
        -%}
        <div class="rb-footer-app">
          {% if section.settings.app_store_label != blank %}
            <p class="rb-footer-app__label">{{ section.settings.app_store_label }}</p>
          {% endif %}
          <div class="rb-footer-app__badges">
            <a href="{{ app_store_link }}" class="rb-app-badge" target="_blank" rel="noopener" aria-label="Download the RocketBoyz app on the Apple App Store">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M17.05 12.54c-.02-2.05 1.67-3.03 1.75-3.08-0.95-1.4-2.44-1.59-2.97-1.61-1.26-.13-2.46.74-3.1.74-.64 0-1.63-.72-2.68-.7-1.38.02-2.65.8-3.36 2.03-1.43 2.49-.37 6.17 1.03 8.19.68.99 1.5 2.1 2.56 2.06 1.03-.04 1.42-.66 2.66-.66 1.24 0 1.59.66 2.68.64 1.11-.02 1.81-1.01 2.49-2 .78-1.15 1.11-2.26 1.13-2.32-.02-.01-2.17-.83-2.19-3.29z"/>
                <path d="M15.02 6.32c.57-.69.95-1.65.85-2.6-.82.03-1.81.54-2.39 1.23-.52.61-.98 1.59-.86 2.52.91.07 1.84-.46 2.4-1.15z"/>
              </svg>
              <span class="rb-app-badge__text">
                <span class="rb-app-badge__eyebrow">Download on the</span>
                <span class="rb-app-badge__store">App Store</span>
              </span>
            </a>

            {%- if play_store_link != blank -%}
              <a href="{{ play_store_link }}" class="rb-app-badge" target="_blank" rel="noopener" aria-label="Get the RocketBoyz app on Google Play">
                {%- comment -%} Google Play mark — four segments of the play triangle {%- endcomment -%}
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3.61 1.81a1.5 1.5 0 0 0-.35.99v18.4c0 .38.13.73.35.99l.06.06L13.8 12.12v-.24L3.67 1.75z"/>
                  <path d="M17.18 15.52 13.8 12.12v-.24l3.38-3.4.08.05 4.01 2.28c1.15.65 1.15 1.72 0 2.37l-4.01 2.28z"/>
                  <path d="m17.26 15.47-3.46-3.47-10.19 10.2c.38.4 1 .45 1.71.05l11.94-6.78"/>
                  <path d="M17.26 8.53 5.32 1.75c-.71-.4-1.33-.35-1.71.05l10.19 10.2z"/>
                </svg>
                <span class="rb-app-badge__text">
                  <span class="rb-app-badge__eyebrow">Get it on</span>
                  <span class="rb-app-badge__store">Google Play</span>
                </span>
              </a>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.contact_email != blank or section.settings.contact_phone != blank -%}
          <div class="rb-footer-contact-icons">
            {%- if section.settings.contact_email != blank -%}
              <a href="mailto:{{ section.settings.contact_email }}" class="rb-social-icon rb-social-icon--contact" aria-label="Email us">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if section.settings.contact_phone != blank -%}
              <a href="tel:{{ section.settings.contact_phone | strip }}" class="rb-social-icon rb-social-icon--contact" aria-label="Call us">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Column 2 — Quick Links {%- endcomment -%}
      <div class="rb-footer-col">
        <details class="rb-footer-accordion">
          <summary class="rb-footer-accordion-trigger">
            Quick Links
            <svg class="rb-footer-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <span class="rb-footer-nav-label" style="display:block;margin-bottom:18px;">Quick Links</span>
          <div class="rb-footer-accordion-body">
            <ul class="rb-footer-nav-list">
              <li><a href="/collections/snacks">Snacks</a></li>
              <li><a href="/collections/beverages">Beverages</a></li>
              <li><a href="/collections/sweets">Sweets</a></li>
              <li><a href="/collections/household">Household</a></li>
              <li><a href="/collections/grocery">Grocery</a></li>
              <li><a href="/pages/wholesale">Wholesale</a></li>
              <li><a href="/collections/health-beauty">Health &amp; Beauty</a></li>
              <li><a href="/pages/dollar-menu">Dollar Menu</a></li>
              <li><a href="/pages/product-catalog">Product Catalog</a></li>
            </ul>
          </div>
        </details>
      </div>

      {%- comment -%} Column 3 — Customer Care {%- endcomment -%}
      <div class="rb-footer-col">
        <details class="rb-footer-accordion">
          <summary class="rb-footer-accordion-trigger">
            Customer Care
            <svg class="rb-footer-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <span class="rb-footer-nav-label" style="display:block;margin-bottom:18px;">Customer Care</span>
          <div class="rb-footer-accordion-body">
            <ul class="rb-footer-nav-list">
              <li><a href="/pages/customer-service#still-need-a-hand">Contact Us</a></li>
              <li><a href="/policies/shipping-policy">Delivery And Returns</a></li>
              <li><a href="/policies/refund-policy">Refund Policy</a></li>
              <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
              <li><a href="/policies/terms-of-service">Terms Of Service</a></li>
            </ul>
          </div>
        </details>
      </div>

      {%- comment -%} Column 4 — Newsletter {%- endcomment -%}
      <div class="rb-footer-col">
        <details class="rb-footer-accordion">
          <summary class="rb-footer-accordion-trigger">
            Newsletter
            <svg class="rb-footer-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <span class="rb-footer-newsletter-label" style="display:block;margin-bottom:10px;">Know Wah Gwaan</span>
          <div class="rb-footer-accordion-body">
            <p class="rb-footer-newsletter-sub">Sign up for exclusive updates, new arrivals &amp; insider only discounts.</p>
            {% form 'customer' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="rb-newsletter-pill">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="Email"
                  autocomplete="email"
                  aria-label="Email address for newsletter"
                  required
                >
                <button type="submit" aria-label="Subscribe">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </button>
              </div>
              {% if form.posted_successfully? %}
                <p style="margin-top:10px;font-family:'Manrope', sans-serif;font-size:13.5px;color:#1f8a3a;">Thanks for subscribing!</p>
              {% endif %}
              {% if form.errors %}
                <p style="margin-top:10px;font-family:'Manrope', sans-serif;font-size:13.5px;color:#E63946;">{{ form.errors | default_errors }}</p>
              {% endif %}
            {% endform %}

            {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.facebook_url != blank -%}
              <div class="rb-footer-follow">
                <span class="rb-footer-newsletter-label">{{ section.settings.follow_heading }}</span>
                <div class="rb-footer-socials">
                  {% if section.settings.instagram_url != blank %}
                    <a href="{{ section.settings.instagram_url }}" class="rb-social-icon" target="_blank" rel="noopener" aria-label="Instagram">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="2" y="2" width="20" height="20" rx="5"/>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                      </svg>
                    </a>
                  {% endif %}

                  {% if section.settings.tiktok_url != blank %}
                    <a href="{{ section.settings.tiktok_url }}" class="rb-social-icon rb-social-icon--filled" target="_blank" rel="noopener" aria-label="TikTok">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.53V6.77a4.85 4.85 0 0 1-1.02-.08z"/>
                      </svg>
                    </a>
                  {% endif %}

                  {% if section.settings.facebook_url != blank %}
                    <a href="{{ section.settings.facebook_url }}" class="rb-social-icon rb-social-icon--filled" target="_blank" rel="noopener" aria-label="Facebook">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                      </svg>
                    </a>
                  {% endif %}
                </div>
              </div>
            {%- endif -%}
          </div>
        </details>
      </div>

    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="rb-footer-bottom">
      <p class="rb-footer-copyright">{{ section.settings.copyright }}</p>

      <div class="rb-payment-icons">
        {{ 'visa' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'master' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'american_express' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'apple_pay' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'discover' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'paypal' | payment_type_svg_tag: class: 'rb-payment-icon' }}
        {{ 'shopify_pay' | payment_type_svg_tag: class: 'rb-payment-icon' }}
      </div>
    </div>

  </div>
</footer>

{%- comment -%}
  Footer accordions ship CLOSED so mobile isn't a wall of expanded links, and
  so there's no flash of open content before JS runs.

  On desktop they must be open: the CSS sets `.rb-footer-accordion-body
  { display: block }` to defeat the UA's details-hiding, but modern browsers
  hide closed content via `content-visibility` on ::details-content, which
  `display` can't override. So we set `open` explicitly above the mobile
  breakpoint instead of relying on the CSS alone.
{%- endcomment -%}
<script>
  (function () {
    var mq = window.matchMedia('(max-width: 580px)');
    var accordions = document.querySelectorAll('.rb-footer-accordion');
    if (!accordions.length) return;

    function sync(e) {
      var isMobile = e.matches;
      accordions.forEach(function (d) { d.open = !isMobile; });
    }

    sync(mq);
    /* older Safari only has addListener */
    if (mq.addEventListener) mq.addEventListener('change', sync);
    else if (mq.addListener) mq.addListener(sync);
  })();
</script>

