<style>
  .rb-wholesale-section {
    max-width: 1280px;
    margin: 48px auto;
    padding: 0 32px;
  }

  .rb-wholesale-card {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    padding: 64px 56px;
    box-shadow: 0 30px 70px -40px rgba(20, 40, 28, 0.22);
  }

  .rb-wholesale-watermark {
    position: absolute;
    right: -30px;
    bottom: -50px;
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 220px;
    color: rgba(27, 26, 22, 0.04);
    line-height: 0.8;
    pointer-events: none;
    user-select: none;
  }

  .rb-wholesale-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .rb-wholesale-heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.92;
    text-transform: uppercase;
    color: #030213;
    margin: 0 0 22px;
  }

  .rb-wholesale-sub {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    line-height: 1.55;
    color: #54514a;
    max-width: 480px;
    margin: 22px auto 0;
  }

  .rb-wholesale-cta-wrap {
    margin-top: 36px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: nowrap;
  }

  @media (max-width: 480px) {
    .rb-wholesale-cta-wrap { gap: 6px; }
    .rb-wholesale-btn { padding: 10px 12px; font-size: 12px; gap: 5px; }
  }

  .rb-wholesale-btn {
    font-family: 'Manrope', sans-serif;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 14px 28px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    background: transparent;
    color: #1b1a16;
    border: 1.5px solid rgba(27, 26, 22, 0.22);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .rb-wholesale-btn--primary,
  .rb-wholesale-btn--secondary {
    background: transparent;
    color: #1b1a16;
    border: 1.5px solid rgba(27, 26, 22, 0.22);
  }

  .rb-wholesale-btn--primary:hover,
  .rb-wholesale-btn--secondary:hover {
    background: #2D6A2F;
    color: #fff;
    border-color: transparent;
    transform: translateY(-2px);
  }

  .rb-wholesale-badges {
    display: flex;
    gap: 26px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .rb-wholesale-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'Manrope', sans-serif;
    font-size: 13.5px;
    color: #54514a;
  }

  .rb-wholesale-badge svg {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .rb-wholesale-card {
      padding: 40px 24px;
    }
    .rb-wholesale-pill {
      flex-direction: column;
      border-radius: 16px;
      padding: 16px;
      align-items: stretch;
    }
    .rb-wholesale-pill input[type="email"] {
      min-width: 0;
      width: 100%;
    }
    .rb-wholesale-pill-btn {
      justify-content: center;
    }
    .rb-wholesale-badges {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
  }
</style>

<div class="rb-wholesale-section">
  <div class="rb-wholesale-card">
<div class="rb-wholesale-content">
      <h2 class="rb-wholesale-heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}
      </h2>

      <p class="rb-wholesale-sub">{{ section.settings.description }}</p>

      <div class="rb-wholesale-cta-wrap">
        <a href="{{ section.settings.retail_url | default: '/collections/all' }}" class="rb-wholesale-btn rb-wholesale-btn--primary">
          Shop Retail
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="{{ section.settings.wholesale_url | default: '/pages/wholesale' }}" class="rb-wholesale-btn rb-wholesale-btn--secondary">
          Shop Wholesale
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Bring the Caribbean"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "to your doorstep"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Wholesale pricing, mixed pallets, and 48-hour nationwide shipping. Apply once and your account manager handles the rest."
    },
    {
      "type": "url",
      "id": "retail_url",
      "label": "Shop Retail URL"
    },
    {
      "type": "url",
      "id": "wholesale_url",
      "label": "Shop Wholesale URL"
    }
  ],
  "presets": [
    {
      "name": "Wholesale CTA"
    }
  ]
}
{% endschema %}
