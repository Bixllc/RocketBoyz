<style>
  .rb-wholesale-section {
    max-width: 1280px;
    margin: 48px auto;
    padding: 0 32px;
  }

  .rb-wholesale-card {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    padding: 64px 56px;
    box-shadow: 0 30px 70px -40px rgba(20, 40, 28, 0.22);
  }

  .rb-wholesale-watermark {
    position: absolute;
    right: -30px;
    bottom: -50px;
    font-family: 'Anton', sans-serif;
    font-size: 220px;
    color: rgba(27, 26, 22, 0.04);
    line-height: 0.8;
    pointer-events: none;
    user-select: none;
  }

  .rb-wholesale-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .rb-wholesale-heading {
    font-family: 'Anton', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.92;
    text-transform: uppercase;
    background: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0 0 22px;
  }

  .rb-wholesale-sub {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    line-height: 1.55;
    color: #54514a;
    max-width: 480px;
    margin: 22px auto 0;
  }

  .rb-wholesale-cta-wrap {
    margin-top: 36px;
  }

  .rb-wholesale-pill {
    display: inline-flex;
    align-items: center;
    background: #f3f1ec;
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    gap: 8px;
    border: 1px solid rgba(27, 26, 22, 0.1);
  }

  .rb-wholesale-pill input[type="email"] {
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 15px;
    color: #1b1a16;
    min-width: 200px;
  }

  .rb-wholesale-pill input[type="email"]::placeholder {
    color: #9a958d;
  }

  .rb-wholesale-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fbfaf7;
    color: #1b1a16;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14.5px;
    font-weight: 700;
    border: 1px solid rgba(27, 26, 22, 0.16);
    border-radius: 999px;
    padding: 12px 22px;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .rb-wholesale-pill-btn:hover {
    background: #f3f1ec;
  }

  .rb-wholesale-badges {
    display: flex;
    gap: 26px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .rb-wholesale-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13.5px;
    color: #54514a;
  }

  .rb-wholesale-badge svg {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .rb-wholesale-card {
      padding: 40px 24px;
    }
    .rb-wholesale-pill {
      flex-direction: column;
      border-radius: 16px;
      padding: 16px;
      align-items: stretch;
    }
    .rb-wholesale-pill input[type="email"] {
      min-width: 0;
      width: 100%;
    }
    .rb-wholesale-pill-btn {
      justify-content: center;
    }
    .rb-wholesale-badges {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Hanken+Grotesk:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="rb-wholesale-section">
  <div class="rb-wholesale-card">
    <div class="rb-wholesale-watermark" aria-hidden="true">96</div>

    <div class="rb-wholesale-content">
      <h2 class="rb-wholesale-heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}
      </h2>

      <p class="rb-wholesale-sub">{{ section.settings.description }}</p>

      <div class="rb-wholesale-cta-wrap">
        <div class="rb-wholesale-pill">
          <input type="email" placeholder="Business email" aria-label="Business email">
          <a href="{{ section.settings.cta_url }}" class="rb-wholesale-pill-btn">
            {{ section.settings.cta_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="rb-wholesale-badges">
        <div class="rb-wholesale-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1f8a3a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          No minimum first order
        </div>
        <div class="rb-wholesale-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1f8a3a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          Net-30 terms available
        </div>
        <div class="rb-wholesale-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1f8a3a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          Dedicated rep
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wholesale CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Stock Rocket Boyz"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "by the case"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Wholesale pricing, mixed pallets, and 48-hour nationwide shipping. Apply once and your account manager handles the rest."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Apply now"
    }
  ],
  "presets": [
    {
      "name": "Wholesale CTA"
    }
  ]
}
{% endschema %}
