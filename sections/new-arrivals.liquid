{{ 'rb-design.css' | asset_url | stylesheet_tag }}

<style>
  .rb-new-arrivals .rb-section-link {
    background: #2D6A2F;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    border-bottom: 1.5px solid transparent;
    border-image: #2D6A2F;
    border-image-slice: 1;
  }
  .rb-new-arrivals .rb-section-link:hover {
    opacity: 0.7;
  }

  .rb-new-arrivals .rb-product-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    font-family: 'Manrope', sans-serif;
    font-size: 10.5px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    background: #2D6A2F;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .rb-new-arrivals .rb-product-card__add-form {
    display: inline-block;
  }
</style>

<section class="rb-new-arrivals">
  <div class="rb-section-inner" style="max-width:1280px; margin:0 auto; padding:54px 32px 30px;">

    {% if section.blocks.size > 0 %}

      <!-- Section Header -->
      <div class="rb-section-header">
        <h2 class="rb-heading" style="font-size:clamp(34px,4vw,56px); line-height:0.95;">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="rb-section-link">
            {{ section.settings.view_all_text }}
          </a>
        {%- endif -%}
      </div>

      <!-- Product Grid -->
      <div class="rb-grid-4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- render 'rb-product-card', product: block.settings.product, badge_text: block.settings.badge_text, block_attributes: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "See all new"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional)",
          "info": "e.g. New, Restocked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
