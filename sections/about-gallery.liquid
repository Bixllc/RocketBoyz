<style>
  .about-gallery-section {
    background: #fff;
    padding: 0 32px 96px;
  }

  .about-gallery-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 16px;
  }

  .about-gallery-item {
    border-radius: 20px;
    overflow: hidden;
    background: #F4F4F5;
    position: relative;
  }

  /* Row 1: small left, wide right */
  .about-gallery-item:nth-child(1) {
    grid-column: 1 / 2;
    grid-row: 1;
    aspect-ratio: 1 / 1;
  }

  .about-gallery-item:nth-child(2) {
    grid-column: 2 / 4;
    grid-row: 1;
    aspect-ratio: 16 / 9;
  }

  /* Row 2: wide left, small right */
  .about-gallery-item:nth-child(3) {
    grid-column: 1 / 3;
    grid-row: 2;
    aspect-ratio: 16 / 9;
  }

  .about-gallery-item:nth-child(4) {
    grid-column: 3 / 4;
    grid-row: 2;
    aspect-ratio: 1 / 1;
  }

  .about-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .about-gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(3, 2, 19, 0);
    transition: background 0.35s ease;
    pointer-events: none;
    border-radius: 20px;
  }

  .about-gallery-item:hover img {
    transform: scale(1.03);
  }

  .about-gallery-item:hover::after {
    background: rgba(3, 2, 19, 0.38);
  }

  @media (max-width: 768px) {
    .about-gallery-section {
      padding: 0 16px 64px;
    }

    .about-gallery-inner {
      grid-template-columns: 1fr 1fr;
    }

    .about-gallery-item:nth-child(1),
    .about-gallery-item:nth-child(2),
    .about-gallery-item:nth-child(3),
    .about-gallery-item:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>

<section class="about-gallery-section">
  <div class="about-gallery-inner">
    {%- for i in (1..4) -%}
      {%- assign img_key = 'image_' | append: i -%}
      {%- assign alt_key = 'alt_' | append: i -%}
      <div class="about-gallery-item">
        {%- if section.settings[img_key] != blank -%}
          <img
            src="{{ section.settings[img_key] | image_url: width: 1200 }}"
            alt="{{ section.settings[alt_key] | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "About Gallery",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (top left, square)" },
    { "type": "text",         "id": "alt_1",   "label": "Alt text 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (top right, wide)" },
    { "type": "text",         "id": "alt_2",   "label": "Alt text 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3 (bottom left, wide)" },
    { "type": "text",         "id": "alt_3",   "label": "Alt text 3" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4 (bottom right, square)" },
    { "type": "text",         "id": "alt_4",   "label": "Alt text 4" }
  ],
  "presets": [
    { "name": "About Gallery" }
  ]
}
{% endschema %}
