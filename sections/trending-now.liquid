{{ 'rb-design.css' | asset_url | stylesheet_tag }}

<style>
  .rb-trending-now .rb-section-link {
    background: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    border-bottom: 1.5px solid transparent;
    border-image: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    border-image-slice: 1;
  }
  .rb-trending-now .rb-section-link:hover {
    opacity: 0.7;
  }
</style>

<section class="rb-trending-now" style="background:#ffffff; color:#1b1a16; margin-top:40px;">
  <div style="max-width:1280px; margin:0 auto; padding:64px 32px;">

    {% if section.blocks.size > 0 %}

      <!-- Section Header -->
      <div class="rb-section-header">
        <h2 class="rb-heading" style="font-size:clamp(34px,4vw,56px); line-height:0.95;">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="rb-section-link">
            {{ section.settings.view_all_text }}
          </a>
        {%- endif -%}
      </div>

      <!-- Product Grid -->
      <div class="rb-grid-4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- render 'rb-product-card', product: block.settings.product, badge_text: block.settings.badge_text, block_attributes: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Trending Now",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all link text",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional)",
          "info": "e.g. New, Restocked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trending Now",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
