<style>
  @font-face {
    font-family: 'Anton';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ "anton-v27-latin-regular.woff2" | asset_url }}') format('woff2');
  }

  .rocket-hero {
    position: relative;
    width: 100%;
    min-height: 720px;
    overflow: hidden;
    background-color: #17150f;
    {% if section.settings.hero_image != blank %}
    background-image:
      linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.58) 30%, rgba(0,0,0,.12) 58%, rgba(0,0,0,0) 100%),
      url('{{ section.settings.hero_image | image_url: width: 2400 }}');
    {% else %}
    background-image:
      linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.58) 30%, rgba(0,0,0,.12) 58%, rgba(0,0,0,0) 100%);
    {% endif %}
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .rocket-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
    min-height: 720px;
    padding-left: 64px;
    padding-right: 32px;
    display: flex;
    align-items: center;
  }

  .rocket-hero__content {
    max-width: 560px;
    text-align: left;
  }

  .rocket-hero__heading {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    font-size: clamp(48px, 5.6vw, 90px);
    line-height: 0.88;
    text-transform: uppercase;
    color: #f3f0e9;
    margin: 0;
  }

  .rocket-hero__subtext {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-size: 19px;
    line-height: 1.6;
    color: rgba(243, 240, 233, 0.82);
    max-width: 460px;
    margin-top: 26px;
    margin-bottom: 0;
  }

  .rocket-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
    margin-top: 34px;
  }

  .rocket-hero__btn {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-weight: 600;
    font-size: 15px;
    padding: 13px 26px;
    background: transparent;
    color: #f3f0e9;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .rocket-hero__btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
    color: #ffffff;
  }

  .rocket-hero__btn svg {
    flex-shrink: 0;
  }

  @media (min-width: 1600px) {
    .rocket-hero,
    .rocket-hero__container {
      min-height: 760px;
    }
  }

  @media (max-width: 768px) {
    .rocket-hero,
    .rocket-hero__container {
      min-height: 680px;
    }

    .rocket-hero__container {
      padding-left: 20px;
      padding-right: 20px;
      align-items: center;
    }

    .rocket-hero__content {
      max-width: 100%;
    }

    .rocket-hero__subtext {
      max-width: 100%;
      font-size: 17px;
    }

    .rocket-hero__buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<section class="rocket-hero">

  <div class="rocket-hero__container">
    <div class="rocket-hero__content">

      <h1 class="rocket-hero__heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}<br>
        {{ section.settings.heading_line3 }}
      </h1>

      {%- if section.settings.subtext != blank -%}
        <p class="rocket-hero__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="rocket-hero__buttons">
        {%- if section.settings.cta1_text != blank -%}
          <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="rocket-hero__btn">
            {{ section.settings.cta1_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_url | default: '#snackbox' }}" class="rocket-hero__btn">
            {{ section.settings.cta2_text }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Rocket Hero V2",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (flattened: background, snack box, products, lighting)"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — line 1",
      "default": "Taste the"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — line 2",
      "default": "vibes of the"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading — line 3",
      "default": "Caribbean"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Island-direct snacks, warehoused stateside and shipped fast. From cheese curls to sorrel — Rocket Boyz keeps the culture in stock."
    },
    {
      "type": "text",
      "id": "cta1_text",
      "label": "Button 1 text",
      "default": "Shop snacks"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Button 2 text",
      "default": "Explore snack box"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "Rocket Hero V2"
    }
  ]
}
{% endschema %}
