<style>
  .social-videos-section {
    background: #fbfaf7;
    padding: 72px 0;
  }

  .social-videos-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .social-videos-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .social-videos-heading {
    font-family: 'Anton', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1;
    color: #1b1a16;
    text-transform: uppercase;
    margin: 0;
  }

  .social-videos-ig-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1b1a16;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: opacity 0.2s ease;
  }

  .social-videos-ig-link:hover {
    opacity: 0.7;
  }

  .social-videos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .social-video-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    background: #1b1a16;
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .social-video-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .social-video-card:hover .social-video-card__bg {
    transform: scale(1.04);
  }

  .social-video-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.35) 0%,
      transparent 34%,
      transparent 60%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  .social-video-card__top {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .social-video-card__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1b1a16;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Anton', sans-serif;
    font-size: 12px;
    color: #ffffff;
    flex-shrink: 0;
    line-height: 1;
  }

  .social-video-card__handle {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
  }

  .social-video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .social-video-card:hover .social-video-card__play {
    background: #ffffff;
    transform: translate(-50%, -50%) scale(1.07);
  }

  .social-video-card__play svg {
    color: #1b1a16;
    margin-left: 3px;
  }

  .social-video-card__bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 14px 14px 16px;
  }

  .social-video-card__caption {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.4;
    margin: 0 0 8px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .social-video-card__likes {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
  }

  .social-video-card__likes svg {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .social-videos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .social-videos-container {
      padding: 0 16px;
    }

    .social-videos-section {
      padding: 48px 0;
    }

    .social-videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>

<section class="social-videos-section">
  <div class="social-videos-container">

    <!-- Section Header -->
    <div class="social-videos-header">
      <h2 class="social-videos-heading">Snacks in the wild</h2>
      {% if section.settings.instagram_url != blank %}
        <a href="{{ section.settings.instagram_url }}" class="social-videos-ig-link" target="_blank" rel="noopener noreferrer">
          @rocketboyz
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 7h10v10"/>
            <path d="M7 17 17 7"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Video Grid -->
    {% if section.blocks.size > 0 %}
      <div class="social-videos-grid">
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.url | default: section.settings.instagram_url | default: '#' }}"
            class="social-video-card"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ block.settings.caption | default: 'Watch on Instagram' | escape }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image %}
              <img
                class="social-video-card__bg"
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.caption | default: '' | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {% else %}
              <div style="position:absolute;inset:0;background:linear-gradient(160deg,#2a2920 0%,#1b1a16 100%);"></div>
            {% endif %}

            <div class="social-video-card__overlay"></div>

            <!-- Top: avatar + handle -->
            <div class="social-video-card__top">
              <div class="social-video-card__avatar" aria-hidden="true">R</div>
              <span class="social-video-card__handle">{{ block.settings.handle | default: '@rocketboyz' }}</span>
            </div>

            <!-- Center: play button -->
            <div class="social-video-card__play" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="5,3 19,12 5,21"/>
              </svg>
            </div>

            <!-- Bottom: caption + likes -->
            <div class="social-video-card__bottom">
              {% if block.settings.caption != blank %}
                <p class="social-video-card__caption">{{ block.settings.caption }}</p>
              {% endif %}
              <div class="social-video-card__likes">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                <span>{{ block.settings.likes | default: '1.2k' }}</span>
              </div>
            </div>

          </a>
        {% endfor %}
      </div>
    {% else %}
      <p style="font-family:'Hanken Grotesk',sans-serif; color:#54514a; font-size:14px; text-align:center; padding:48px 0;">
        Add video blocks in the theme editor to display social content here.
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Social Videos",
  "max_blocks": 8,
  "settings": [
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Card",
      "settings": [
        {
          "type": "text",
          "id": "handle",
          "label": "Instagram Handle",
          "default": "@rocketboyz"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Check out our latest snacks!"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Like Count (display only)",
          "default": "1.2k"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link to Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Videos",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "handle": "@rocketboyz",
            "caption": "Check out our latest snacks!",
            "likes": "1.2k"
          }
        },
        {
          "type": "video",
          "settings": {
            "handle": "@rocketboyz",
            "caption": "Check out our latest snacks!",
            "likes": "987"
          }
        },
        {
          "type": "video",
          "settings": {
            "handle": "@rocketboyz",
            "caption": "Check out our latest snacks!",
            "likes": "2.4k"
          }
        },
        {
          "type": "video",
          "settings": {
            "handle": "@rocketboyz",
            "caption": "Check out our latest snacks!",
            "likes": "743"
          }
        }
      ]
    }
  ]
}
{% endschema %}
