<style>
  .brand-story-section {
    background: #ffffff;
    color: #1b1a16;
    overflow: hidden;
  }

  .brand-story-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 32px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 54px;
    align-items: center;
  }

  .brand-story-image-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1.12 / 1;
    box-shadow: 0 40px 80px -44px rgba(20, 22, 18, 0.5);
    border: 1px solid rgba(27, 26, 22, 0.1);
  }

  .brand-story-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-story-image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #f4f0e7 0%, #e6e0cf 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 13px;
    color: rgba(27, 26, 22, 0.35);
  }

  .brand-story-copy {
    display: flex;
    flex-direction: column;
  }

  .brand-story-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    margin: 0 0 18px 0;
  }

  .brand-story-heading {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.94;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 32px 0;
  }

  .brand-story-paragraph {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: #54514a;
    margin: 0 0 20px 0;
  }

  .brand-story-paragraph:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .brand-story-inner {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 60px 24px;
    }

    .brand-story-image-wrap {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 520px) {
    .brand-story-inner {
      padding: 48px 16px;
    }
  }
</style>

<section class="brand-story-section">
  <div class="brand-story-inner">

    <!-- Left: Editorial Photo -->
    <div class="brand-story-image-wrap">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.eyebrow | default: 'Brand Story' | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="brand-story-image-placeholder">Add an image</div>
      {% endif %}
    </div>

    <!-- Right: Copy -->
    <div class="brand-story-copy">
      <p class="brand-story-eyebrow">{{ section.settings.eyebrow | default: 'More than just snacks' }}</p>

      <h2 class="brand-story-heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}
      </h2>

      {% if section.settings.paragraph1 != blank %}
        <p class="brand-story-paragraph">{{ section.settings.paragraph1 }}</p>
      {% endif %}

      {% if section.settings.paragraph2 != blank %}
        <p class="brand-story-paragraph">{{ section.settings.paragraph2 }}</p>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Photo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "More than just snacks"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "It's culture"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "you can taste"
    },
    {
      "type": "textarea",
      "id": "paragraph1",
      "label": "Paragraph 1",
      "default": "Rocket Boyz started with a simple craving — the snacks we grew up on, the ones you couldn't find on a shelf abroad. So we built the bridge. Every box carries a little bit of home: the corner-shop nostalgia, the after-school crunch, the flavour that says yard."
    },
    {
      "type": "textarea",
      "id": "paragraph2",
      "label": "Paragraph 2",
      "default": "We work island-direct with the makers who've been doing it for generations — so the culture stays in the hands that built it."
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
