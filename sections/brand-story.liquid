<style>
  .brand-story-section {
    background: #ffffff;
    color: #1b1a16;
    overflow: hidden;
  }

  .brand-story-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 32px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 54px;
    align-items: center;
  }

  .brand-story-image-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 1.12 / 1;
    box-shadow: 0 40px 80px -44px rgba(20, 22, 18, 0.5);
    border: 1px solid rgba(27, 26, 22, 0.1);
  }

  .brand-story-image-wrap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-story-image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #f4f0e7 0%, #e6e0cf 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    color: rgba(27, 26, 22, 0.35);
  }

  .brand-story-copy {
    display: flex;
    flex-direction: column;
  }

  .brand-story-eyebrow {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: #105020;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    margin: 0 0 18px 0;
  }

  .brand-story-heading {
    font-family: 'Big Shoulders Display', sans-serif !important;
    font-weight: 800;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.94;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 32px 0;
  }

  .brand-story-heading__line {
    display: block;
  }

  .brand-story-heading__gradient {
    background: #105020;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }

  .brand-story-divider {
    width: 48px;
    height: 2px;
    background: #E4E4E7;
    border: none;
    margin: 0 0 28px 0;
    border-radius: 999px;
  }

  .brand-story-paragraph {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: #52525B;
    margin: 0 0 20px 0;
  }

  .brand-story-paragraph:last-child {
    margin-bottom: 0;
  }

  .brand-story-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 32px;
    padding: 15px 28px;
    border-radius: 999px;
    background: #105020;
    color: #ffffff;
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    box-shadow: 0 4px 14px rgba(220, 38, 38, 0.25);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .brand-story-cta:hover {
    background: linear-gradient(to right, #ef4444, #fde047);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(220, 38, 38, 0.38);
  }

  .brand-story-cta svg {
    stroke: #ffffff;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .brand-story-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 20px;
    }

    /* Text above image on mobile */
    .brand-story-image-wrap {
      order: 2;
      aspect-ratio: 4 / 3;
    }

    .brand-story-copy {
      order: 1;
    }

    .brand-story-heading {
      font-size: clamp(30px, 9vw, 44px);
    }

    .brand-story-paragraph {
      font-size: 15px;
    }
  }

  @media (max-width: 520px) {
    .brand-story-inner {
      padding: 40px 16px;
      gap: 24px;
    }

    .brand-story-heading {
      font-size: clamp(28px, 11vw, 40px);
    }
  }
</style>

<section class="brand-story-section">
  <div class="brand-story-inner">

    <!-- Left: Editorial Photo -->
    <div class="brand-story-image-wrap">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.eyebrow | default: 'Brand Story' | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="brand-story-image-placeholder">Add an image</div>
      {% endif %}
    </div>

    <!-- Right: Copy -->
    <div class="brand-story-copy">
      <p class="brand-story-eyebrow">{{ section.settings.eyebrow | default: 'More than just snacks' }}</p>

      <h2 class="brand-story-heading">
        {%- if section.settings.heading_before != blank -%}
          <span class="brand-story-heading__line">{{ section.settings.heading_before }}</span>
        {%- endif -%}
        {%- if section.settings.heading_gradient != blank -%}
          <span class="brand-story-heading__gradient">{{ section.settings.heading_gradient }}</span>
          {%- if section.settings.heading_after != blank -%}
            <span class="brand-story-heading__line">{{ section.settings.heading_after }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="brand-story-heading__line">{{ section.settings.heading_line1 }}</span>
          {%- if section.settings.heading_line2 != blank -%}
            <span class="brand-story-heading__line">{{ section.settings.heading_line2 }}</span>
          {%- endif -%}
        {%- endif -%}
      </h2>

      <hr class="brand-story-divider">

      {% if section.settings.paragraph1 != blank %}
        <p class="brand-story-paragraph">{{ section.settings.paragraph1 }}</p>
      {% endif %}

      {% if section.settings.paragraph2 != blank %}
        <p class="brand-story-paragraph">{{ section.settings.paragraph2 }}</p>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_url | default: '/pages/about' }}" class="brand-story-cta">
          {{ section.settings.cta_text }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Photo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "More than just snacks"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading — before gradient word",
      "default": "About",
      "info": "Appears on its own line in black"
    },
    {
      "type": "text",
      "id": "heading_gradient",
      "label": "Heading — gradient word(s)",
      "default": "Rocket Boyz",
      "info": "Rendered with brand gradient"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading — after gradient word",
      "default": "Distributors",
      "info": "Appears on its own line in black"
    },
    {
      "type": "header",
      "content": "Body"
    },
    {
      "type": "textarea",
      "id": "paragraph1",
      "label": "Paragraph 1",
      "default": "Rocket Boyz started with a simple craving — the snacks we grew up on, the ones you couldn't find on a shelf abroad. So we built the bridge. Every box carries a little bit of home: the corner-shop nostalgia, the after-school crunch, the flavour that says yard."
    },
    {
      "type": "textarea",
      "id": "paragraph2",
      "label": "Paragraph 2",
      "default": "We work island-direct with the makers who've been doing it for generations — so the culture stays in the hands that built it."
    },
    {
      "type": "header",
      "content": "CTA Button (optional)"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
