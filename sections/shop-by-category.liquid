<style>
  .rb-shop-cat {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 30px;
  }

  /* ── Header row ── */
  .rb-shop-cat__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .rb-shop-cat__heading {
    font-family: 'Big Shoulders Display', sans-serif !important;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.95;
    color: #1b1a16;
    margin: 0;
  }

  /* ── Pills ── */
  .rb-shop-cat__pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .rb-shop-cat__pill {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1.5px solid #E4E4E7;
    background: #fff;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #52525B;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, transform 0.15s;
    white-space: nowrap;
  }

  .rb-shop-cat__pill:hover {
    border-color: #030213;
    color: #030213;
  }

  .rb-shop-cat__pill.is-active {
    background: #030213;
    border-color: #030213;
    color: #fff;
    transform: translateY(-1px);
  }

  /* ── Card container ── */
  .rb-shop-cat__card {
    background: #fff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 24px 50px -34px rgba(20, 22, 18, 0.4);
    height: 430px;
  }

  .rb-shop-cat__track {
    position: relative;
    height: 100%;
  }

  .rb-shop-cat__slide {
    display: none;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: stretch;
    height: 100%;
  }

  .rb-shop-cat__slide.is-active {
    display: grid;
  }

  .rb-shop-cat__text {
    padding: 54px 14px 54px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    animation: rb-shop-cat-fadeUp 0.4s ease both;
  }

  .rb-shop-cat__name {
    font-family: 'Big Shoulders Display', sans-serif !important;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.94;
    color: #1b1a16;
    margin: 0;
  }

  .rb-shop-cat__blurb {
    font-family: 'Manrope', sans-serif !important;
    font-size: 17px;
    line-height: 1.55;
    color: #54514a;
    max-width: 340px;
    margin: 20px 0 0;
  }

  .rb-shop-cat__view-all {
    font-family: 'Manrope', sans-serif !important;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding-bottom: 6px;
    text-transform: uppercase;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: none;
    border-bottom: 2px solid transparent;
    border-image: #105020;
    border-image-slice: 1;
    transition: gap 0.2s ease;
    width: fit-content;
  }

  .rb-shop-cat__view-all:hover { gap: 15px; }

  .rb-shop-cat__view-all-text {
    background: #105020;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .rb-shop-cat__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent;
    height: 100%;
  }

  .rb-shop-cat__image {
    width: 92%;
    height: 92%;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.2));
    animation: rb-shop-cat-popIn 0.5s cubic-bezier(.2, .8, .2, 1) both;
  }

  .rb-shop-cat__can {
    position: absolute;
    top: 50%;
    object-fit: contain;
  }

  .rb-shop-cat__can--center {
    left: 50%;
    width: 28%;
    z-index: 3;
    filter: drop-shadow(0 20px 24px rgba(20, 22, 18, 0.36));
    animation: rb-shop-cat-canCenter 0.6s cubic-bezier(.2, .8, .2, 1) both;
  }

  .rb-shop-cat__can--left {
    left: 30%;
    width: 26%;
    z-index: 2;
    filter: drop-shadow(0 18px 22px rgba(20, 22, 18, 0.3));
    animation: rb-shop-cat-canLeft 0.72s cubic-bezier(.2, .85, .3, 1.05) both;
  }

  .rb-shop-cat__can--right {
    left: 70%;
    width: 26%;
    z-index: 2;
    filter: drop-shadow(0 18px 22px rgba(20, 22, 18, 0.3));
    animation: rb-shop-cat-canRight 0.72s cubic-bezier(.2, .85, .3, 1.05) both;
  }

  /* ── Product panels below ── */
  .rb-shop-cat__products-wrap {
    margin-top: 32px;
  }

  .rb-shop-cat__product-panel {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    animation: rb-shop-cat-fadeUp 0.35s ease both;
  }

  .rb-shop-cat__product-panel.is-active {
    display: grid;
  }

  .rb-shop-cat__empty {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #71717A;
    text-align: center;
    padding: 32px 0;
    grid-column: 1 / -1;
  }

  /* ── Animations ── */
  @keyframes rb-shop-cat-fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes rb-shop-cat-popIn {
    from { opacity: 0; transform: translateY(22px) scale(.92); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes rb-shop-cat-canCenter {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 26px)) scale(.9); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  @keyframes rb-shop-cat-canLeft {
    from { opacity: 0; transform: translate(calc(-50% + 82%), calc(-50% - 2%)) rotate(0deg) scale(.82); }
    to   { opacity: 1; transform: translate(-50%, calc(-50% + 7%)) rotate(-9deg) scale(1); }
  }

  @keyframes rb-shop-cat-canRight {
    from { opacity: 0; transform: translate(calc(-50% - 82%), calc(-50% - 2%)) rotate(0deg) scale(.82); }
    to   { opacity: 1; transform: translate(-50%, calc(-50% + 7%)) rotate(9deg) scale(1); }
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .rb-shop-cat { padding: 48px 20px 24px; }

    .rb-shop-cat__pills { gap: 8px; }

    .rb-shop-cat__pill {
      padding: 8px 16px;
      font-size: 13px;
    }

    .rb-shop-cat__card { height: auto; }
    .rb-shop-cat__track { height: auto; }

    .rb-shop-cat__slide {
      grid-template-columns: 1fr;
      height: auto;
    }

    .rb-shop-cat__text {
      padding: 40px 24px 28px;
      order: 2;
    }

    .rb-shop-cat__stage {
      height: 280px;
      order: 1;
    }

    .rb-shop-cat__product-panel {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .rb-shop-cat__product-panel {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>

{{ 'rb-design.css' | asset_url | stylesheet_tag }}

<div class="rb-shop-cat" data-shop-cat-root>

  <div class="rb-shop-cat__header">
    <h2 class="rb-shop-cat__heading">{{ section.settings.heading }}</h2>
  </div>

  <!-- Pills -->
  {%- if section.blocks.size > 0 -%}
    <div class="rb-shop-cat__pills" role="tablist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button
            type="button"
            class="rb-shop-cat__pill{% if forloop.first %} is-active{% endif %}"
            data-shop-cat-pill="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >{{ block.settings.name }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <!-- Card container -->
  <div class="rb-shop-cat__card">
    <div class="rb-shop-cat__track" data-shop-cat-track>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <div class="rb-shop-cat__slide{% if forloop.first %} is-active{% endif %}" data-shop-cat-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="rb-shop-cat__text">
              <h3 class="rb-shop-cat__name">{{ block.settings.name }}</h3>
              {%- if block.settings.blurb != blank -%}
                <p class="rb-shop-cat__blurb">{{ block.settings.blurb }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="rb-shop-cat__view-all">
                  <span class="rb-shop-cat__view-all-text">View all {{ block.settings.name }}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              {%- endif -%}
            </div>
            <div class="rb-shop-cat__stage">
              {%- if block.settings.image_left != blank and block.settings.image_center != blank and block.settings.image_right != blank -%}
                <img class="rb-shop-cat__can rb-shop-cat__can--left" src="{{ block.settings.image_left | image_url: width: 500 }}" alt="" loading="lazy">
                <img class="rb-shop-cat__can rb-shop-cat__can--center" src="{{ block.settings.image_center | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                <img class="rb-shop-cat__can rb-shop-cat__can--right" src="{{ block.settings.image_right | image_url: width: 500 }}" alt="" loading="lazy">
              {%- elsif block.settings.image != blank -%}
                <img class="rb-shop-cat__image" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Product panels -->
  <div class="rb-shop-cat__products-wrap">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- assign cat_collection = collections[block.settings.collection] -%}
        <div class="rb-shop-cat__product-panel{% if forloop.first %} is-active{% endif %}" data-shop-cat-panel="{{ forloop.index0 }}">
          {%- if cat_collection != empty and cat_collection.products_count > 0 -%}
            {%- for product in cat_collection.products limit: 4 -%}
              {%- render 'rb-product-card', product: product -%}
            {%- endfor -%}
          {%- else -%}
            <p class="rb-shop-cat__empty">
              {%- if block.settings.collection == blank -%}
                Assign a collection to this category in the section settings.
              {%- else -%}
                No products found in this collection.
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>

<script>
(function () {
  var root = document.querySelector('[data-shop-cat-root]');
  if (!root) return;

  var pills  = root.querySelectorAll('[data-shop-cat-pill]');
  var slides = root.querySelectorAll('[data-shop-cat-slide]');
  var panels = root.querySelectorAll('[data-shop-cat-panel]');

  function activate(idx) {
    pills.forEach(function (p) {
      var active = p.dataset.shopCatPill === String(idx);
      p.classList.toggle('is-active', active);
      p.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    slides.forEach(function (s) {
      s.classList.toggle('is-active', s.dataset.shopCatSlide === String(idx));
    });
    panels.forEach(function (p) {
      p.classList.toggle('is-active', p.dataset.shopCatPanel === String(idx));
    });
  }

  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      activate(parseInt(this.dataset.shopCatPill, 10));
    });
  });
})();
</script>

