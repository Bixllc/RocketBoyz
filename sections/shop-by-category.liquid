<style>
  .rb-shop-cat {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 30px;
  }

  .rb-shop-cat__heading {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.95;
    color: #1b1a16;
    margin: 0 0 32px;
  }

  .rb-shop-cat__carousel {
    position: relative;
  }

  .rb-shop-cat__card {
    background: #fff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 24px 50px -34px rgba(20, 22, 18, 0.4);
    height: 430px;
  }

  .rb-shop-cat__track {
    position: relative;
    height: 100%;
  }

  .rb-shop-cat__slide {
    display: none;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: stretch;
    height: 100%;
  }

  .rb-shop-cat__slide.is-active {
    display: grid;
  }

  .rb-shop-cat__text {
    padding: 54px 14px 54px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    animation: rb-shop-cat-fadeUp 0.5s ease both;
  }

  .rb-shop-cat__name {
    font-family: 'Anton', sans-serif !important;
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 0.94;
    color: #1b1a16;
    margin: 0;
  }

  .rb-shop-cat__blurb {
    font-family: 'Hanken Grotesk', sans-serif !important;
    font-size: 17px;
    line-height: 1.55;
    color: #54514a;
    max-width: 340px;
    margin: 20px 0 0;
  }

  .rb-shop-cat__view-all {
    font-family: 'Hanken Grotesk', sans-serif !important;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding-bottom: 6px;
    text-transform: uppercase;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: none;
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    border-image-slice: 1;
    transition: gap 0.2s ease;
    width: fit-content;
  }

  .rb-shop-cat__view-all:hover {
    gap: 15px;
  }

  .rb-shop-cat__view-all-text {
    background: linear-gradient(90deg, #E63946 0%, #FF9F1C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .rb-shop-cat__view-all svg {
    flex-shrink: 0;
  }

  .rb-shop-cat__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent;
    height: 100%;
  }

  .rb-shop-cat__image {
    width: 92%;
    height: 92%;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.2));
    animation: rb-shop-cat-popIn 0.6s cubic-bezier(.2, .8, .2, 1) both;
  }

  .rb-shop-cat__can {
    position: absolute;
    top: 50%;
    object-fit: contain;
  }

  .rb-shop-cat__can--center {
    left: 50%;
    width: 28%;
    z-index: 3;
    filter: drop-shadow(0 20px 24px rgba(20, 22, 18, 0.36));
    animation: rb-shop-cat-canCenter 0.6s cubic-bezier(.2, .8, .2, 1) both;
  }

  .rb-shop-cat__can--left {
    left: 30%;
    width: 26%;
    z-index: 2;
    filter: drop-shadow(0 18px 22px rgba(20, 22, 18, 0.3));
    animation: rb-shop-cat-canLeft 0.72s cubic-bezier(.2, .85, .3, 1.05) both;
  }

  .rb-shop-cat__can--right {
    left: 70%;
    width: 26%;
    z-index: 2;
    filter: drop-shadow(0 18px 22px rgba(20, 22, 18, 0.3));
    animation: rb-shop-cat-canRight 0.72s cubic-bezier(.2, .85, .3, 1.05) both;
  }

  @keyframes rb-shop-cat-fadeUp {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes rb-shop-cat-popIn {
    0% {
      opacity: 0;
      transform: translateY(22px) scale(.92);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes rb-shop-cat-canCenter {
    0% {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 26px)) scale(.9);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes rb-shop-cat-canLeft {
    0% {
      opacity: 0;
      transform: translate(calc(-50% + 82%), calc(-50% - 2%)) rotate(0deg) scale(.82);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, calc(-50% + 7%)) rotate(-9deg) scale(1);
    }
  }

  @keyframes rb-shop-cat-canRight {
    0% {
      opacity: 0;
      transform: translate(calc(-50% - 82%), calc(-50% - 2%)) rotate(0deg) scale(.82);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, calc(-50% + 7%)) rotate(9deg) scale(1);
    }
  }

  .rb-shop-cat__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(27, 26, 22, 0.16);
    background: rgba(255, 255, 255, 0.85);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .rb-shop-cat__arrow svg {
    stroke: #1b1a16;
    transition: stroke 0.2s ease;
  }

  .rb-shop-cat__arrow:hover {
    background: #1b1a16;
    border-color: #1b1a16;
  }

  .rb-shop-cat__arrow:hover svg {
    stroke: #fff;
  }

  .rb-shop-cat__arrow--prev {
    left: -21px;
  }

  .rb-shop-cat__arrow--next {
    right: -21px;
  }

  @media (max-width: 900px) {
    .rb-shop-cat {
      padding: 48px 20px 24px;
    }

    .rb-shop-cat__heading {
      margin-bottom: 20px;
    }

    .rb-shop-cat__card {
      height: auto;
    }

    .rb-shop-cat__track {
      height: auto;
    }

    .rb-shop-cat__slide {
      grid-template-columns: 1fr;
      height: auto;
    }

    .rb-shop-cat__text {
      padding: 40px 24px 28px;
      order: 2;
    }

    .rb-shop-cat__stage {
      height: 280px;
      order: 1;
    }

    .rb-shop-cat__arrow {
      width: 36px;
      height: 36px;
    }

    .rb-shop-cat__arrow--prev {
      left: -14px;
    }

    .rb-shop-cat__arrow--next {
      right: -14px;
    }
  }
</style>

<div class="rb-shop-cat">
  <h2 class="rb-shop-cat__heading">{{ section.settings.heading }}</h2>

  <div class="rb-shop-cat__carousel" data-shop-cat-carousel>
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="rb-shop-cat__arrow rb-shop-cat__arrow--prev" data-shop-cat-prev aria-label="Previous category">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="rb-shop-cat__arrow rb-shop-cat__arrow--next" data-shop-cat-next aria-label="Next category">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    {%- endif -%}

    <div class="rb-shop-cat__card">
      <div class="rb-shop-cat__track" data-shop-cat-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <div class="rb-shop-cat__slide{% if forloop.first %} is-active{% endif %}" data-shop-cat-slide {{ block.shopify_attributes }}>
              <div class="rb-shop-cat__text">
                <h3 class="rb-shop-cat__name">{{ block.settings.name }}</h3>
                {%- if block.settings.blurb != blank -%}
                  <p class="rb-shop-cat__blurb">{{ block.settings.blurb }}</p>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="rb-shop-cat__view-all">
                    <span class="rb-shop-cat__view-all-text">View all {{ block.settings.name }}</span>
                  </a>
                {%- endif -%}
              </div>
              <div class="rb-shop-cat__stage">
              {%- if block.settings.image_left != blank and block.settings.image_center != blank and block.settings.image_right != blank -%}
                <img class="rb-shop-cat__can rb-shop-cat__can--left" src="{{ block.settings.image_left | image_url: width: 500 }}" alt="" loading="lazy">
                <img class="rb-shop-cat__can rb-shop-cat__can--center" src="{{ block.settings.image_center | image_url: width: 600 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                <img class="rb-shop-cat__can rb-shop-cat__can--right" src="{{ block.settings.image_right | image_url: width: 500 }}" alt="" loading="lazy">
              {%- elsif block.settings.image != blank -%}
                <img class="rb-shop-cat__image" src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{{ 'shop-by-category.js' | asset_url | script_tag }}

