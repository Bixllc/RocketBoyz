<style>
  .rb-cl-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 32px 80px;
  }

  /* Hero */
  .rb-cl-hero {
    margin-bottom: 28px;
  }

  .rb-cl-hero__title {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    text-transform: uppercase;
    color: #030213;
    line-height: 0.92;
    margin: 0 0 8px;
  }

  .rb-cl-hero__count {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #71717A;
  }

  /* Category nav pills */
  .rb-cl-cats {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .rb-cl-cat-pill {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #27272A;
    background: #ffffff;
    border: 1.5px solid #E4E4E7;
    border-radius: 999px;
    padding: 8px 18px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .rb-cl-cat-pill:hover {
    border-color: #2D6A2F;
    color: #2D6A2F;
  }

  .rb-cl-cat-pill.is-active {
    background: #2D6A2F;
    border-color: #2D6A2F;
    color: #ffffff;
    font-weight: 600;
  }

  /* Toolbar */
  .rb-cl-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid #E4E4E7;
    border-bottom: 1px solid #E4E4E7;
    padding: 12px 0;
    margin-bottom: 28px;
  }

  .rb-cl-toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rb-cl-toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Search within collection */
  .rb-cl-search {
    position: relative;
  }

  .rb-cl-search input {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    border: 1px solid #E4E4E7;
    border-radius: 999px;
    padding: 8px 16px 8px 36px;
    outline: none;
    color: #030213;
    background: #ffffff;
    width: 220px;
    transition: border-color 0.15s;
  }

  .rb-cl-search input:focus {
    border-color: #2D6A2F;
  }

  .rb-cl-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #71717A;
    pointer-events: none;
  }

  /* Sort dropdown */
  .rb-cl-sort {
    position: relative;
  }

  .rb-cl-sort select {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #030213;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    padding: 8px 32px 8px 12px;
    background: #ffffff;
    cursor: pointer;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .rb-cl-sort-chevron {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #71717A;
  }

  /* Product count */
  .rb-cl-count-label {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    color: #71717A;
    white-space: nowrap;
  }

  /* Desktop density */
  .rb-cl-density {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .rb-cl-density-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background 0.15s;
  }

  .rb-cl-density-btn.is-active,
  .rb-cl-density-btn:hover {
    background: #f4f4f5;
    border-color: #E4E4E7;
  }

  .rb-cl-density-btn span {
    display: block;
    width: 3px;
    height: 14px;
    border-radius: 1px;
    background: #71717A;
  }

  .rb-cl-density-btn.is-active span {
    background: #030213;
  }

  /* Mobile toolbar */
  .rb-cl-mobile-toolbar {
    display: none;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #E4E4E7;
    border-bottom: 1px solid #E4E4E7;
    padding: 12px 0;
    margin-bottom: 20px;
  }

  .rb-cl-filter-btn {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #030213;
    background: #ffffff;
    border: 1.5px solid #E4E4E7;
    border-radius: 999px;
    padding: 9px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .rb-cl-filter-btn:hover { border-color: #030213; }

  .rb-cl-mobile-density {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .rb-cl-mobile-density .rb-cl-density-btn {
    width: 36px;
    height: 36px;
  }

  /* Grid */
  .rb-cl-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(var(--rb-cl-cols, 4), 1fr);
  }

  /* Pagination */
  .rb-cl-pagination {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 48px;
    flex-wrap: wrap;
  }

  .rb-cl-pagination a,
  .rb-cl-pagination span {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 500;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #E4E4E7;
    color: #030213;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .rb-cl-pagination a:hover {
    background: #f4f4f5;
    border-color: #030213;
  }

  .rb-cl-pagination .current,
  .rb-cl-pagination span.current {
    background: #2D6A2F;
    border-color: #2D6A2F;
    color: #ffffff;
  }

  /* Sort mobile drawer */
  .rb-cl-drawer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
  }

  .rb-cl-drawer.is-open {
    pointer-events: all;
  }

  .rb-cl-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .rb-cl-drawer.is-open .rb-cl-drawer__backdrop { opacity: 1; }

  .rb-cl-drawer__panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-radius: 20px 20px 0 0;
    padding: 24px 20px 36px;
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
    max-height: 85vh;
    overflow-y: auto;
  }

  .rb-cl-drawer.is-open .rb-cl-drawer__panel { transform: translateY(0); }

  .rb-cl-drawer__handle {
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: #E4E4E7;
    margin: 0 auto 20px;
  }

  .rb-cl-drawer__title {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #030213;
    margin: 0 0 20px;
  }

  .rb-cl-drawer-section { margin-bottom: 24px; }

  .rb-cl-drawer-section__head {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #71717A;
    margin-bottom: 12px;
  }

  .rb-cl-drawer-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rb-cl-drawer-pill {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 500;
    border: 1.5px solid #E4E4E7;
    border-radius: 999px;
    padding: 8px 16px;
    background: #ffffff;
    color: #030213;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .rb-cl-drawer-pill.is-active {
    background: #2D6A2F;
    border-color: #2D6A2F;
    color: #ffffff;
  }

  /* Responsive */
  @media (min-width: 901px) {
    .rb-cl-mobile-toolbar { display: none !important; }
  }

  @media (max-width: 900px) {
    .rb-cl-section { padding: 24px 16px 56px; }
    .rb-cl-toolbar { display: none; }
    .rb-cl-mobile-toolbar { display: flex; }
    .rb-cl-grid { grid-template-columns: repeat(var(--rb-cl-mobile-cols, 2), 1fr); gap: 12px; }
    /* Single horizontal, side-scrolling row on mobile */
    .rb-cl-cats {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      gap: 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-left: -16px;
      margin-right: -16px;
      padding: 0 16px 4px;
    }
    .rb-cl-cats::-webkit-scrollbar { display: none; }
    .rb-cl-cat-pill { font-size: 13px; padding: 7px 14px; flex-shrink: 0; }
  }

  @media (max-width: 480px) {
    .rb-cl-grid { gap: 10px; }
  }
</style>

{%- assign the_collection = section.settings.collection | default: collection -%}
{%- paginate the_collection.products by section.settings.products_per_page -%}

<div class="rb-cl-section">

  <!-- Hero -->
  <div class="rb-cl-hero">
    <h1 class="rb-cl-hero__title">{{ section.settings.heading | default: the_collection.title }}</h1>
    <p class="rb-cl-hero__count">{{ the_collection.products_count }} products</p>
  </div>

  {%- if section.blocks.size > 0 -%}
    <nav class="rb-cl-cats" aria-label="Shop by category">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category_link' -%}
          {%- liquid
            assign pill_url = block.settings.url
            if pill_url == blank and block.settings.handle != blank
              assign pill_url = '/collections/' | append: block.settings.handle
            endif
            assign is_active = false
            if block.settings.handle != blank and the_collection.handle == block.settings.handle
              assign is_active = true
            endif
          -%}
          <a href="{{ pill_url }}" class="rb-cl-cat-pill{% if is_active %} is-active{% endif %}"{{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}


  <!-- Desktop toolbar -->
  <div class="rb-cl-toolbar">
    <div class="rb-cl-toolbar-left">
      <span class="rb-cl-count-label">{{ the_collection.products_count }} products</span>

      <!-- Search within collection -->
      <div class="rb-cl-search">
        <svg class="rb-cl-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="text" placeholder="Search {{ the_collection.title | downcase }}..." data-rb-cl-search aria-label="Search products">
      </div>
    </div>

    <div class="rb-cl-toolbar-right">
      <!-- Sort -->
      <div class="rb-cl-sort">
        <select data-rb-cl-sort aria-label="Sort by">
          {%- assign sort_by = the_collection.sort_by | default: the_collection.default_sort_by -%}
          <option value="featured"{% if sort_by == 'featured' %} selected{% endif %}>Featured</option>
          <option value="best-selling"{% if sort_by == 'best-selling' %} selected{% endif %}>Best Selling</option>
          <option value="title-ascending"{% if sort_by == 'title-ascending' %} selected{% endif %}>A–Z</option>
          <option value="title-descending"{% if sort_by == 'title-descending' %} selected{% endif %}>Z–A</option>
          <option value="price-ascending"{% if sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
          <option value="price-descending"{% if sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
          <option value="created-descending"{% if sort_by == 'created-descending' %} selected{% endif %}>Newest</option>
        </select>
        <svg class="rb-cl-sort-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </div>

      <!-- Density -->
      <div class="rb-cl-density" data-rb-cl-density>
        <button type="button" class="rb-cl-density-btn" data-cols="3" aria-label="3 columns"><span></span><span></span><span></span></button>
        <button type="button" class="rb-cl-density-btn is-active" data-cols="4" aria-label="4 columns"><span></span><span></span><span></span><span></span></button>
        <button type="button" class="rb-cl-density-btn" data-cols="5" aria-label="5 columns"><span></span><span></span><span></span><span></span><span></span></button>
      </div>
    </div>
  </div>

  <!-- Mobile toolbar -->
  <div class="rb-cl-mobile-toolbar">
    <button type="button" class="rb-cl-filter-btn" data-rb-cl-open-drawer>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/>
      </svg>
      Filter &amp; Sort
    </button>
    <div class="rb-cl-mobile-density" data-rb-cl-mobile-density>
      <button type="button" class="rb-cl-density-btn" data-mobile-cols="1" aria-label="1 column"><span></span></button>
      <button type="button" class="rb-cl-density-btn is-active" data-mobile-cols="2" aria-label="2 columns"><span></span><span></span></button>
    </div>
  </div>

  <!-- Products grid -->
  <div class="rb-cl-grid" data-rb-cl-grid>
    {%- for product in the_collection.products -%}
      {% render 'rb-product-card', product: product %}
    {%- else -%}
      <p style="font-family:'Manrope',sans-serif; color:#71717A; grid-column:1/-1; padding:40px 0;">No products found.</p>
    {%- endfor -%}
  </div>

  <!-- Pagination -->
  {%- if paginate.pages > 1 -%}
    <div class="rb-cl-pagination">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" aria-label="Previous">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="current">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" aria-label="Next">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

</div>

<!-- Mobile Sort Drawer -->
<div class="rb-cl-drawer" id="rb-cl-drawer" aria-hidden="true">
  <div class="rb-cl-drawer__backdrop" data-rb-cl-close-drawer></div>
  <div class="rb-cl-drawer__panel">
    <div class="rb-cl-drawer__handle"></div>
    <p class="rb-cl-drawer__title">Sort by</p>
    <div class="rb-cl-drawer-section">
      <div class="rb-cl-drawer-pills" data-rb-cl-drawer-sort>
        <button type="button" class="rb-cl-drawer-pill is-active" data-sort="featured">Featured</button>
        <button type="button" class="rb-cl-drawer-pill" data-sort="best-selling">Best Selling</button>
        <button type="button" class="rb-cl-drawer-pill" data-sort="price-ascending">Price: Low–High</button>
        <button type="button" class="rb-cl-drawer-pill" data-sort="price-descending">Price: High–Low</button>
        <button type="button" class="rb-cl-drawer-pill" data-sort="created-descending">Newest</button>
      </div>
    </div>
  </div>
</div>

{%- endpaginate -%}

<script>
(function () {
  var grid = document.querySelector('[data-rb-cl-grid]');

  /* ── Desktop density ── */
  var densityWrap = document.querySelector('[data-rb-cl-density]');
  if (densityWrap) {
    densityWrap.querySelectorAll('[data-cols]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        densityWrap.querySelectorAll('[data-cols]').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        if (grid) grid.style.setProperty('--rb-cl-cols', btn.dataset.cols);
      });
    });
  }

  /* ── Mobile density ── */
  var mobileDensity = document.querySelector('[data-rb-cl-mobile-density]');
  if (mobileDensity) {
    mobileDensity.querySelectorAll('[data-mobile-cols]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        mobileDensity.querySelectorAll('[data-mobile-cols]').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        if (grid) grid.style.setProperty('--rb-cl-mobile-cols', btn.dataset.mobileCols);
      });
    });
  }

  /* ── Sort ── */
  var sortSelect = document.querySelector('[data-rb-cl-sort]');
  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sortSelect.value);
      window.location.href = url.toString();
    });
  }

  /* ── Client-side search filter ── */
  var searchInput = document.querySelector('[data-rb-cl-search]');
  if (searchInput && grid) {
    searchInput.addEventListener('input', function () {
      var q = searchInput.value.toLowerCase().trim();
      grid.querySelectorAll('.rb-product-card').forEach(function (card) {
        var title = (card.querySelector('.rb-product-card__title-link') || card).textContent.toLowerCase();
        card.style.display = !q || title.includes(q) ? '' : 'none';
      });
    });
  }

  /* ── Mobile drawer ── */
  var drawer = document.getElementById('rb-cl-drawer');
  var openBtn = document.querySelector('[data-rb-cl-open-drawer]');
  var closeBackdrop = document.querySelector('[data-rb-cl-close-drawer]');

  function openDrawer() {
    if (!drawer) return;
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBackdrop) closeBackdrop.addEventListener('click', closeDrawer);

  /* Drawer sort pills */
  var drawerSortWrap = document.querySelector('[data-rb-cl-drawer-sort]');
  if (drawerSortWrap) {
    drawerSortWrap.querySelectorAll('[data-sort]').forEach(function (pill) {
      pill.addEventListener('click', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', pill.dataset.sort);
        window.location.href = url.toString();
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "RB Collection Listing",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Only needed when this section is used on a Page template. On a real collection page, this can be left blank and the page's own collection is used automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the collection's own title"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 60,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category_link",
      "name": "Category pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Snacks"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Collection URL"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Collection handle (for active state)",
          "info": "e.g. snacks",
          "default": "snacks"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RB Collection Listing",
      "blocks": [
        { "type": "category_link", "settings": { "label": "Snacks", "handle": "snacks" } },
        { "type": "category_link", "settings": { "label": "Beverages", "handle": "beverages" } },
        { "type": "category_link", "settings": { "label": "Sweets", "handle": "sweets" } },
        { "type": "category_link", "settings": { "label": "Groceries", "handle": "groceries" } },
        { "type": "category_link", "settings": { "label": "Health+Beauty", "handle": "health-beauty" } },
        { "type": "category_link", "settings": { "label": "Household", "handle": "household" } }
      ]
    }
  ]
}
{% endschema %}
