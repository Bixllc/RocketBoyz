<style>
  .spice-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 88vh;
    background: {{ section.settings.background_color }};
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .spice-{{ section.id }} .spice__inner {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 34px 32px;
    display: grid;
    grid-template-columns: 0.96fr 1.04fr;
    gap: 30px;
    align-items: center;
  }

  .spice-{{ section.id }} .spice__head {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(58px, 6.8vw, 112px);
    line-height: 0.98;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0;
    will-change: transform, opacity;
  }

  .spice-{{ section.id }} .spice__head .spice__gradient-word {
    background: #2D6A2F;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .spice-{{ section.id }} .spice__sub {
    will-change: transform, opacity;
  }

  .spice-{{ section.id }} .spice__tag {
    font-family: 'Manrope', sans-serif;
    font-style: italic;
    font-size: 18px;
    color: #2D6A2F;
    margin: 22px 0 0;
  }

  .spice-{{ section.id }} .spice__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 32px;
    padding: 16px 28px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: #1b1a16;
    border: 1.5px solid rgba(27, 26, 22, 0.22);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .spice-{{ section.id }} .spice__btn:hover {
    background: #2D6A2F;
    color: #fff;
    border-color: transparent;
    transform: translateY(-2px);
  }

  .spice-{{ section.id }} .stage {
    position: relative;
    height: 560px;
  }

  .spice-{{ section.id }} .stage__glow {
    position: absolute;
    left: 50%;
    bottom: 8%;
    transform: translateX(-50%);
    width: 70%;
    height: 58%;
    border-radius: 50%;
    filter: blur(8px);
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 210, 120, 0.45), rgba(255, 210, 120, 0) 72%);
  }

  .spice-{{ section.id }} .bagGroup {
    position: absolute;
    right: -11%;
    bottom: -7%;
    width: 82%;
    aspect-ratio: 885 / 961;
    transform-origin: 52% 88%;
    transform: rotate({{ section.settings.bag_rotation }}deg);
    will-change: transform, opacity;
  }

  .spice-{{ section.id }} .food {
    position: absolute;
    left: 50%;
    top: {{ section.settings.food_top }}%;
    width: {{ section.settings.food_width }}%;
    transform: translateX(-50%);
    z-index: 2;
    will-change: transform, opacity;
  }

  .spice-{{ section.id }} .food img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 16px 16px rgba(31, 30, 24, 0.3));
  }

  .spice-{{ section.id }} .bag {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 3;
    will-change: transform, opacity;
    filter: drop-shadow(0 26px 30px rgba(31, 30, 24, 0.16)) contrast(1.12) saturate(1.08);
  }

  .spice-{{ section.id }} .bag-sheen {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.55) 0%,
      rgba(255, 255, 255, 0.12) 28%,
      rgba(255, 255, 255, 0) 48%,
      rgba(20, 20, 20, 0.05) 72%,
      rgba(20, 20, 20, 0.16) 100%);
    mix-blend-mode: overlay;
    -webkit-mask-image: var(--bag-mask);
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-image: var(--bag-mask);
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
  }

  .spice-{{ section.id }} .stage__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: rgba(27, 26, 22, 0.35);
    text-align: center;
    padding: 32px;
  }

  @media (max-width: 900px) {
    .spice-{{ section.id }} {
      min-height: auto;
    }

    /* Switch to flex column so we can reorder: heading → stage → sub+button */
    .spice-{{ section.id }} .spice__inner {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 48px 24px 40px;
      text-align: center;
    }

    /* Dissolve the text wrapper so heading and sub become direct flex children */
    .spice-{{ section.id }} .spice__text {
      display: contents;
    }

    /* Order: 1 — heading at top */
    .spice-{{ section.id }} .spice__head {
      order: 1;
      text-align: center;
      font-size: clamp(42px, 11vw, 72px);
    }

    /* Order: 3 — stage in the middle */
    .spice-{{ section.id }} .stage {
      order: 3;
      height: 360px;
      margin-top: 80px;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      overflow: visible;
    }

    .spice-{{ section.id }} .bagGroup {
      position: relative;
      width: 94%;
      height: 360px;
      flex-shrink: 0;
      transform-origin: 52% 88%;
      transform: rotate({{ section.settings.bag_rotation }}deg);
      margin: 0;
      bottom: auto;
      right: auto;
    }

    /* Order: 4 — tagline + button below the bag */
    .spice-{{ section.id }} .spice__sub {
      order: 4;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 8px;
    }

    .spice-{{ section.id }} .spice__tag {
      text-align: center;
      margin-top: 0;
      font-size: 16px;
    }

    .spice-{{ section.id }} .spice__btn {
      width: 100%;
      justify-content: center;
      margin-top: 16px;
    }
  }

  @media (max-width: 900px) {
    /* Force all animated elements visible on mobile — GSAP is skipped but belt-and-suspenders */
    .spice-{{ section.id }} .spice__head,
    .spice-{{ section.id }} .spice__sub,
    .spice-{{ section.id }} .bagGroup,
    .spice-{{ section.id }} .food,
    .spice-{{ section.id }} .bag {
      opacity: 1 !important;
      visibility: visible !important;
      display: block !important;
    }
    /* Restore flex on sub since we set display:block above */
    .spice-{{ section.id }} .spice__sub {
      display: flex !important;
    }
    /* Override any stale GSAP inline transform (e.g. when the page was first
       loaded wide, animated, then resized to mobile) so the food/bag always
       sit at their correct static mobile positions. */
    .spice-{{ section.id }} .food {
      transform: translateX(-50%) !important;
    }
    .spice-{{ section.id }} .bagGroup {
      transform: rotate({{ section.settings.bag_rotation }}deg) !important;
    }
    .spice-{{ section.id }} .spice__head,
    .spice-{{ section.id }} .spice__sub {
      transform: none !important;
    }
  }

  @media (max-width: 520px) {
    .spice-{{ section.id }} .spice__head {
      font-size: clamp(36px, 12vw, 56px);
    }

    .spice-{{ section.id }} .stage {
      height: 260px;
    }
  }
</style>

<section class="spice-{{ section.id }}">
  <div class="spice__inner">
    <div class="spice__text">
      <h2 class="spice__head" data-spice-head>
        {{ section.settings.headline_line1 | default: 'Introducing' }}<br>
        <span class="spice__gradient-word">{{ section.settings.headline_gradient_word | default: 'Rocket' }}</span>{{ section.settings.headline_line2 | default: ' Spice Bun' }}
      </h2>
      <div class="spice__sub" data-spice-sub>
        {%- if section.settings.tagline != blank -%}
          <p class="spice__tag">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <a class="spice__btn" href="{{ section.settings.button_url | default: '#' }}">
            {{ section.settings.button_text }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="stage">
      <div class="stage__glow"></div>
      {%- if section.settings.wrapper_image != blank -%}
        <div class="bagGroup" data-spice-bag>
          {%- if section.settings.food_image != blank -%}
            <div class="food" data-spice-food>
              <img
                src="{{ section.settings.food_image | image_url: width: 600 }}"
                width="{{ section.settings.food_image.width }}"
                height="{{ section.settings.food_image.height }}"
                alt="{{ section.settings.headline_line2 | default: 'Rocket Spice Bun' | escape }}"
                loading="eager"
              >
            </div>
          {%- endif -%}
          <img
            class="bag"
            src="{{ section.settings.wrapper_image | image_url: width: 900 }}"
            width="{{ section.settings.wrapper_image.width }}"
            height="{{ section.settings.wrapper_image.height }}"
            alt="{{ section.settings.headline_line2 | default: 'Rocket Spice Bun' | escape }} wrapper"
            loading="eager"
          >
          <div class="bag-sheen" style="--bag-mask: url('{{ section.settings.wrapper_image | image_url: width: 900 }}');"></div>
        </div>
      {%- else -%}
        <div class="stage__placeholder">Add a wrapper image and a bun + cheese image in the section settings</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'gsap.js' | asset_url }}" defer="defer"></script>
<script defer="defer">
  (function () {
    var gsapRetries = 0;
    function initSpiceReveal() {
      var root = document.querySelector('.spice-{{ section.id }}');
      if (!root) return;

      // Mobile (<=900px) is a static, centered layout and the CSS already forces
      // every element visible at its resting position. Running GSAP here left the
      // bag/food stuck at their animation "from" offset on first scroll (only
      // corrected after a reload once images were cached) — so skip it entirely.
      if (window.matchMedia('(max-width: 900px)').matches) return;

      // GSAP (deferred, separate <script src>) can occasionally still be mid-execution
      // when this runs, especially on slow mobile connections — retry briefly instead of
      // silently giving up, which left the bag/food in an unanimated, unrecovered position.
      if (typeof gsap === 'undefined') {
        if (gsapRetries < 40) {
          gsapRetries++;
          setTimeout(initSpiceReveal, 50);
        }
        return;
      }

      var head = root.querySelector('[data-spice-head]');
      var sub = root.querySelector('[data-spice-sub]');
      var bag = root.querySelector('[data-spice-bag]');
      var food = root.querySelector('[data-spice-food]');
      var restRotation = {{ section.settings.bag_rotation }};

      var tl = gsap.timeline({ paused: true, defaults: { ease: 'power3.out' } });

      if (head) {
        tl.from(head, { y: 70, opacity: 0, duration: 0.55 }, 0.05);
      }
      if (sub) {
        tl.from(sub, { y: 40, opacity: 0, duration: 0.55 }, 0.28);
      }
      if (bag) {
        // matches the "slideInUp" entrance: rise + fade, with a slight settle in rotation
        tl.fromTo(bag,
          { y: 60, rotation: restRotation - 6, opacity: 0 },
          { y: 0, rotation: restRotation, opacity: 1, duration: 0.7 }, 0.2);
      }
      if (food) {
        // food follows fast, slightly staggered after the bag (matches their "animated-fast" delay)
        tl.from(food, { y: 40, opacity: 0, duration: 0.5 }, 0.45);
      }

      tl.play();

      // Safety net: if the tab was backgrounded/throttled during load and the
      // animation's rAF ticks stalled, force it to its end state so the bag/food
      // never stay stuck at their offset "from" position.
      setTimeout(function () {
        if (tl.progress() < 1) tl.progress(1);
      }, 2500);
    }

    if (document.readyState === 'complete') {
      initSpiceReveal();
    } else {
      window.addEventListener('load', initSpiceReveal);
    }
  })();
</script>

{% schema %}
{
  "name": "Spice Bun Reveal",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f3f1ec"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline line 1",
      "default": "Introducing"
    },
    {
      "type": "text",
      "id": "headline_gradient_word",
      "label": "Gradient word",
      "default": "Rocket"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline line 2 (after gradient word)",
      "default": " Spice Bun"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "\"Squeeze me baby.\""
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Spice Bun"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "wrapper_image",
      "label": "Bag / wrapper image (transparent PNG)"
    },
    {
      "type": "image_picker",
      "id": "food_image",
      "label": "Bun + cheese image (transparent PNG)"
    },
    {
      "type": "range",
      "id": "food_width",
      "label": "Food image width (%)",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "food_top",
      "label": "Food image vertical offset (%)",
      "info": "Negative values move the food higher, so it pokes above the bag's opening",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": -8
    },
    {
      "type": "range",
      "id": "bag_rotation",
      "label": "Bag resting rotation (deg)",
      "min": -30,
      "max": 30,
      "step": 1,
      "default": -13
    }
  ],
  "presets": [
    {
      "name": "Spice Bun Reveal"
    }
  ]
}
{% endschema %}
