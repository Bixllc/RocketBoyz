{% comment %}
  Shop by Category carousel.
  Pills above the card switch the active category.
  4 product cards below auto-populate from each category's collection.
{% endcomment %}

{%- assign section_id = 'categories-carousel-' | append: section.id -%}

<section class="categories-carousel" id="{{ section_id }}">
  <div class="categories-carousel__container">

    <h2 class="categories-carousel__heading">Shop by category</h2>

    {%- if section.blocks.size > 0 -%}

      <!-- Pills -->
      <div class="categories-carousel__pills" role="tablist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            <button
              type="button"
              class="categories-carousel__pill{% if forloop.first %} is-active{% endif %}"
              data-cat-pill="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >{{ block.settings.name | default: 'Category' }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Block data for JS -->
      <script type="application/json" id="{{ section_id }}-data">
        [
          {%- for block in section.blocks -%}
            {
              "name": {{ block.settings.name | default: '' | json }},
              "blurb": {{ block.settings.blurb | default: '' | json }},
              "url": {{ block.settings.url | default: '' | json }},
              "layout": {{ block.settings.layout | default: 'single' | json }},
              "imagePosition": {{ block.settings.image_position | default: 'center' | json }},
              "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | json }}{% else %}null{% endif %},
              "fanCenter": {% if block.settings.fan_center_image != blank %}{{ block.settings.fan_center_image | image_url: width: 700 | json }}{% else %}null{% endif %},
              "fanLeft": {% if block.settings.fan_left_image != blank %}{{ block.settings.fan_left_image | image_url: width: 500 | json }}{% else %}null{% endif %},
              "fanRight": {% if block.settings.fan_right_image != blank %}{{ block.settings.fan_right_image | image_url: width: 500 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>

      <svg width="0" height="0" style="position:absolute;" aria-hidden="true">
        <defs>
          <linearGradient id="{{ section_id }}-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E63946"/>
            <stop offset="100%" stop-color="#FF9F1C"/>
          </linearGradient>
        </defs>
      </svg>

      <!-- Card -->
      <div class="categories-carousel__card" id="{{ section_id }}-card">
        <div class="categories-carousel__grid">
          <div class="categories-carousel__left">
            <div class="categories-carousel__left-inner" id="{{ section_id }}-left-inner">
              {%- assign first_block = section.blocks | first -%}
              <h3 class="categories-carousel__cat-name">{{ first_block.settings.name | default: 'Snacks' }}</h3>
              <p class="categories-carousel__blurb">{{ first_block.settings.blurb | default: '' }}</p>
              <a href="{{ first_block.settings.url | default: '#' }}" class="categories-carousel__shop-link" aria-label="View all {{ first_block.settings.name | default: 'category' }}">
                <span class="categories-carousel__shop-link-text">View all {{ first_block.settings.name | default: 'Snacks' }}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#{{ section_id }}-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
          <div class="categories-carousel__right" id="{{ section_id }}-image-panel"></div>
        </div>
      </div>

      <!-- Product panels — one per category, shown/hidden by JS -->
      <div class="categories-carousel__products-wrap">
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- assign cat_col = collections[block.settings.collection] -%}
            <div
              class="categories-carousel__product-panel{% if forloop.first %} is-active{% endif %}"
              data-cat-panel="{{ forloop.index0 }}"
            >
              {%- if cat_col != empty and cat_col.products_count > 0 -%}
                {%- for product in cat_col.products limit: 4 -%}
                  {%- render 'rb-product-card', product: product -%}
                {%- endfor -%}
              {%- else -%}
                <p class="categories-carousel__panel-empty">
                  {%- if block.settings.collection == blank -%}
                    Assign a collection to this category in the section settings to show products.
                  {%- else -%}
                    No products found in this collection.
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- else -%}
      <p class="categories-carousel__empty">Add category blocks in the theme editor to get started.</p>
    {%- endif -%}

  </div>
</section>

<style>
  .categories-carousel {
    background: #ffffff;
  }

  .categories-carousel__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 30px;
  }

  @media (max-width: 768px) {
    .categories-carousel__container { padding: 40px 20px 24px; }
  }

  /* ── Heading ── */
  .categories-carousel__heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 800;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 20px;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  /* ── Pills ── */
  .categories-carousel__pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .categories-carousel__pill {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1.5px solid #E4E4E7;
    background: #fff;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #52525B;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, transform 0.15s;
    white-space: nowrap;
  }

  .categories-carousel__pill:hover {
    border-color: #030213;
    color: #030213;
  }

  .categories-carousel__pill.is-active {
    background: #105020;
    border-color: transparent;
    color: #fff;
    transform: translateY(-1px);
  }

  /* ── Card ── */
  .categories-carousel__card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    border-radius: 26px;
    box-shadow: 0 24px 50px -34px rgba(20, 22, 18, 0.4);
    overflow: hidden;
    min-height: 430px;
  }

  .categories-carousel__grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    min-height: 430px;
  }

  @media (max-width: 768px) {
    .categories-carousel__grid {
      grid-template-columns: 1fr;
      min-height: unset;
    }
  }

  /* ── Left panel ── */
  .categories-carousel__left {
    display: flex;
    align-items: center;
    padding: 54px 14px 54px 56px;
  }

  @media (max-width: 768px) {
    .categories-carousel__left { padding: 32px 24px 16px; }
  }

  .categories-carousel__left-inner {
    display: flex;
    flex-direction: column;
    animation: rbCatFadeUp 0.45s ease;
  }

  .categories-carousel__cat-name {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 800;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 18px;
    line-height: 1.0;
    letter-spacing: -0.01em;
  }

  .categories-carousel__blurb {
    font-family: 'Manrope', sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #54514a;
    line-height: 1.6;
    margin: 0;
    max-width: 340px;
  }

  .categories-carousel__shop-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    font-family: 'Manrope', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    width: fit-content;
    padding-bottom: 7px;
    border-bottom: 2px solid transparent;
    border-image: #105020;
    border-image-slice: 1;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }

  .categories-carousel__shop-link:hover { gap: 16px; opacity: 0.85; }

  .categories-carousel__shop-link-text {
    background: #105020;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #E63946;
  }

  /* ── Right image panel ── */
  .categories-carousel__right {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 300px;
    background: #ffffff;
  }

  .categories-carousel__featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 36px;
    box-sizing: border-box;
    object-fit: contain;
    opacity: 0;
    animation: rbCatFadeUp 0.5s ease forwards;
  }

  .categories-carousel__featured-img--bottom {
    padding: 36px 36px 0;
    object-position: bottom;
  }

  .categories-carousel__image-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Beverage fan ── */
  .categories-carousel__fan { position: absolute; inset: 0; }

  .categories-carousel__fan-can {
    position: absolute;
    top: 50%;
    height: 76%;
    max-height: 340px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(0,0,0,0.2));
    opacity: 0;
  }

  .categories-carousel__fan-can--center {
    left: 50%;
    z-index: 3;
    transform: translate(-50%, -50%) scale(0.92);
    animation: rbFanCenter 0.5s ease forwards;
  }

  .categories-carousel__fan-can--left {
    left: 33%;
    z-index: 2;
    transform: translate(-50%, -50%) rotate(-9deg);
    animation: rbFanLeft 0.55s ease 0.08s forwards;
  }

  .categories-carousel__fan-can--right {
    left: 67%;
    z-index: 2;
    transform: translate(-50%, -50%) rotate(9deg);
    animation: rbFanRight 0.55s ease 0.08s forwards;
  }

  /* ── Product panels ── */
  .categories-carousel__products-wrap { margin-top: 32px; }

  .categories-carousel__product-panel {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    animation: rbCatFadeUp 0.35s ease both;
  }

  .categories-carousel__product-panel.is-active { display: grid; }

  .categories-carousel__panel-empty {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #71717A;
    text-align: center;
    padding: 32px 0;
    grid-column: 1 / -1;
  }

  /* ── Animations ── */
  @keyframes rbCatFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes rbFanCenter {
    from { opacity: 0; transform: translate(-50%, -38%) scale(0.85); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(0.92); }
  }

  @keyframes rbFanLeft {
    from { opacity: 0; transform: translate(-90%, -50%) rotate(-9deg); }
    to   { opacity: 1; transform: translate(-50%, -50%) rotate(-9deg); }
  }

  @keyframes rbFanRight {
    from { opacity: 0; transform: translate(-10%, -50%) rotate(9deg); }
    to   { opacity: 1; transform: translate(-50%, -50%) rotate(9deg); }
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .categories-carousel__pills { gap: 8px; }
    .categories-carousel__pill { padding: 8px 16px; font-size: 13px; }
    .categories-carousel__product-panel { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }

  .categories-carousel__empty {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    color: #54514a;
    text-align: center;
    padding: 40px 0;
  }
</style>

<script>
(function () {
  var sectionId  = {{ section_id | json }};
  var dataEl     = document.getElementById(sectionId + '-data');
  if (!dataEl) return;

  var blocks = [];
  try { blocks = JSON.parse(dataEl.textContent); } catch (e) { return; }
  if (!blocks.length) return;

  var leftInner  = document.getElementById(sectionId + '-left-inner');
  var imagePanel = document.getElementById(sectionId + '-image-panel');
  var gradId     = sectionId + '-grad';
  var pills      = document.querySelectorAll('[data-cat-pill]');
  var panels     = document.querySelectorAll('[data-cat-panel]');
  var index      = 0;

  function esc(str) {
    return (str || '').replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function renderLeft(block) {
    var name = block.name || '';
    leftInner.innerHTML =
      '<h3 class="categories-carousel__cat-name">' + esc(name) + '</h3>' +
      '<p class="categories-carousel__blurb">' + esc(block.blurb) + '</p>' +
      '<a href="' + (block.url || '#') + '" class="categories-carousel__shop-link">' +
        '<span class="categories-carousel__shop-link-text">View all ' + esc(name) + '</span>' +
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#' + gradId + ')" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
      '</a>';
    leftInner.style.animation = 'none';
    void leftInner.offsetWidth;
    leftInner.style.animation = '';
  }

  function renderRight(block) {
    var name = esc(block.name || 'category');
    if (block.layout === 'fan') {
      var c = block.fanCenter ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--center" src="' + block.fanCenter + '" alt="' + name + '">' : '';
      var l = block.fanLeft   ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--left" src="'   + block.fanLeft   + '" alt="">' : '';
      var r = block.fanRight  ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--right" src="'  + block.fanRight  + '" alt="">' : '';
      imagePanel.innerHTML = (c || l || r) ? '<div class="categories-carousel__fan">' + l + r + c + '</div>' : placeholder();
    } else if (block.image) {
      var cls = block.imagePosition === 'bottom' ? ' categories-carousel__featured-img--bottom' : '';
      imagePanel.innerHTML = '<img class="categories-carousel__featured-img' + cls + '" src="' + block.image + '" alt="' + name + '">';
    } else {
      imagePanel.innerHTML = placeholder();
    }
  }

  function placeholder() {
    return '<div class="categories-carousel__image-placeholder"><svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#c8c4bc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
  }

  function activate(newIndex) {
    index = ((newIndex % blocks.length) + blocks.length) % blocks.length;
    var block = blocks[index];
    if (!block) return;

    renderLeft(block);
    renderRight(block);

    pills.forEach(function (p) {
      var active = p.dataset.catPill === String(index);
      p.classList.toggle('is-active', active);
      p.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    panels.forEach(function (p) {
      p.classList.toggle('is-active', p.dataset.catPanel === String(index));
    });
  }

  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      activate(parseInt(this.dataset.catPill, 10));
    });
  });

  activate(0);
})();
</script>

{% schema %}
{
  "name": "Categories Carousel",
  "tag": "section",
  "class": "section-categories-carousel",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category Name",
          "default": "Snacks"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Description",
          "default": "The crisps, puffs, biscuits and bun that started it all. Island brands you grew up on."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Shop Link URL"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Products collection",
          "info": "4 products auto-populate below the card when this category is selected"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Image layout",
          "options": [
            { "value": "single", "label": "Single featured image" },
            { "value": "fan",    "label": "Three-can fan (beverages)" }
          ],
          "default": "single"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image (single layout)"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Featured image position",
          "options": [
            { "value": "center", "label": "Centered" },
            { "value": "bottom", "label": "Anchored to bottom" }
          ],
          "default": "center"
        },
        {
          "type": "image_picker",
          "id": "fan_center_image",
          "label": "Fan: center product image"
        },
        {
          "type": "image_picker",
          "id": "fan_left_image",
          "label": "Fan: left product image"
        },
        {
          "type": "image_picker",
          "id": "fan_right_image",
          "label": "Fan: right product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Carousel",
      "blocks": [
        { "type": "category", "settings": { "name": "Snacks",        "blurb": "The crisps, puffs, biscuits and bun that started it all. Island brands you grew up on." } },
        { "type": "category", "settings": { "name": "Beverages",     "blurb": "Sorrel, mauby, Malta — drinks that taste like home, shipped cold-ready.", "layout": "fan" } },
        { "type": "category", "settings": { "name": "Sweets",        "blurb": "Tamarind balls, sugar cakes, and every sticky thing your nan made." } },
        { "type": "category", "settings": { "name": "Grocery",       "blurb": "Staples from back home: Grace products, Walkerswood, Encona and more." } },
        { "type": "category", "settings": { "name": "Health+Beauty", "blurb": "Natural oils, soaps, and wellness picks from across the islands." } },
        { "type": "category", "settings": { "name": "Household",     "blurb": "Caribbean-made cleaning and home goods, built for the yard." } }
      ]
    }
  ]
}
{% endschema %}
