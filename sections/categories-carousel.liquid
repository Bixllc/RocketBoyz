{% comment %}
  Shop by Category carousel.
  One white card per category; arrows advance/rewind (wraps), swipe on touch.
  Beverage-type categories show a 3-can fan; others show a single featured image.
{% endcomment %}

{%- assign section_id = 'categories-carousel-' | append: section.id -%}

<section class="categories-carousel" id="{{ section_id }}">
  <div class="categories-carousel__container">

    <h2 class="categories-carousel__heading">Shop by category</h2>

    {%- if section.blocks.size > 0 -%}
      {%- assign first_block = section.blocks | first -%}

      <script type="application/json" id="{{ section_id }}-data">
        [
          {%- for block in section.blocks -%}
            {
              "name": {{ block.settings.name | default: '' | json }},
              "blurb": {{ block.settings.blurb | default: '' | json }},
              "url": {{ block.settings.url | default: '' | json }},
              "layout": {{ block.settings.layout | default: 'single' | json }},
              "imagePosition": {{ block.settings.image_position | default: 'center' | json }},
              "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | json }}{% else %}null{% endif %},
              "fanCenter": {% if block.settings.fan_center_image != blank %}{{ block.settings.fan_center_image | image_url: width: 700 | json }}{% else %}null{% endif %},
              "fanLeft": {% if block.settings.fan_left_image != blank %}{{ block.settings.fan_left_image | image_url: width: 500 | json }}{% else %}null{% endif %},
              "fanRight": {% if block.settings.fan_right_image != blank %}{{ block.settings.fan_right_image | image_url: width: 500 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>

      <svg width="0" height="0" style="position:absolute;" aria-hidden="true">
        <defs>
          <linearGradient id="{{ section_id }}-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E63946"/>
            <stop offset="100%" stop-color="#FF9F1C"/>
          </linearGradient>
        </defs>
      </svg>

      <div class="categories-carousel__card" id="{{ section_id }}-card">
        <div class="categories-carousel__grid">

          <div class="categories-carousel__left">
            <div class="categories-carousel__left-inner" id="{{ section_id }}-left-inner">
              <h3 class="categories-carousel__cat-name">{{- first_block.settings.name | default: 'Snacks' -}}</h3>
              <p class="categories-carousel__blurb">{{- first_block.settings.blurb | default: '' -}}</p>
              <a href="{{ first_block.settings.url | default: '#' }}" class="categories-carousel__shop-link" aria-label="View all {{ first_block.settings.name | default: 'category' }}">
                <span class="categories-carousel__shop-link-text">View all {{ first_block.settings.name | default: 'Snacks' }}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#{{ section_id }}-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="categories-carousel__shop-link-arrow">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="categories-carousel__right" id="{{ section_id }}-image-panel"></div>

        </div>

        <button type="button" class="categories-carousel__nav categories-carousel__nav--prev" id="{{ section_id }}-prev" aria-label="Previous category">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="categories-carousel__nav categories-carousel__nav--next" id="{{ section_id }}-next" aria-label="Next category">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>

    {%- else -%}
      <p class="categories-carousel__empty">Add category blocks in the theme editor to get started.</p>
    {%- endif -%}

  </div>
</section>

<style>
  .categories-carousel {
    background: #ffffff;
  }

  .categories-carousel__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 30px;
  }

  @media (max-width: 768px) {
    .categories-carousel__container {
      padding: 40px 20px 24px;
    }
  }

  /* ---- Heading ---- */
  .categories-carousel__heading {
    font-family: 'Anton', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 400;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 32px;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  /* ---- Card ---- */
  .categories-carousel__card {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(27, 26, 22, 0.1);
    border-radius: 26px;
    box-shadow: 0 24px 50px -34px rgba(20, 22, 18, 0.4);
    overflow: hidden;
    min-height: 430px;
  }

  /* ---- Grid ---- */
  .categories-carousel__grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    min-height: 430px;
  }

  @media (max-width: 768px) {
    .categories-carousel__grid {
      grid-template-columns: 1fr;
      min-height: unset;
    }
  }

  /* ---- Left panel ---- */
  .categories-carousel__left {
    display: flex;
    align-items: center;
    padding: 54px 14px 54px 56px;
  }

  @media (max-width: 768px) {
    .categories-carousel__left {
      padding: 32px 24px 16px;
    }
  }

  .categories-carousel__left-inner {
    display: flex;
    flex-direction: column;
    animation: rbCatFadeUp 0.45s ease;
  }

  .categories-carousel__cat-name {
    font-family: 'Anton', sans-serif;
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 400;
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0 0 18px;
    line-height: 1.0;
    letter-spacing: -0.01em;
  }

  .categories-carousel__blurb {
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #54514a;
    line-height: 1.6;
    margin: 0;
    max-width: 340px;
  }

  /* ---- Shop link ---- */
  .categories-carousel__shop-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    width: fit-content;
    padding-bottom: 7px;
    border-bottom: 2px solid transparent;
    border-image: linear-gradient(90deg, #E63946, #FF9F1C);
    border-image-slice: 1;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }

  .categories-carousel__shop-link:hover {
    gap: 16px;
    opacity: 0.85;
  }

  .categories-carousel__shop-link-text {
    background: linear-gradient(90deg, #E63946, #FF9F1C);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #E63946;
  }

  .categories-carousel__shop-link-arrow {
    flex-shrink: 0;
    stroke: url(#{{ section_id }}-grad);
  }

  /* ---- Right panel (imagery) ---- */
  .categories-carousel__right {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 300px;
    background: #ffffff;
  }

  .categories-carousel__featured-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 36px;
    box-sizing: border-box;
    object-fit: contain;
    opacity: 0;
    animation: rbCatFadeUp 0.5s ease forwards;
  }

  @media (max-width: 768px) {
    .categories-carousel__featured-img {
      padding: 20px;
    }
  }

  /* Anchored to the bottom edge — looks like it's rising out of the card */
  .categories-carousel__featured-img--bottom {
    padding: 36px 36px 0;
    object-position: bottom;
  }

  @media (max-width: 768px) {
    .categories-carousel__featured-img--bottom {
      padding: 20px 20px 0;
    }
  }

  .categories-carousel__image-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---- Beverage fan ---- */
  .categories-carousel__fan {
    position: absolute;
    inset: 0;
  }

  .categories-carousel__fan-can {
    position: absolute;
    top: 50%;
    height: 76%;
    max-height: 340px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.2));
    opacity: 0;
  }

  .categories-carousel__fan-can--center {
    left: 50%;
    z-index: 3;
    transform: translate(-50%, -50%) scale(0.92);
    animation: rbFanCenter 0.5s ease forwards;
  }

  .categories-carousel__fan-can--left {
    left: 33%;
    z-index: 2;
    transform: translate(-50%, -50%) rotate(-9deg);
    animation: rbFanLeft 0.55s ease 0.08s forwards;
  }

  .categories-carousel__fan-can--right {
    left: 67%;
    z-index: 2;
    transform: translate(-50%, -50%) rotate(9deg);
    animation: rbFanRight 0.55s ease 0.08s forwards;
  }

  @keyframes rbCatFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes rbFanCenter {
    from { opacity: 0; transform: translate(-50%, -38%) scale(0.85); }
    to   { opacity: 1; transform: translate(-50%, -50%) scale(0.92); }
  }

  @keyframes rbFanLeft {
    from { opacity: 0; transform: translate(-90%, -50%) rotate(-9deg); }
    to   { opacity: 1; transform: translate(-50%, -50%) rotate(-9deg); }
  }

  @keyframes rbFanRight {
    from { opacity: 0; transform: translate(-10%, -50%) rotate(9deg); }
    to   { opacity: 1; transform: translate(-50%, -50%) rotate(9deg); }
  }

  /* ---- Prev / next controls ---- */
  .categories-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #1b1a16;
    cursor: pointer;
    z-index: 5;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .categories-carousel__nav:hover {
    background: #1b1a16;
    color: #ffffff;
  }

  .categories-carousel__nav--prev { left: 8px; }
  .categories-carousel__nav--next { right: 8px; }

  @media (max-width: 768px) {
    .categories-carousel__nav {
      width: 36px;
      height: 36px;
    }
    .categories-carousel__nav--prev { left: 6px; }
    .categories-carousel__nav--next { right: 6px; }
  }

  /* ---- Empty state ---- */
  .categories-carousel__empty {
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 15px;
    color: #54514a;
    text-align: center;
    padding: 40px 0;
  }
</style>

<script>
  (function () {
    var sectionId = {{ section_id | json }};
    var dataEl = document.getElementById(sectionId + '-data');
    if (!dataEl) return;

    var blocks = [];
    try {
      blocks = JSON.parse(dataEl.textContent);
    } catch (e) {
      console.warn('[categories-carousel] Could not parse block data', e);
      return;
    }
    if (!blocks.length) return;

    var leftInner  = document.getElementById(sectionId + '-left-inner');
    var imagePanel = document.getElementById(sectionId + '-image-panel');
    var prevBtn    = document.getElementById(sectionId + '-prev');
    var nextBtn    = document.getElementById(sectionId + '-next');
    var card       = document.getElementById(sectionId + '-card');
    var gradId     = sectionId + '-grad';

    function escapeHtml(str) {
      return (str || '').replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderLeft(block) {
      var name = block.name || '';
      leftInner.innerHTML =
        '<h3 class="categories-carousel__cat-name">' + escapeHtml(name) + '</h3>' +
        '<p class="categories-carousel__blurb">' + escapeHtml(block.blurb) + '</p>' +
        '<a href="' + (block.url || '#') + '" class="categories-carousel__shop-link" aria-label="View all ' + escapeHtml(name) + '">' +
          '<span class="categories-carousel__shop-link-text">View all ' + escapeHtml(name) + '</span>' +
          '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="url(#' + gradId + ')" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="categories-carousel__shop-link-arrow">' +
            '<path d="M5 12h14M12 5l7 7-7 7"/>' +
          '</svg>' +
        '</a>';

      // Force the fadeUp animation to replay
      leftInner.style.animation = 'none';
      void leftInner.offsetWidth;
      leftInner.style.animation = '';
    }

    function renderRight(block) {
      var name = escapeHtml(block.name || 'category');

      if (block.layout === 'fan') {
        var center = block.fanCenter
          ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--center" src="' + block.fanCenter + '" alt="' + name + '">'
          : '';
        var left = block.fanLeft
          ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--left" src="' + block.fanLeft + '" alt="">'
          : '';
        var right = block.fanRight
          ? '<img class="categories-carousel__fan-can categories-carousel__fan-can--right" src="' + block.fanRight + '" alt="">'
          : '';

        if (!center && !left && !right) {
          imagePanel.innerHTML = '<div class="categories-carousel__image-placeholder">' + placeholderSvg() + '</div>';
        } else {
          imagePanel.innerHTML = '<div class="categories-carousel__fan">' + left + right + center + '</div>';
        }
      } else if (block.image) {
        var posClass = block.imagePosition === 'bottom' ? ' categories-carousel__featured-img--bottom' : '';
        imagePanel.innerHTML = '<img class="categories-carousel__featured-img' + posClass + '" src="' + block.image + '" alt="' + name + '">';
      } else {
        imagePanel.innerHTML = '<div class="categories-carousel__image-placeholder">' + placeholderSvg() + '</div>';
      }
    }

    function placeholderSvg() {
      return '<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#c8c4bc" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' +
        '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>';
    }

    var index = 0;

    function activate(newIndex) {
      index = ((newIndex % blocks.length) + blocks.length) % blocks.length;
      var block = blocks[index];
      if (!block) return;
      renderLeft(block);
      renderRight(block);
    }

    prevBtn.addEventListener('click', function () { activate(index - 1); });
    nextBtn.addEventListener('click', function () { activate(index + 1); });

    // Touch swipe
    var touchStartX = null;
    card.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    card.addEventListener('touchend', function (e) {
      if (touchStartX === null) return;
      var deltaX = e.changedTouches[0].clientX - touchStartX;
      var threshold = 40;
      if (deltaX > threshold) {
        activate(index - 1);
      } else if (deltaX < -threshold) {
        activate(index + 1);
      }
      touchStartX = null;
    }, { passive: true });

    activate(0);
  })();
</script>

{% schema %}
{
  "name": "Categories Carousel",
  "tag": "section",
  "class": "section-categories-carousel",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Category Name",
          "default": "Snacks"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Description",
          "default": "The crisps, puffs, biscuits and bun that started it all. Island brands you grew up on."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Shop Link URL"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Image layout",
          "options": [
            { "value": "single", "label": "Single featured image" },
            { "value": "fan", "label": "Three-can fan (beverages)" }
          ],
          "default": "single"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image (single layout)"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Featured image position",
          "options": [
            { "value": "center", "label": "Centered" },
            { "value": "bottom", "label": "Anchored to bottom (rising out of card)" }
          ],
          "default": "center"
        },
        {
          "type": "image_picker",
          "id": "fan_center_image",
          "label": "Fan: center product image"
        },
        {
          "type": "image_picker",
          "id": "fan_left_image",
          "label": "Fan: left product image"
        },
        {
          "type": "image_picker",
          "id": "fan_right_image",
          "label": "Fan: right product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories Carousel",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "name": "Snacks",
            "blurb": "The crisps, puffs, biscuits and bun that started it all. Island brands you grew up on."
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Beverages",
            "blurb": "Sorrel, mauby, Malta — drinks that taste like home, shipped cold-ready.",
            "layout": "fan"
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Sweets",
            "blurb": "Tamarind balls, sugar cakes, and every sticky thing your nan made."
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Grocery",
            "blurb": "Staples from back home: Grace products, Walkerswood, Encona and more."
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Health+Beauty",
            "blurb": "Natural oils, soaps, and wellness picks from across the islands."
          }
        },
        {
          "type": "category",
          "settings": {
            "name": "Household",
            "blurb": "Caribbean-made cleaning and home goods, built for the yard."
          }
        }
      ]
    }
  ]
}
{% endschema %}
