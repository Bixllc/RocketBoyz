{%- liquid
  if section.settings.product_handle != blank
    assign product = all_products[section.settings.product_handle]
  endif
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'rb-pdp-form-' | append: section.id
  assign first_col = product.collections.first
-%}

<style>
/* ── RB PDP ────────────────────────────────────────────────── */
.rb-pdp {
  font-family: 'Clash Display', sans-serif;
  color: #030213;
  background: #fff;
  padding: 48px 0 80px;
}
.rb-pdp__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 32px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

/* ── Gallery ─────────────────────────────────────────────── */
.rb-pdp__gallery { position: sticky; top: 100px; }

.rb-pdp__img-main-wrap {
  position: relative;
  background: #fff;
  border: 1px solid #E4E4E7;
  border-radius: 24px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rb-pdp__img-main {
  width: 82%;
  height: 82%;
  object-fit: contain;
  transition: transform 0.4s ease;
}
.rb-pdp__img-main-wrap:hover .rb-pdp__img-main { transform: scale(1.03); }

.rb-pdp__heart {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  border: 1px solid #E4E4E7;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
  z-index: 2;
}
.rb-pdp__heart:hover { transform: scale(1.1); }
.rb-pdp__heart svg path { fill: none; stroke: #71717A; transition: fill 0.2s, stroke 0.2s; }
/* Matches the product-card heart: green gradient on hover and when saved */
.rb-pdp__heart:hover svg path,
.rb-pdp__heart.is-wished svg path {
  fill: url(#rb-heart-gradient);
  stroke: url(#rb-heart-gradient);
}

.rb-pdp__thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 12px;
}
.rb-pdp__thumb {
  aspect-ratio: 1 / 1;
  border-radius: 14px;
  overflow: hidden;
  border: 2px solid #E4E4E7;
  background: #fff;
  cursor: pointer;
  padding: 0;
  transition: border-color 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rb-pdp__thumb img { width: 80%; height: 80%; object-fit: contain; }
.rb-pdp__thumb.is-active { border-color: #030213; }

/* ── Details ──────────────────────────────────────────────── */
.rb-pdp__details { padding-top: 4px; }

.rb-pdp__eyebrow {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #DC2626;
  margin: 0 0 10px;
}
.rb-pdp__title {
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.02em;
  margin: 0 0 14px;
  background: #2D6A2F;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.rb-pdp__price {
  font-size: 34px;
  font-weight: 700;
  color: #030213;
  letter-spacing: -0.02em;
  margin-bottom: 16px;
  line-height: 1;
}
.rb-pdp__price .was { font-size: 18px; color: #A1A1AA; text-decoration: line-through; margin-left: 8px; font-weight: 500; }

.rb-pdp__desc { font-size: 15px; line-height: 1.65; color: #52525B; margin-bottom: 22px; }

.rb-pdp__divider { border: none; border-top: 1px solid #E4E4E7; margin: 0 0 22px; }

/* ── Option groups ────────────────────────────────────────── */
.rb-pdp__option-group { margin-bottom: 20px; }

.rb-pdp__option-label {
  font-size: 13px;
  font-weight: 700;
  color: #030213;
  margin: 0 0 10px;
  display: flex;
  align-items: baseline;
  gap: 5px;
}
.rb-pdp__option-label .val { color: #71717A; font-weight: 500; }

.rb-pdp__pills { display: flex; flex-wrap: wrap; gap: 8px; }

.rb-pdp__pill {
  font-family: 'Clash Display', sans-serif;
  font-size: 13px;
  font-weight: 700;
  padding: 9px 18px;
  border-radius: 12px;
  border: 1.5px solid #E4E4E7;
  background: #fff;
  color: #030213;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
  white-space: nowrap;
  line-height: 1;
}
.rb-pdp__pill:hover:not(.is-active):not(.is-soldout) { border-color: #030213; }
.rb-pdp__pill.is-active {
  background: #2D6A2F;
  border-color: transparent;
  color: #fff;
}
.rb-pdp__pill.is-soldout { opacity: 0.35; text-decoration: line-through; cursor: not-allowed; }

/* ── Quantity stepper ─────────────────────────────────────── */
.rb-pdp__qty-row { margin-bottom: 22px; }

.rb-pdp__qty {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid #E4E4E7;
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
  height: 48px;
}
.rb-pdp__qty-btn {
  width: 48px;
  height: 100%;
  background: none;
  border: none;
  font-size: 20px;
  font-weight: 400;
  color: #030213;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
  font-family: 'Clash Display', sans-serif;
  flex-shrink: 0;
}
.rb-pdp__qty-btn:hover { background: #F4F4F5; }
.rb-pdp__qty-val {
  width: 44px;
  text-align: center;
  font-family: 'Clash Display', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #030213;
  user-select: none;
  border-left: 1px solid #E4E4E7;
  border-right: 1px solid #E4E4E7;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── ATC ──────────────────────────────────────────────────── */
.rb-pdp__atc {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 32px;
  border-radius: 999px;
  border: none;
  background: #2D6A2F;
  color: #fff;
  font-family: 'Clash Display', sans-serif;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  margin-bottom: 16px;
}
.rb-pdp__atc:hover { opacity: 0.92; transform: translateY(-1px); }
.rb-pdp__atc:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.rb-pdp__atc.is-soldout {
  background: transparent;
  color: #030213;
  border: 1.5px solid #030213;
  opacity: 1;
  cursor: not-allowed;
}
.rb-pdp__atc.is-soldout:hover { opacity: 1; transform: none; }
.rb-pdp__atc.is-added { background: linear-gradient(90deg, #1f8a3a, #22c55e); }

/* ── Dynamic checkout (Shop Pay etc.) ────────────────────── */
.rb-pdp__dynamic-checkout { margin-bottom: 16px; }
.rb-pdp__dynamic-checkout .shopify-payment-button__button {
  border-radius: 999px !important;
  font-family: 'Clash Display', sans-serif !important;
  font-weight: 700 !important;
  min-height: 52px !important;
}
.rb-pdp__dynamic-checkout .shopify-payment-button__button--unbranded {
  background: #030213 !important;
  color: #fff !important;
}

/* ── Pickup ───────────────────────────────────────────────── */
.rb-pdp__pickup {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: #fbfaf7;
  border: 1px solid #E4E4E7;
  border-radius: 16px;
  padding: 16px;
}
.rb-pdp__pickup-check {
  width: 22px; height: 22px;
  border-radius: 50%;
  background: #1f8a3a;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 1px;
}
.rb-pdp__pickup-check svg { width: 12px; height: 12px; }
.rb-pdp__pickup-text strong { display: block; font-size: 13px; font-weight: 700; color: #030213; margin-bottom: 2px; }
.rb-pdp__pickup-text span { font-size: 12px; color: #52525B; }

/* ── Recommendations ──────────────────────────────────────── */
.rb-pdp__recs {
  max-width: 1280px;
  margin: 64px auto 0;
  padding: 0 32px;
  border-top: 1px solid #E4E4E7;
  padding-top: 48px;
}
.rb-pdp__recs-heading {
  font-size: clamp(20px, 3vw, 30px);
  font-weight: 700;
  color: #030213;
  margin: 0 0 24px;
  letter-spacing: -0.01em;
}
.rb-pdp__recs-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

/* ── Mobile ───────────────────────────────────────────────── */
@media (max-width: 768px) {
  .rb-pdp { padding: 24px 0 48px; }
  .rb-pdp__inner { grid-template-columns: 1fr; gap: 24px; padding: 0 16px; }
  .rb-pdp__gallery { position: static; }
  .rb-pdp__title { font-size: 26px; }
  .rb-pdp__price { font-size: 26px; }
  .rb-pdp__recs {
    margin: 32px 0 0;
    padding: 24px 16px 0;
    border-top: 1px solid #E4E4E7;
  }
  .rb-pdp__recs-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
}

/* ── Sticky add-to-cart bar ── */
.rb-stickycart {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 9400;
  background: #fff; border-top: 1px solid #E4E4E7;
  box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
  transform: translateY(110%); transition: transform 0.28s ease;
  padding: 10px 0; will-change: transform;
}
.rb-stickycart.is-visible { transform: translateY(0); }
.rb-stickycart__inner {
  max-width: 1280px; margin: 0 auto; padding: 0 20px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.rb-stickycart__product { display: flex; align-items: center; gap: 12px; min-width: 0; }
.rb-stickycart__thumb {
  width: 52px; height: 52px; border-radius: 10px; object-fit: contain;
  background: #fff; border: 1px solid #E4E4E7; flex-shrink: 0;
}
.rb-stickycart__meta { min-width: 0; }
.rb-stickycart__title {
  font-family: 'Hanken Grotesk', sans-serif; font-size: 14px; font-weight: 700; color: #1b1a16;
  margin: 0 0 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 42vw;
}
.rb-stickycart__price { font-family: 'Hanken Grotesk', sans-serif; font-size: 14px; font-weight: 700; color: #1b1a16; margin: 0; }
.rb-stickycart__btn {
  flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  background: #2D6A2F; color: #fff; border: none; border-radius: 999px;
  padding: 13px 30px; font-family: 'Manrope', sans-serif; font-size: 15px; font-weight: 700;
  cursor: pointer; transition: opacity 0.15s; min-width: 200px;
}
.rb-stickycart__btn:hover { opacity: 0.88; }
.rb-stickycart__btn:disabled { opacity: 0.5; cursor: not-allowed; }
.rb-stickycart__btn.is-added { background: linear-gradient(90deg, #1f8a3a, #22c55e); }
.rb-stickycart__btn svg { flex-shrink: 0; fill: none !important; }
/* Sold out — outline style (matches product cards / PDP), never greyed */
.rb-stickycart__btn.is-soldout,
.rb-stickycart__btn.is-soldout:disabled {
  background: transparent; color: #030213; border: 1.5px solid #030213;
  opacity: 1; cursor: not-allowed;
}
@media (max-width: 600px) {
  .rb-stickycart__title { max-width: 34vw; }
  .rb-stickycart__btn { padding: 12px 22px; font-size: 14px; min-width: 150px; }
  .rb-stickycart__thumb { width: 44px; height: 44px; }
}

/* Lift the Shopify Inbox chat bubble above the sticky bar so it never covers
   the Add to Cart button while the bar is visible. */
body.rb-sticky-open #shopify-chat,
body.rb-sticky-open #ShopifyChat,
body.rb-sticky-open inbox-online-store-chat,
body.rb-sticky-open shopify-chat {
  bottom: 92px !important;
  transition: bottom 0.28s ease;
}
</style>

<div class="rb-pdp" data-section-id="{{ section.id }}">
  <div class="rb-pdp__inner">

    <!-- LEFT: Gallery -->
    {%- liquid
      # Snack Box uses a fixed brand image on both its dedicated page and its
      # product page (the product's own featured image is out of date). This
      # overrides only the display; update the product image in admin to make
      # it propagate to cards/cart too.
      assign is_snackbox = false
      assign main_img_src = product.featured_image | image_url: width: 800
      assign main_img_alt = product.featured_image.alt | default: product.title
      if product.handle == 'snack-box-pay-what-you-want'
        assign is_snackbox = true
        assign main_img_src = 'https://shoprocketboyz.com/cdn/shop/files/snackbox_1.png?width=900'
        assign main_img_alt = product.title
      endif
    -%}
    <div class="rb-pdp__gallery">
      <div class="rb-pdp__img-main-wrap">
        <button class="rb-pdp__heart rb-btn-wish" type="button" aria-label="Add to wishlist" aria-pressed="false" data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
        {%- if main_img_src != blank -%}
          <img id="rb-pdp-main-img" src="{{ main_img_src }}" alt="{{ main_img_alt | escape }}" class="rb-pdp__img-main" width="800">
        {%- else -%}
          <svg width="100" height="100" viewBox="0 0 80 80" fill="none"><rect x="20" y="16" width="40" height="40" rx="4" stroke="#C4C4C4" stroke-width="2"/><circle cx="33" cy="29" r="4" stroke="#C4C4C4" stroke-width="2"/><path d="M20 46l12-10 8 8 6-5 14 11" stroke="#C4C4C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 and is_snackbox == false -%}
        <div class="rb-pdp__thumbs">
          {%- for image in product.images limit: 4 -%}
            <button class="rb-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pdp-thumb="{{ image | image_url: width: 800 }}" type="button">
              <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- RIGHT: Details -->
    <div class="rb-pdp__details">

      {%- liquid
        assign hide_eb = section.settings.hide_eyebrow
        # Keep the Snack Box consistent across its dedicated page and its
        # product page (both render this section with the same product).
        if product.handle == 'snack-box-pay-what-you-want'
          assign hide_eb = true
        endif
      -%}
      {%- unless hide_eb -%}
        {%- if product.type != blank -%}
          <p class="rb-pdp__eyebrow">{{ product.type }}</p>
        {%- elsif product.vendor != blank -%}
          <p class="rb-pdp__eyebrow">{{ product.vendor }}</p>
        {%- endif -%}
      {%- endunless -%}

      <h1 class="rb-pdp__title">{{ product.title }}</h1>

      <div class="rb-pdp__price" id="rb-pdp-price">
        {{ current_variant.price | money }}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="was">{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="rb-pdp__desc">{{ product.description | strip_html | truncate: 200 }}</div>
      {%- endif -%}

      <hr class="rb-pdp__divider">

      {%- form 'product', product, id: form_id, class: 'rb-pdp__form' -%}
        <input type="hidden" name="id" id="rb-pdp-variant-id" value="{{ current_variant.id }}">
        <input type="hidden" name="quantity" id="rb-pdp-qty-hidden" value="1">

        <!-- Variant pills -->
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="rb-pdp__option-group">
              <p class="rb-pdp__option-label">
                {{ option.name }}:&nbsp;<span class="val" data-option-val="{{ forloop.index0 }}">{{ option.selected_value }}</span>
              </p>
              <div class="rb-pdp__pills" data-opt-group="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <button type="button"
                    class="rb-pdp__pill{% if option.selected_value == value %} is-active{% endif %}"
                    data-opt-i="{{ forloop.parentloop.index0 }}"
                    data-opt-v="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <!-- Quantity -->
        <div class="rb-pdp__qty-row">
          <p class="rb-pdp__option-label">Quantity:</p>
          <div class="rb-pdp__qty">
            <button type="button" class="rb-pdp__qty-btn" data-delta="-1" aria-label="Decrease">−</button>
            <div class="rb-pdp__qty-val" id="rb-pdp-qty-display">1</div>
            <button type="button" class="rb-pdp__qty-btn" data-delta="1" aria-label="Increase">+</button>
          </div>
        </div>

        <!-- ATC -->
        <button type="submit" class="rb-pdp__atc" id="rb-pdp-atc">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path fill="none" d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line fill="none" x1="3" y1="6" x2="21" y2="6"/>
            <path fill="none" d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span id="rb-pdp-atc-label">Add to Cart · <span id="rb-pdp-atc-price">{{ current_variant.price | money }}</span></span>
        </button>

        <!-- Dynamic checkout (Buy with Shop Pay etc.) -->
        <div class="rb-pdp__dynamic-checkout">
          {{ form | payment_button }}
        </div>

      {%- endform -%}

      <div class="rb-pdp__pickup">
        <div class="rb-pdp__pickup-check">
          <svg viewBox="0 0 12 12" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6l3 3 5-5"/></svg>
        </div>
        <div class="rb-pdp__pickup-text">
          <strong>Pickup available at Rocket HQ</strong>
          <span>Usually ready in 24 hours</span>
        </div>
      </div>

    </div>
  </div>

  <!-- You might also like -->
  {%- if first_col != blank -%}
    {%- assign shown = 0 -%}
    {%- assign has_recs = false -%}
    {%- for rec in first_col.products -%}
      {%- if rec.id != product.id and shown < 4 -%}{%- assign has_recs = true -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_recs -%}
      <div class="rb-pdp__recs">
        <h2 class="rb-pdp__recs-heading">You might also like</h2>
        <div class="rb-pdp__recs-grid">
          {%- assign shown = 0 -%}
          {%- for rec in first_col.products -%}
            {%- if rec.id != product.id and shown < 4 -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- render 'rb-product-card', product: rec -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{%- unless section.settings.show_sticky_atc == false -%}
<div class="rb-stickycart" id="rb-stickycart" aria-hidden="true">
  <div class="rb-stickycart__inner">
    <div class="rb-stickycart__product">
      <img class="rb-stickycart__thumb" id="rb-stickycart-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="52" height="52" loading="lazy">
      <div class="rb-stickycart__meta">
        <p class="rb-stickycart__title">{{ product.title }}</p>
        <p class="rb-stickycart__price" id="rb-stickycart-price">{{ current_variant.price | money }}</p>
      </div>
    </div>
    <button type="button" class="rb-stickycart__btn" id="rb-stickycart-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path fill="none" d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line fill="none" x1="3" y1="6" x2="21" y2="6"/>
        <path fill="none" d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span id="rb-stickycart-btn-label">Add to Cart</span>
    </button>
  </div>
</div>
{%- endunless -%}

<script>
(function () {
  /* Pre-rendered variant data — prices already formatted by Liquid */
  var variants = [
    {%- for v in product.variants -%}
    {
      id: {{ v.id }},
      price_money: {{ v.price | money | json }},
      price_cents: {{ v.price }},
      compare_money: {{ v.compare_at_price | money | json }},
      has_compare: {{ v.compare_at_price | json }} > {{ v.price | json }} ? true : false,
      available: {{ v.available | json }},
      o1: {{ v.option1 | json }},
      o2: {{ v.option2 | json }},
      o3: {{ v.option3 | json }},
      img: {{ v.featured_image.src | default: '' | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  var numOpts = {{ product.options.size }};
  var qty = 1;
  var RB_LOCK_MAIN_IMG = {{ is_snackbox | default: false | json }};

  var selected = [
    {%- for opt in product.options_with_values -%}
      {{ opt.selected_value | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  function findVariant() {
    return variants.find(function (v) {
      if (selected[0] != null && v.o1 !== selected[0]) return false;
      if (numOpts > 1 && selected[1] != null && v.o2 !== selected[1]) return false;
      if (numOpts > 2 && selected[2] != null && v.o3 !== selected[2]) return false;
      return true;
    });
  }

  function formatTotal(cents, q) {
    /* Use Shopify.formatMoney if the theme exposes it, else build from unit money string */
    if (window.Shopify && typeof Shopify.formatMoney === 'function' && window.theme && window.theme.moneyFormat) {
      return Shopify.formatMoney(cents * q, window.theme.moneyFormat);
    }
    /* Safe fallback: dollar symbol + simple division */
    var symbol = (window.Shopify && Shopify.currency && Shopify.currency.active) ? '' : '$';
    return symbol + (cents * q / 100).toFixed(2);
  }

  function updateUI() {
    var v = findVariant();
    if (!v) return;

    /* Variant hidden input */
    document.getElementById('rb-pdp-variant-id').value = v.id;

    /* Price display */
    var priceEl = document.getElementById('rb-pdp-price');
    var html = v.price_money;
    if (v.has_compare) html += '<span class="was">' + v.compare_money + '</span>';
    priceEl.innerHTML = html;

    /* ATC availability */
    var atcBtn = document.getElementById('rb-pdp-atc');
    var atcLabelEl = document.getElementById('rb-pdp-atc-label');
    var dynamicCheckout = document.querySelector('.rb-pdp__dynamic-checkout');
    atcBtn.disabled = !v.available;
    atcBtn.classList.toggle('is-soldout', !v.available);
    if (atcLabelEl) {
      atcLabelEl.innerHTML = v.available
        ? 'Add to Cart · <span id="rb-pdp-atc-price">' + formatTotal(v.price_cents, qty) + '</span>'
        : 'Sold out';
    }
    if (dynamicCheckout) dynamicCheckout.style.display = v.available ? '' : 'none';

    /* Swap main image if variant has one (locked for the Snack Box override) */
    if (v.img && !RB_LOCK_MAIN_IMG) {
      var mainImg = document.getElementById('rb-pdp-main-img');
      if (mainImg) mainImg.src = v.img;
    }

    /* Sold-out pill states */
    document.querySelectorAll('.rb-pdp__pill').forEach(function (pill) {
      var i = parseInt(pill.dataset.optI);
      var val = pill.dataset.optV;
      var test = selected.slice();
      test[i] = val;
      var avail = variants.some(function (vv) {
        if (test[0] != null && vv.o1 !== test[0]) return false;
        if (numOpts > 1 && test[1] != null && vv.o2 !== test[1]) return false;
        if (numOpts > 2 && test[2] != null && vv.o3 !== test[2]) return false;
        return vv.available;
      });
      pill.classList.toggle('is-soldout', !avail);
    });
  }

  /* Pill clicks */
  document.querySelectorAll('.rb-pdp__pill').forEach(function (pill) {
    pill.addEventListener('click', function () {
      if (pill.classList.contains('is-soldout')) return;
      var i = parseInt(pill.dataset.optI);
      selected[i] = pill.dataset.optV;

      document.querySelectorAll('.rb-pdp__pill[data-opt-i="' + i + '"]').forEach(function (p) {
        p.classList.toggle('is-active', p.dataset.optV === selected[i]);
      });

      var valDisplay = document.querySelector('[data-option-val="' + i + '"]');
      if (valDisplay) valDisplay.textContent = selected[i];

      updateUI();
    });
  });

  /* Quantity stepper */
  var qtyDisplay = document.getElementById('rb-pdp-qty-display');
  var qtyHidden  = document.getElementById('rb-pdp-qty-hidden');
  document.querySelectorAll('.rb-pdp__qty-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      qty = Math.max(1, qty + parseInt(btn.dataset.delta));
      qtyDisplay.textContent = qty;
      qtyHidden.value = qty;
      var v = findVariant();
      if (v) {
        var atcPrice = document.getElementById('rb-pdp-atc-price');
        if (atcPrice) atcPrice.textContent = formatTotal(v.price_cents, qty);
      }
    });
  });

  /* Thumbnails */
  document.querySelectorAll('[data-pdp-thumb]').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      document.querySelectorAll('[data-pdp-thumb]').forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
      var img = document.getElementById('rb-pdp-main-img');
      if (img) img.src = thumb.dataset.pdpThumb;
    });
  });

  /* Heart / wishlist is handled globally by rb-wishlist.js (RBWishlist) via the
     shared .rb-btn-wish delegation — same behavior as the product cards. */

  /* AJAX Add to Cart */
  var form   = document.getElementById('{{ form_id }}');
  var atcBtn = document.getElementById('rb-pdp-atc');
  var atcLabel = document.getElementById('rb-pdp-atc-label');

  if (form && atcBtn) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (atcBtn.disabled) return;
      atcBtn.disabled = true;
      var originalHTML = atcLabel.innerHTML;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString()
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        atcBtn.classList.add('is-added');
        atcLabel.innerHTML = 'Added to cart ✓';

        /* Re-sync RBCart from Shopify, then open the drawer as the "added"
           confirmation — matching what product-card adds already do.
           Previously this kept its own `rb_cart` counter and dispatched on
           `window`, but every listener is bound to `document`, so those events
           reached nothing and the drawer never opened from the PDP. */
        if (window.RBCart) {
          window.RBCart.openDrawer(); window.RBCart.fetchCart();
        }

        setTimeout(function () {
          atcBtn.classList.remove('is-added');
          atcLabel.innerHTML = originalHTML;
          atcBtn.disabled = false;
        }, 1300);
      })
      .catch(function () { form.submit(); });
    });
  }

  /* Sticky add-to-cart bar */
  (function () {
    var bar = document.getElementById('rb-stickycart');
    if (!bar || !atcBtn || !form) return;
    var sBtn   = document.getElementById('rb-stickycart-btn');
    var sLabel = document.getElementById('rb-stickycart-btn-label');
    var sPrice = document.getElementById('rb-stickycart-price');
    var sImg   = document.getElementById('rb-stickycart-img');

    // Mirror the main ATC's price / image / sold-out state onto the sticky bar.
    function sync() {
      if (sBtn.classList.contains('is-added')) return; // don't clobber "Added ✓"
      var p = document.getElementById('rb-pdp-atc-price');
      if (p && sPrice) sPrice.textContent = p.textContent;
      var main = document.getElementById('rb-pdp-main-img');
      if (main && sImg && main.src) sImg.src = main.src;
      if (atcBtn.classList.contains('is-soldout')) {
        sLabel.textContent = 'Sold out';
        sBtn.classList.add('is-soldout');
      } else {
        sBtn.classList.remove('is-soldout');
        sLabel.textContent = 'Add to Cart';
      }
    }
    var mo = new MutationObserver(sync);
    mo.observe(atcBtn, { attributes: true, childList: true, subtree: true });
    sync();

    // Reveal the bar once the main ATC button has scrolled up out of view.
    // Also lift the chat bubble (body class) so it never covers the button.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          var show = !en.isIntersecting && en.boundingClientRect.top < 0;
          bar.classList.toggle('is-visible', show);
          document.body.classList.toggle('rb-sticky-open', show);
        });
      }, { threshold: 0 });
      io.observe(atcBtn);
    }

    // Sticky button adds to cart directly (instant feedback, no proxy delay).
    sBtn.addEventListener('click', function () {
      if (sBtn.classList.contains('is-soldout') || sBtn.classList.contains('is-added')) return;
      var vid = document.getElementById('rb-pdp-variant-id').value;
      var q   = parseInt(document.getElementById('rb-pdp-qty-hidden').value, 10) || 1;
      sBtn.classList.add('is-added');
      sLabel.textContent = 'Added ✓';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: vid, quantity: q })
      })
      .then(function () {
        /* fetchCart() emits 'rb-cart' on document itself, so no manual dispatch
           is needed — the previous window dispatch had no listeners. */
        if (window.RBCart) {
          window.RBCart.openDrawer(); window.RBCart.fetchCart();
        }
      })
      .catch(function () {});
      setTimeout(function () { sBtn.classList.remove('is-added'); sync(); }, 1300);
    });
  })();

  /* Initial state */
  updateUI();
})();
</script>

{%- comment -%}
  Recently-viewed tracking. Feeds the homepage "Recommended for you" section,
  which seeds Shopify's recommendation engine with the most recent id.
  Storage: localStorage `rb_recent` — newest-first array of product ids, max 10.
{%- endcomment -%}
{%- if product != blank -%}
<script>
  (function () {
    var id = {{ product.id | json }};
    if (!id) return;
    try {
      var list = JSON.parse(localStorage.getItem('rb_recent') || '[]');
      if (!Array.isArray(list)) list = [];
      list = list.filter(function (x) { return x !== id; });
      list.unshift(id);
      localStorage.setItem('rb_recent', JSON.stringify(list.slice(0, 10)));
    } catch (e) {
      /* private mode / quota — recommendations just fall back to best sellers */
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "RB Product Detail",
  "tag": "section",
  "class": "rb-pdp-section",
  "settings": [
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle override",
      "info": "Only needed when this section is used on a Page template. On a real product page, leave blank to use the page's own product automatically."
    },
    {
      "type": "checkbox",
      "id": "hide_eyebrow",
      "label": "Hide the category/vendor label above the title",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky Add to Cart bar on scroll",
      "default": true
    }
  ]
}
{% endschema %}
