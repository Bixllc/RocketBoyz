<style>
  .sbp {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }

  .sbp__img-wrap {
    border-radius: 24px;
    overflow: hidden;
    background: #f3f0e9;
    aspect-ratio: 1 / 1;
    position: sticky;
    top: 100px;
  }

  .sbp__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sbp__img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: rgba(27,26,22,0.35);
  }

  .sbp__title {
    font-family: 'Clash Display', sans-serif;
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    color: #030213;
    margin: 0 0 8px;
    line-height: 1.05;
  }

  .sbp__subtitle {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    color: #52525B;
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .sbp__price {
    font-family: 'Clash Display', sans-serif;
    font-size: 40px;
    font-weight: 700;
    color: #030213;
    margin: 0 0 20px;
  }

  .sbp__divider {
    border: none;
    border-top: 1px solid #E4E4E7;
    margin: 0 0 24px;
  }

  .sbp__field-label {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #030213;
    margin: 0 0 12px;
  }

  .sbp__field-label span {
    font-weight: 400;
    color: #52525B;
  }

  .sbp__variants {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 24px;
  }

  .sbp__var-btn {
    padding: 11px 22px;
    border: 1.5px solid #E4E4E7;
    border-radius: 999px;
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #030213;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, opacity 0.15s;
  }

  .sbp__var-btn.is-active {
    border-color: #030213;
    background: #030213;
    color: #fff;
  }

  .sbp__var-btn:hover:not(.is-active):not(:disabled) {
    border-color: #030213;
  }

  .sbp__var-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .sbp__qty-row {
    display: flex;
    align-items: center;
    border: 1.5px solid #E4E4E7;
    border-radius: 999px;
    width: fit-content;
    margin: 0 0 20px;
    overflow: hidden;
  }

  .sbp__qty-btn {
    width: 48px;
    height: 48px;
    border: none;
    background: none;
    font-size: 22px;
    cursor: pointer;
    color: #030213;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .sbp__qty-btn:hover { color: #DC2626; }

  .sbp__qty-val {
    width: 52px;
    text-align: center;
    border-left: 1px solid #E4E4E7;
    border-right: 1px solid #E4E4E7;
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #030213;
    height: 48px;
    line-height: 48px;
    user-select: none;
  }

  .sbp__options-heading {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #030213;
    margin: 4px 0 14px;
  }

  .sbp__plan-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border: 1.5px solid #E4E4E7;
    border-radius: 16px;
    cursor: pointer;
    margin: 0 0 10px;
    transition: border-color 0.15s, background 0.15s;
    user-select: none;
  }

  .sbp__plan-card.is-selected {
    border-color: #030213;
    background: #fafafa;
  }

  .sbp__plan-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sbp__radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #D4D4D8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.15s;
  }

  .is-selected .sbp__radio { border-color: #030213; }

  .sbp__radio::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #030213;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .is-selected .sbp__radio::after { opacity: 1; }

  .sbp__plan-name {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #030213;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sbp__badge {
    background: #DC2626;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
  }

  .sbp__plan-price {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #030213;
    white-space: nowrap;
  }

  .sbp .rb-btn-atc {
    margin-top: 24px;
    padding: 17px 24px;
    font-size: 16px;
  }

  .sbp__missing {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    color: #71717A;
    padding: 40px 0;
    grid-column: 1 / -1;
  }

  @media (max-width: 768px) {
    .sbp {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px 16px 64px;
    }

    .sbp__img-wrap {
      position: static;
      aspect-ratio: 4 / 3;
    }

    .sbp__title { font-size: clamp(30px, 9vw, 44px); }
    .sbp__price { font-size: 32px; }
  }
</style>

{%- assign product = all_products[section.settings.product_handle] -%}

<div class="sbp" data-sbp-root>

  {%- if product == blank -%}
    <p class="sbp__missing">
      No product found for handle "{{ section.settings.product_handle }}". Check the handle in the section settings, or that the product exists and is published.
    </p>
  {%- else -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}

    <!-- Left: image -->
    <div class="sbp__img-wrap">
      {%- assign display_image = section.settings.image | default: product.featured_image -%}
      {%- if display_image != blank -%}
        <img
          id="sbp-img"
          src="{{ display_image | image_url: width: 1000 }}"
          alt="{{ product.title | escape }}"
          loading="eager"
        >
      {%- else -%}
        <div class="sbp__img-placeholder">No product image</div>
      {%- endif -%}
    </div>

    <!-- Right: details -->
    <div class="sbp__details">

      <h1 class="sbp__title">{{ product.title }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="sbp__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <p class="sbp__price" id="sbp-price">{{ current_variant.price | money }}</p>

      <hr class="sbp__divider">

      <!-- Variants (real, from the product's Size option) -->
      {%- if product.variants.size > 1 -%}
        <p class="sbp__field-label">
          Size: <span id="sbp-size-val">{{ current_variant.title }}</span>
        </p>
        <div class="sbp__variants">
          {%- for variant in product.variants -%}
            <button
              type="button"
              class="sbp__var-btn{% if variant.id == current_variant.id %} is-active{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-variant-title="{{ variant.title | escape }}"
              data-variant-price="{{ variant.price }}"
              data-variant-available="{{ variant.available }}"
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}{% unless variant.available %} (Sold out){% endunless %}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Quantity -->
      <p class="sbp__field-label">Quantity:</p>
      <div class="sbp__qty-row">
        <button type="button" class="sbp__qty-btn" data-sbp-qty="-1" aria-label="Decrease">−</button>
        <div class="sbp__qty-val" id="sbp-qty">1</div>
        <button type="button" class="sbp__qty-btn" data-sbp-qty="1" aria-label="Increase">+</button>
      </div>

      <hr class="sbp__divider">

      <!-- Purchase options -->
      {%- assign sub_plan = blank -%}
      {%- assign sub_group = product.selling_plan_groups.first -%}
      {%- if sub_group != blank -%}
        {%- for plan in sub_group.selling_plans -%}
          {%- assign adjustment = plan.price_adjustments.first -%}
          {%- if adjustment.value_type == 'percentage' and adjustment.value == 10 -%}
            {%- assign sub_plan = plan -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if sub_plan == blank -%}
          {%- assign sub_plan = sub_group.selling_plans.first -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign sub_discount = sub_plan.price_adjustments.first.value | default: 0 -%}
      {%- assign sub_multiplier = 100 | minus: sub_discount -%}
      {%- assign sub_price_cents = current_variant.price | times: sub_multiplier | divided_by: 100 -%}

      <p class="sbp__options-heading">Purchase options</p>

      <div class="sbp__plan-card is-selected" data-sbp-plan="onetime" data-selling-plan-id="" role="button" tabindex="0">
        <div class="sbp__plan-left">
          <div class="sbp__radio"></div>
          <span class="sbp__plan-name">One-time purchase</span>
        </div>
        <span class="sbp__plan-price" id="sbp-onetime-price">{{ current_variant.price | money }}</span>
      </div>

      {%- if sub_plan != blank -%}
        <div class="sbp__plan-card" data-sbp-plan="sub" data-selling-plan-id="{{ sub_plan.id }}" data-discount="{{ sub_discount }}" role="button" tabindex="0">
          <div class="sbp__plan-left">
            <div class="sbp__radio"></div>
            <span class="sbp__plan-name">
              {{ product.title }} Subscribe &amp; save
              <span class="sbp__badge">Save {{ sub_discount }}%</span>
            </span>
          </div>
          <span class="sbp__plan-price" id="sbp-sub-price">{{ sub_price_cents | money }}</span>
        </div>
      {%- endif -%}

      <!-- Add to cart -->
      <button type="button" class="rb-btn-atc" id="sbp-atc-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path fill="none" d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line fill="none" x1="3" y1="6" x2="21" y2="6"/>
          <path fill="none" d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span id="sbp-atc-label">{% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
      </button>

    </div>
  {%- endif -%}
</div>

<script>
(function () {
  var root = document.querySelector('[data-sbp-root]');
  if (!root) return;

  function money(cents) {
    try {
      return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD' });
    } catch (e) {
      return '$' + (cents / 100).toFixed(2);
    }
  }

  var currentVariantId = null;
  var currentVariantPrice = 0;
  var currentVariantAvailable = true;

  /* Variant buttons (real variants) */
  var varBtns = root.querySelectorAll('[data-variant-id]');
  var sizeVal = root.querySelector('#sbp-size-val');
  var priceEl = root.querySelector('#sbp-price');
  var onetimePriceEl = root.querySelector('#sbp-onetime-price');
  var subPriceEl = root.querySelector('#sbp-sub-price');
  var subCard = root.querySelector('[data-sbp-plan="sub"]');
  var atcLabel = root.querySelector('#sbp-atc-label');
  var atcBtn = root.querySelector('#sbp-atc-btn');

  function updatePrices() {
    if (priceEl) priceEl.textContent = money(currentVariantPrice);
    if (onetimePriceEl) onetimePriceEl.textContent = money(currentVariantPrice);
    if (subPriceEl && subCard) {
      var discount = parseFloat(subCard.dataset.discount || '0');
      var adjusted = Math.round(currentVariantPrice * (1 - discount / 100));
      subPriceEl.textContent = money(adjusted);
    }
    if (atcLabel) atcLabel.textContent = currentVariantAvailable ? 'Add to cart' : 'Sold out';
    if (atcBtn) atcBtn.disabled = !currentVariantAvailable;
  }

  varBtns.forEach(function (btn) {
    if (btn.classList.contains('is-active')) {
      currentVariantId = btn.dataset.variantId;
      currentVariantPrice = Math.round(parseFloat(btn.dataset.variantPrice) * 100);
      currentVariantAvailable = btn.dataset.variantAvailable === 'true';
    }
    btn.addEventListener('click', function () {
      if (this.disabled) return;
      varBtns.forEach(function (b) { b.classList.remove('is-active'); });
      this.classList.add('is-active');
      currentVariantId = this.dataset.variantId;
      currentVariantPrice = Math.round(parseFloat(this.dataset.variantPrice) * 100);
      currentVariantAvailable = this.dataset.variantAvailable === 'true';
      if (sizeVal) sizeVal.textContent = this.dataset.variantTitle;
      updatePrices();
    });
  });

  // Single-variant products have no pills above, so read the initial variant
  // straight off the one-time purchase card / page render if not set by a pill.
  if (currentVariantId === null) {
    var onetimeCard = root.querySelector('[data-sbp-plan="onetime"]');
    if (onetimeCard && onetimePriceEl) {
      // Price text was server-rendered already; just trust availability from the ATC button state.
      currentVariantAvailable = atcLabel ? atcLabel.textContent.indexOf('Sold out') === -1 : true;
    }
  }

  /* Quantity stepper */
  var qtyEl = root.querySelector('#sbp-qty');
  root.querySelectorAll('[data-sbp-qty]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var current = parseInt(qtyEl.textContent || '1', 10);
      var next = Math.max(1, current + parseInt(this.dataset.sbpQty, 10));
      qtyEl.textContent = next;
    });
  });

  /* Purchase option cards */
  var planCards = root.querySelectorAll('.sbp__plan-card');
  var selectedPlan = 'onetime';
  planCards.forEach(function (card) {
    card.addEventListener('click', function () {
      planCards.forEach(function (c) { c.classList.remove('is-selected'); });
      this.classList.add('is-selected');
      selectedPlan = this.dataset.sbpPlan;
    });
  });

  /* Add to cart (real AJAX) */
  if (atcBtn) {
    atcBtn.addEventListener('click', function () {
      if (atcBtn.disabled || !currentVariantId) return;
      var qty = parseInt(qtyEl ? qtyEl.textContent : '1', 10) || 1;
      var selectedCard = root.querySelector('.sbp__plan-card.is-selected');
      var sellingPlanId = selectedCard ? selectedCard.dataset.sellingPlanId : '';

      var item = { id: parseInt(currentVariantId, 10), quantity: qty };
      if (sellingPlanId) item.selling_plan = parseInt(sellingPlanId, 10);

      var originalLabel = atcLabel ? atcLabel.textContent : '';
      atcBtn.disabled = true;
      if (atcLabel) atcLabel.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [item] })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.status) {
            // Shopify error response (e.g. sold out, invalid selling plan)
            if (atcLabel) atcLabel.textContent = originalLabel;
            atcBtn.disabled = false;
            return;
          }
          if (atcLabel) atcLabel.textContent = 'Added ✓';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          setTimeout(function () {
            if (atcLabel) atcLabel.textContent = originalLabel;
            atcBtn.disabled = false;
          }, 2000);
        })
        .catch(function () {
          if (atcLabel) atcLabel.textContent = originalLabel;
          atcBtn.disabled = false;
        });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Snack Box Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle",
      "info": "The real Shopify product this page pulls from",
      "default": "snack-box-pay-what-you-want"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override (optional)",
      "info": "Leave blank to use the product's own featured image"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle / tagline",
      "default": "Hand-packed island snacks, curated and shipped monthly."
    }
  ],
  "presets": [{ "name": "Snack Box Product" }]
}
{% endschema %}
