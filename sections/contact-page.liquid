<style>
  .contact-page-section {
    background: #fff;
    padding: 80px 32px 96px;
  }

  .contact-page-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Left */
  .contact-page-eyebrow {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #DC2626;
    margin: 0 0 16px;
    display: block;
  }

  .contact-page-heading {
    font-family: 'Manrope', sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 4vw, 60px);
    text-transform: uppercase;
    color: #030213;
    line-height: 1.0;
    margin: 0 0 20px;
  }

  .contact-page-desc {
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    line-height: 1.65;
    color: #52525B;
    margin: 0 0 40px;
  }

  .contact-info-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-info-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .contact-info-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #2D6A2F;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .contact-info-item:hover .contact-info-icon {
    transform: scale(1.05);
  }

  .contact-info-icon svg {
    width: 20px !important;
    height: 20px !important;
    fill: none !important;
    stroke: #ffffff !important;
    stroke-width: 1.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-info-label {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #71717A;
    margin: 0 0 2px;
  }

  .contact-info-value {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #030213;
    margin: 0;
    text-decoration: none;
  }

  a.contact-info-value:hover { color: #DC2626; }

  /* Right: form */
  .contact-form-card {
    background: #F5F2ED;
    border-radius: 20px;
    padding: 40px;
  }

  .contact-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .contact-form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .contact-form-field:last-child { margin-bottom: 0; }

  .contact-form-label {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #030213;
  }

  .contact-form-input,
  .contact-form-select,
  .contact-form-textarea {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    color: #030213;
    background: #fff;
    border: 1px solid #E4E4E7;
    border-radius: 10px;
    padding: 13px 16px;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
  }

  .contact-form-input::placeholder,
  .contact-form-textarea::placeholder { color: #A1A1AA; }

  .contact-form-input:focus,
  .contact-form-select:focus,
  .contact-form-textarea:focus { border-color: #030213; }

  .contact-form-select-wrap {
    position: relative;
  }

  .contact-form-select-wrap svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 16px !important;
    height: 16px !important;
    fill: none !important;
    stroke: #71717A !important;
    stroke-width: 2px;
  }

  .contact-form-textarea {
    min-height: 140px;
    resize: vertical;
  }

  .contact-form-submit {
    font-family: 'Manrope', sans-serif;
    width: 100%;
    padding: 16px;
    background: transparent;
    color: #030213;
    border: 1.5px solid #030213;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    transition: background 0.2s, color 0.2s;
  }

  .contact-form-submit:hover {
    background: #030213;
    color: #fff;
  }

  .contact-form-success {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    color: #1f8a3a;
    background: #f0faf4;
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  @media (max-width: 900px) {
    .contact-page-inner { grid-template-columns: 1fr; gap: 48px; }
    .contact-page-section { padding: 56px 20px 64px; }
  }

  @media (max-width: 560px) {
    .contact-form-row { grid-template-columns: 1fr; }
    .contact-form-card { padding: 28px 20px; }
  }
</style>

<section class="contact-page-section">
  <div class="contact-page-inner">

    <!-- Left: info -->
    <div>
      <span class="contact-page-eyebrow">{{ section.settings.eyebrow | default: 'Get in touch' }}</span>
      <h1 class="contact-page-heading">{{ section.settings.heading | default: "Let's Talk Snacks" }}</h1>
      <p class="contact-page-desc">{{ section.settings.description | default: "Questions, wholesale enquiries, or just want to tell us your favourite? Drop us a line and we'll get back within one business day." }}</p>

      <div class="contact-info-list">
        <div class="contact-info-row">
          <div class="contact-info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <p class="contact-info-label">Email</p>
            <a href="mailto:{{ section.settings.email | default: 'help@rocketboyz.com' }}" class="contact-info-value">{{ section.settings.email | default: 'help@rocketboyz.com' }}</a>
          </div>
        </div>

        <div class="contact-info-row">
          <div class="contact-info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.65 3.42 2 2 0 0 1 3.62 1.24h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.83a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/></svg>
          </div>
          <div>
            <p class="contact-info-label">Phone</p>
            <a href="tel:{{ section.settings.phone_link | default: '18007622596' }}" class="contact-info-value">{{ section.settings.phone_display | default: '1-800-SNACK-96' }}</a>
          </div>
        </div>

        <div class="contact-info-row">
          <div class="contact-info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="contact-info-label">Warehouse</p>
            <p class="contact-info-value">{{ section.settings.address | default: '1160 NE 24th Ct, Wilton Manors, FL 33305' }}</p>
          </div>
        </div>

        <div class="contact-info-row">
          <div class="contact-info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <p class="contact-info-label">Hours</p>
            <p class="contact-info-value">{{ section.settings.hours | default: 'Mon–Fri · 9am–6pm ET' }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: form -->
    <div class="contact-form-card">
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-form-success">Message sent! We'll get back to you within one business day.</p>
        {%- endif -%}

        <div class="contact-form-row">
          <div class="contact-form-field">
            <label class="contact-form-label" for="ContactName">Name</label>
            <input class="contact-form-input" type="text" id="ContactName" name="contact[name]" placeholder="Your name" autocomplete="name" required>
          </div>
          <div class="contact-form-field">
            <label class="contact-form-label" for="ContactEmail">Email</label>
            <input class="contact-form-input" type="email" id="ContactEmail" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
          </div>
        </div>

        <div class="contact-form-field">
          <label class="contact-form-label" for="ContactTopic">Topic</label>
          <div class="contact-form-select-wrap">
            <select class="contact-form-select" id="ContactTopic" name="contact[topic]">
              <option value="">Choose a topic...</option>
              <option>Order issue</option>
              <option>Returns & refunds</option>
              <option>Wholesale inquiry</option>
              <option>Snack Box subscription</option>
              <option>Product question</option>
              <option>Other</option>
            </select>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>

        <div class="contact-form-field">
          <label class="contact-form-label" for="ContactMessage">Message</label>
          <textarea class="contact-form-textarea" id="ContactMessage" name="contact[body]" placeholder="How can we help?"></textarea>
        </div>

        <button type="submit" class="contact-form-submit">
          Send message
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    { "type": "text",     "id": "eyebrow",      "label": "Eyebrow",      "default": "Get in touch" },
    { "type": "text",     "id": "heading",       "label": "Heading",      "default": "Let's Talk Snacks" },
    { "type": "textarea", "id": "description",   "label": "Description",  "default": "Questions, wholesale enquiries, or just want to tell us your favourite? Drop us a line and we'll get back within one business day." },
    { "type": "text",     "id": "email",         "label": "Email",        "default": "help@rocketboyz.com" },
    { "type": "text",     "id": "phone_display", "label": "Phone (display)", "default": "1-800-SNACK-96" },
    { "type": "text",     "id": "phone_link",    "label": "Phone (digits only for tel: link)", "default": "18007622596" },
    { "type": "text",     "id": "address",       "label": "Warehouse address", "default": "1160 NE 24th Ct, Wilton Manors, FL 33305" },
    { "type": "text",     "id": "hours",         "label": "Hours",        "default": "Mon–Fri · 9am–6pm ET" }
  ],
  "presets": [{ "name": "Contact Page" }]
}
{% endschema %}
