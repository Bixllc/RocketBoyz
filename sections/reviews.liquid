<style>
  .rb-reviews-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 32px 72px;
  }

  .rb-reviews-header {
    text-align: center;
    margin-bottom: 34px;
  }

  .rb-reviews-label {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6e6a60;
    display: block;
    margin-bottom: 12px;
  }

  .rb-reviews-heading {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: clamp(34px, 4vw, 56px);
    text-transform: uppercase;
    color: #1b1a16;
    margin: 0;
    line-height: 1;
  }

  .rb-reviews-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .rb-review-card {
    background: #fbfaf7;
    border: 1px solid rgba(27, 26, 22, 0.08);
    border-radius: 20px;
    padding: 28px 24px 22px;
    display: flex;
    flex-direction: column;
  }

  .rb-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 16px;
  }

  .rb-stars svg {
    width: 16px;
    height: 16px;
  }

  .rb-review-quote {
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: #33302b;
    flex: 1;
    margin: 0 0 0;
  }

  .rb-review-bottom {
    border-top: 1px solid rgba(27, 26, 22, 0.1);
    padding-top: 18px;
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .rb-review-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .rb-review-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .rb-review-name {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #1b1a16;
    margin: 0;
    line-height: 1.3;
  }

  .rb-review-role {
    font-family: 'Manrope', sans-serif;
    font-size: 12px;
    color: #8a857a;
    margin: 0;
    line-height: 1.3;
  }

  @media (max-width: 1024px) {
    .rb-reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .rb-reviews-grid {
      grid-template-columns: 1fr;
    }
    .rb-reviews-section {
      padding: 40px 20px 56px;
    }
  }
</style>

<div class="rb-reviews-section">
  <div class="rb-reviews-header">
    <span class="rb-reviews-label">From the shops &amp; the snackers</span>
    <h2 class="rb-reviews-heading">Real reviews, real flavour</h2>
  </div>

  <div class="rb-reviews-grid">
    {% for block in section.blocks %}
      {% if block.type == 'review' %}
        <div class="rb-review-card" {{ block.shopify_attributes }}>
          <div class="rb-stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {% assign stars_count = block.settings.stars | default: 5 %}
            {% for i in (1..5) %}
              {% if i <= stars_count %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#D1CBBF" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endif %}
            {% endfor %}
          </div>

          <p class="rb-review-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>

          <div class="rb-review-bottom">
            <div class="rb-review-avatar" style="background-color:{{ block.settings.avatar_color }};" aria-hidden="true">
              {{ block.settings.author | slice: 0 | upcase }}
            </div>
            <div class="rb-review-meta">
              <p class="rb-review-name">{{ block.settings.author }}</p>
              <p class="rb-review-role">{{ block.settings.role }}</p>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / label",
          "default": "Verified buyer"
        },
        {
          "type": "color",
          "id": "avatar_color",
          "label": "Avatar background color",
          "default": "#E63946"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "These snacks are the real deal — my whole family was fighting over the Cheeselets. Fast shipping too!",
            "author": "Marcus B.",
            "role": "Verified buyer",
            "avatar_color": "#E63946",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Finally found a supplier that actually stocks the good stuff. My corner store customers love it.",
            "author": "Delroy P.",
            "role": "Wholesale customer",
            "avatar_color": "#FF9F1C",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The snack box is unreal. It's like getting a care package from back home every month.",
            "author": "Kezia M.",
            "role": "Snack Box subscriber",
            "avatar_color": "#1b1a16",
            "stars": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Ordered for a Caribbean night event — arrived in two days, everything perfect. Will order again.",
            "author": "Tamara W.",
            "role": "Event buyer",
            "avatar_color": "#2563EB",
            "stars": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
