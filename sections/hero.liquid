<style>
  .rb-hero {
    position: relative;
    width: 100%;
    min-height: 660px;
    overflow: hidden;
    background: #17150f;
  }

  .rb-hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .rb-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(9,8,6,0.88) 0%,
      rgba(9,8,6,0.6) 34%,
      rgba(9,8,6,0.12) 58%,
      transparent 100%
    );
    z-index: 1;
  }

  .rb-hero__container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 660px;
    padding: 0 32px;
    display: flex;
    align-items: center;
  }

  .rb-hero__content {
    max-width: 580px;
  }

  .rb-hero__heading {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    font-size: clamp(48px, 5.6vw, 90px);
    line-height: 0.9;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: #f6f2e8;
    margin: 0;
  }

  .rb-hero__subtext {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(243, 240, 233, 0.82);
    max-width: 430px;
    margin-top: 26px;
    margin-bottom: 0;
  }

  .rb-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px;
    margin-top: 34px;
  }

  .rb-hero__btn {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 600;
    font-size: 15px;
    padding: 13px 26px;
    background: transparent;
    color: #f3f0e9;
    border: 1.5px solid rgba(243, 240, 233, 0.4);
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .rb-hero__btn:hover {
    background: rgba(243, 240, 233, 0.1);
    border-color: rgba(243, 240, 233, 0.7);
    color: #ffffff;
  }

  .rb-hero__btn svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .rb-hero {
      min-height: 520px;
    }

    .rb-hero__container {
      min-height: 520px;
      padding: 0 20px;
      align-items: flex-end;
      padding-bottom: 48px;
    }

    .rb-hero__content {
      max-width: 100%;
    }

    .rb-hero__subtext {
      max-width: 100%;
      font-size: 16px;
    }

    .rb-hero__buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<section class="rb-hero">

  {%- if section.settings.image != blank -%}
    <img
      class="rb-hero__bg-img"
      src="{{ section.settings.image | image_url: width: 1920 }}"
      alt="{{ section.settings.image.alt | escape }}"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="660"
    >
  {%- endif -%}

  <div class="rb-hero__overlay"></div>

  <div class="rb-hero__container">
    <div class="rb-hero__content">

      <h1 class="rb-hero__heading">
        {{ section.settings.heading_line1 }}<br>
        {{ section.settings.heading_line2 }}<br>
        {{ section.settings.heading_line3 }}
      </h1>

      {%- if section.settings.subtext != blank -%}
        <p class="rb-hero__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="rb-hero__buttons">
        {%- if section.settings.cta1_text != blank -%}
          <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="rb-hero__btn">
            {{ section.settings.cta1_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_url | default: '#snackbox' }}" class="rb-hero__btn">
            {{ section.settings.cta2_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero background image"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — line 1",
      "default": "Taste the vibes"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — line 2",
      "default": "of the"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading — line 3",
      "default": "Caribbean"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Island-direct snacks, warehoused stateside and shipped fast. From cheese curls to sorrel — Rocket Boyz keeps the culture in stock."
    },
    {
      "type": "text",
      "id": "cta1_text",
      "label": "Button 1 text",
      "default": "Shop snacks"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Button 2 text",
      "default": "Explore snack box"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
