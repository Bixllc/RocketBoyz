{% include 'booster-seo' %} 
      <meta name="copyright" content="Shop RocketBoyz">
           <meta name="allow-search" content="yes">
           <meta name="language" content="English"/>
      <meta name="geo.region" content="US-FL" />
<meta name="geo.placename" content="Pembroke Park" />
<meta name="geo.position" content="25.984259;-80.195987" />
<meta name="ICBM" content="25.984259, -80.195987" />
      <meta name="google-site-verification" content="0RBXVacEQic7pmGbRtUUYRBuaqpX8Kayl-ahIe-d_t0" />
      <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"/>
<meta name="Author" content="RocketBoyz">
<meta name="Publisher" content="RocketBoyz">
      <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-G0RCRDS9QN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-G0RCRDS9QN');
