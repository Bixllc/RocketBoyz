{%- comment -%}
  Shared product card used by New Arrivals and Trending Now.
  Accepts: product (object), badge_text (string, optional), block_attributes (string, optional — block.shopify_attributes)
{%- endcomment -%}

{%- if product != blank -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <div class="rb-product-card product-item"{% if block_attributes %} {{ block_attributes }}{% endif %}>

    {%- if badge_text != blank -%}
      <span class="rb-product-card__badge">{{ badge_text }}</span>
    {%- endif -%}

    <!-- Wishlist button -->
    <button class="rb-btn-wish" aria-label="Add to wishlist" type="button">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1b1a16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>

    <!-- Product image -->
    <a href="{{ product.url }}" style="display:block; text-decoration:none;">
      <div style="height:190px; border-radius:14px; background:#efece6; display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom:14px;">
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.featured_image.alt | escape }}"
            style="max-height:86%; max-width:86%; object-fit:contain; filter:drop-shadow(0 14px 16px rgba(0,0,0,0.2));"
            loading="lazy"
            width="400"
          >
        {%- endif -%}
      </div>
    </a>

    <!-- Product title -->
    <a href="{{ product.url }}" style="text-decoration:none; color:#1b1a16;">
      <p style="font-family:'Hanken Grotesk',system-ui,sans-serif; font-size:16.5px; font-weight:700; margin:0; line-height:1.25;">
        {{ product.title }}
      </p>
    </a>

    <!-- Price row -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:14px;">
      <span style="font-family:'Anton',sans-serif; font-size:22px; font-weight:400; color:#1b1a16;">
        {{ product.price | money }}
      </span>

      {%- form 'product', product, class: 'rb-product-card__add-form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button
          type="submit"
          class="rb-btn-sm-outline{% unless variant.available %} is-soldout{% endunless %}"
          data-btn-addtocart
          {% unless variant.available %}disabled{% endunless %}
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          {% if variant.available %}Add to cart{% else %}Sold out{% endif %}
        </button>
      {%- endform -%}
    </div>

  </div>
{%- endif -%}
